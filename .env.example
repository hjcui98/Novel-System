# Non-secret local overrides. Never add credentials to this tracked template.
NOVEL_AGENT_ENVIRONMENT=development
NOVEL_AGENT_LOG_LEVEL=INFO

# Native bootstrap generates strong credentials in the untracked .env file.
POSTGRES_DB=novel_agent
POSTGRES_USER=novel_agent
POSTGRES_PASSWORD=GENERATE_AT_BOOTSTRAP
POSTGRES_PORT=5432

MINIO_ROOT_USER=GENERATE_AT_BOOTSTRAP
MINIO_ROOT_PASSWORD=GENERATE_AT_BOOTSTRAP
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

OPENSEARCH_PORT=9200
OPENSEARCH_TRANSPORT_PORT=9300
OPENSEARCH_PERFORMANCE_PORT=9600
OPENSEARCH_JAVA_OPTS=-Xms512m -Xmx512m

OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318
OTEL_HEALTH_PORT=13133

# Locked BGE retrieval services; both bind only to 127.0.0.1.
NOVEL_AGENT_EMBEDDING_MODEL_PORT=8081
NOVEL_AGENT_RERANKER_MODEL_PORT=8082
NOVEL_AGENT_MODEL_THREADS=32
