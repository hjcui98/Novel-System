{
  "$defs": {
    "ArtifactId": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "ArtifactId",
      "type": "string"
    },
    "SchemaVersion": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "title": "SchemaVersion",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "artifact_id": {
      "$ref": "#/$defs/ArtifactId"
    },
    "byte_length": {
      "minimum": 0,
      "title": "Byte Length",
      "type": "integer"
    },
    "media_type": {
      "maxLength": 255,
      "minLength": 1,
      "title": "Media Type",
      "type": "string"
    },
    "root_kind": {
      "const": "reference",
      "default": "reference",
      "title": "Root Kind",
      "type": "string"
    },
    "schema_version": {
      "$ref": "#/$defs/SchemaVersion"
    }
  },
  "required": [
    "artifact_id",
    "media_type",
    "byte_length",
    "schema_version"
  ],
  "title": "ReferenceRootRef",
  "type": "object"
}
