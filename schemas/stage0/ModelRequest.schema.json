{
  "$defs": {
    "ArtifactId": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "ArtifactId",
      "type": "string"
    },
    "BudgetSource": {
      "enum": [
        "explicit_request",
        "invocation_budget",
        "endpoint_default",
        "model_max_auto"
      ],
      "title": "BudgetSource",
      "type": "string"
    },
    "JsonValue": {},
    "ModelCallPurpose": {
      "enum": [
        "development",
        "batch_test",
        "evaluation"
      ],
      "title": "ModelCallPurpose",
      "type": "string"
    },
    "ModelRole": {
      "enum": [
        "implementation_model",
        "batch_test_model"
      ],
      "title": "ModelRole",
      "type": "string"
    },
    "RunId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "RunId",
      "type": "string"
    },
    "StableId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "StableId",
      "type": "string"
    },
    "TaskId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "TaskId",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "agent_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/StableId"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "agent_mode": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Agent Mode"
    },
    "agent_spec_hash": {
      "anyOf": [
        {
          "$ref": "#/$defs/ArtifactId"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "attempt_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/StableId"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "budget_source": {
      "anyOf": [
        {
          "$ref": "#/$defs/BudgetSource"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "enable_thinking": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Enable Thinking"
    },
    "max_output_tokens": {
      "anyOf": [
        {
          "maximum": 131072,
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Max Output Tokens"
    },
    "model_role": {
      "$ref": "#/$defs/ModelRole"
    },
    "prompt": {
      "title": "Prompt",
      "type": "string"
    },
    "prompt_contract_hashes": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ArtifactId"
      },
      "title": "Prompt Contract Hashes",
      "type": "array"
    },
    "purpose": {
      "$ref": "#/$defs/ModelCallPurpose"
    },
    "render_fingerprint": {
      "anyOf": [
        {
          "$ref": "#/$defs/ArtifactId"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "repetition_penalty": {
      "anyOf": [
        {
          "exclusiveMinimum": 0.0,
          "maximum": 2.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Repetition Penalty"
    },
    "request_id": {
      "$ref": "#/$defs/StableId"
    },
    "response_schema": {
      "anyOf": [
        {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Response Schema"
    },
    "run_id": {
      "$ref": "#/$defs/RunId"
    },
    "scheduling_dependency_ids": {
      "default": [],
      "items": {
        "$ref": "#/$defs/StableId"
      },
      "title": "Scheduling Dependency Ids",
      "type": "array"
    },
    "scheduling_need_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/StableId"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "scheduling_priority": {
      "default": 50,
      "maximum": 100,
      "minimum": 0,
      "title": "Scheduling Priority",
      "type": "integer"
    },
    "scheduling_stage": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Scheduling Stage"
    },
    "scheduling_timeout_seconds": {
      "anyOf": [
        {
          "exclusiveMinimum": 0.0,
          "maximum": 3600.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Scheduling Timeout Seconds"
    },
    "skill_contract_hashes": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ArtifactId"
      },
      "title": "Skill Contract Hashes",
      "type": "array"
    },
    "span_id": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Span Id"
    },
    "task_id": {
      "$ref": "#/$defs/TaskId"
    },
    "temperature": {
      "anyOf": [
        {
          "maximum": 2.0,
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Temperature"
    },
    "thinking_token_budget": {
      "anyOf": [
        {
          "maximum": 131072,
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Thinking Token Budget"
    },
    "timeout_seconds": {
      "default": 30.0,
      "exclusiveMinimum": 0.0,
      "maximum": 900.0,
      "title": "Timeout Seconds",
      "type": "number"
    },
    "tool_policy_hash": {
      "anyOf": [
        {
          "$ref": "#/$defs/ArtifactId"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "trace_id": {
      "minLength": 1,
      "title": "Trace Id",
      "type": "string"
    }
  },
  "required": [
    "request_id",
    "run_id",
    "task_id",
    "model_role",
    "purpose",
    "trace_id",
    "prompt"
  ],
  "title": "ModelRequest",
  "type": "object"
}
