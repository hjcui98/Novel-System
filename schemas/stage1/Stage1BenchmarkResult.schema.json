{
  "$defs": {
    "BenchmarkMetricSet": {
      "additionalProperties": false,
      "properties": {
        "anchor_precision_at_k": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Anchor Precision At K"
        },
        "anchor_recall_at_k": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Anchor Recall At K"
        },
        "anchor_to_gold_conversion_rate": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Anchor To Gold Conversion Rate"
        },
        "average_anchors_expanded": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Average Anchors Expanded"
        },
        "average_scenes_expanded": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Average Scenes Expanded"
        },
        "average_spans_expanded": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Average Spans Expanded"
        },
        "conflict_exposure_rate": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Conflict Exposure Rate"
        },
        "context_utility_per_1k_tokens": {
          "minimum": 0,
          "title": "Context Utility Per 1K Tokens",
          "type": "number"
        },
        "current_state_accuracy": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Current State Accuracy"
        },
        "evidence_recall_after_expansion": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence Recall After Expansion"
        },
        "evidence_traceability": {
          "maximum": 1,
          "minimum": 0,
          "title": "Evidence Traceability",
          "type": "number"
        },
        "full_chapter_read_rate": {
          "maximum": 1,
          "minimum": 0,
          "title": "Full Chapter Read Rate",
          "type": "number"
        },
        "future_leakage_rate": {
          "maximum": 1,
          "minimum": 0,
          "title": "Future Leakage Rate",
          "type": "number"
        },
        "gold_evidence_recall": {
          "maximum": 1,
          "minimum": 0,
          "title": "Gold Evidence Recall",
          "type": "number"
        },
        "gold_evidence_recall_at_k": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Gold Evidence Recall At K"
        },
        "grounded_fallback_rate": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Grounded Fallback Rate"
        },
        "horizon_decay": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Horizon Decay"
        },
        "inter_chapter_context_repetition": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Inter Chapter Context Repetition"
        },
        "irrelevant_token_ratio": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Irrelevant Token Ratio"
        },
        "l0_evidence_tokens_read": {
          "minimum": 0,
          "title": "L0 Evidence Tokens Read",
          "type": "integer"
        },
        "mandatory_constraint_coverage": {
          "maximum": 1,
          "minimum": 0,
          "title": "Mandatory Constraint Coverage",
          "type": "number"
        },
        "mean_reciprocal_rank": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mean Reciprocal Rank"
        },
        "n_plus_1_coverage": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "N Plus 1 Coverage"
        },
        "n_plus_2_coverage": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "N Plus 2 Coverage"
        },
        "n_plus_3_coverage": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "N Plus 3 Coverage"
        },
        "ndcg": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ndcg"
        },
        "need_f1": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Need F1"
        },
        "need_precision": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Need Precision"
        },
        "need_recall": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Need Recall"
        },
        "observed_use_coverage": {
          "maximum": 1,
          "minimum": 0,
          "title": "Observed Use Coverage",
          "type": "number"
        },
        "operational_constraint_coverage": {
          "maximum": 1,
          "minimum": 0,
          "title": "Operational Constraint Coverage",
          "type": "number"
        },
        "plan_obligation_coverage": {
          "maximum": 1,
          "minimum": 0,
          "title": "Plan Obligation Coverage",
          "type": "number"
        },
        "premature_future_injection_rate": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Premature Future Injection Rate"
        },
        "query_intent_routing_accuracy": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Query Intent Routing Accuracy"
        },
        "reranker_pair_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reranker Pair Tokens"
        },
        "shared_horizon_constraint_coverage": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Shared Horizon Constraint Coverage"
        },
        "stale_state_rate": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stale State Rate"
        },
        "temporal_validity_accuracy": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Temporal Validity Accuracy"
        },
        "unnecessary_channel_rate": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unnecessary Channel Rate"
        },
        "unresolved_gap_calibration": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unresolved Gap Calibration"
        },
        "wrong_entity_binding_rate": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Wrong Entity Binding Rate"
        },
        "wrong_route_rate": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Wrong Route Rate"
        }
      },
      "required": [
        "gold_evidence_recall",
        "observed_use_coverage",
        "operational_constraint_coverage",
        "plan_obligation_coverage",
        "mandatory_constraint_coverage",
        "evidence_traceability",
        "future_leakage_rate",
        "l0_evidence_tokens_read",
        "full_chapter_read_rate",
        "context_utility_per_1k_tokens"
      ],
      "title": "BenchmarkMetricSet",
      "type": "object"
    },
    "BenchmarkProfileResult": {
      "additionalProperties": false,
      "properties": {
        "failure_categories": {
          "default": [],
          "items": {
            "$ref": "#/$defs/FailureCategory"
          },
          "title": "Failure Categories",
          "type": "array"
        },
        "metrics": {
          "$ref": "#/$defs/BenchmarkMetricSet"
        },
        "profile": {
          "minLength": 1,
          "title": "Profile",
          "type": "string"
        },
        "retrieved_evidence_ids": {
          "default": [],
          "items": {
            "$ref": "#/$defs/StableId"
          },
          "title": "Retrieved Evidence Ids",
          "type": "array"
        }
      },
      "required": [
        "profile",
        "metrics"
      ],
      "title": "BenchmarkProfileResult",
      "type": "object"
    },
    "BenchmarkQueryCondition": {
      "enum": [
        "oracle_need",
        "generated_need"
      ],
      "title": "BenchmarkQueryCondition",
      "type": "string"
    },
    "BenchmarkTrack": {
      "enum": [
        "oracle_verified",
        "end_to_end"
      ],
      "title": "BenchmarkTrack",
      "type": "string"
    },
    "CommitId": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "CommitId",
      "type": "string"
    },
    "FailureCategory": {
      "enum": [
        "F-STATE",
        "F-NEED",
        "F-ROUTE",
        "F-RETRIEVE",
        "F-RANK",
        "F-EXPAND",
        "F-CONTEXT",
        "F-EXTRACT",
        "F-TRUTH",
        "F-VALIDATE",
        "F-COMMIT",
        "F-FRESH",
        "F-EVAL"
      ],
      "title": "FailureCategory",
      "type": "string"
    },
    "ModelCallPurpose": {
      "enum": [
        "development",
        "batch_test",
        "evaluation"
      ],
      "title": "ModelCallPurpose",
      "type": "string"
    },
    "ModelRole": {
      "enum": [
        "implementation_model",
        "batch_test_model"
      ],
      "title": "ModelRole",
      "type": "string"
    },
    "RetrievalInferenceCallRecord": {
      "additionalProperties": false,
      "properties": {
        "call_id": {
          "$ref": "#/$defs/StableId"
        },
        "completed_at": {
          "format": "date-time",
          "title": "Completed At",
          "type": "string"
        },
        "endpoint": {
          "minLength": 1,
          "title": "Endpoint",
          "type": "string"
        },
        "error_type": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error Type"
        },
        "latency_ms": {
          "minimum": 0,
          "title": "Latency Ms",
          "type": "integer"
        },
        "model": {
          "minLength": 1,
          "title": "Model",
          "type": "string"
        },
        "model_role": {
          "$ref": "#/$defs/ModelRole"
        },
        "operation": {
          "$ref": "#/$defs/RetrievalInferenceOperation"
        },
        "purpose": {
          "$ref": "#/$defs/ModelCallPurpose"
        },
        "revision": {
          "minLength": 1,
          "title": "Revision",
          "type": "string"
        },
        "run_id": {
          "$ref": "#/$defs/RunId"
        },
        "runtime_fingerprint": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Runtime Fingerprint",
          "type": "string"
        },
        "span_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Span Id"
        },
        "started_at": {
          "format": "date-time",
          "title": "Started At",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/RetrievalInferenceStatus"
        },
        "task_id": {
          "$ref": "#/$defs/TaskId"
        },
        "trace_id": {
          "minLength": 1,
          "title": "Trace Id",
          "type": "string"
        },
        "usage": {
          "$ref": "#/$defs/RetrievalInferenceUsage"
        }
      },
      "required": [
        "call_id",
        "run_id",
        "task_id",
        "model_role",
        "purpose",
        "trace_id",
        "endpoint",
        "model",
        "revision",
        "runtime_fingerprint",
        "operation",
        "usage",
        "latency_ms",
        "started_at",
        "completed_at",
        "status"
      ],
      "title": "RetrievalInferenceCallRecord",
      "type": "object"
    },
    "RetrievalInferenceOperation": {
      "enum": [
        "embedding",
        "rerank"
      ],
      "title": "RetrievalInferenceOperation",
      "type": "string"
    },
    "RetrievalInferenceStatus": {
      "enum": [
        "succeeded",
        "failed"
      ],
      "title": "RetrievalInferenceStatus",
      "type": "string"
    },
    "RetrievalInferenceUsage": {
      "additionalProperties": false,
      "properties": {
        "cost_usd": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Cost Usd"
        },
        "input_characters": {
          "minimum": 0,
          "title": "Input Characters",
          "type": "integer"
        },
        "input_items": {
          "minimum": 0,
          "title": "Input Items",
          "type": "integer"
        },
        "output_items": {
          "minimum": 0,
          "title": "Output Items",
          "type": "integer"
        }
      },
      "required": [
        "input_items",
        "input_characters",
        "output_items",
        "cost_usd"
      ],
      "title": "RetrievalInferenceUsage",
      "type": "object"
    },
    "RunId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "RunId",
      "type": "string"
    },
    "SchemaVersion": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "title": "SchemaVersion",
      "type": "string"
    },
    "StableId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "StableId",
      "type": "string"
    },
    "Stage1BenchmarkConfig": {
      "additionalProperties": false,
      "properties": {
        "config_version": {
          "$ref": "#/$defs/SchemaVersion"
        },
        "embedding_profile": {
          "minLength": 1,
          "title": "Embedding Profile",
          "type": "string"
        },
        "expansion_profile": {
          "minLength": 1,
          "title": "Expansion Profile",
          "type": "string"
        },
        "fused_candidate_limit": {
          "minimum": 1,
          "title": "Fused Candidate Limit",
          "type": "integer"
        },
        "need_profile": {
          "minLength": 1,
          "title": "Need Profile",
          "type": "string"
        },
        "per_channel_candidate_limit": {
          "minimum": 1,
          "title": "Per Channel Candidate Limit",
          "type": "integer"
        },
        "query_condition": {
          "$ref": "#/$defs/BenchmarkQueryCondition"
        },
        "random_seed": {
          "title": "Random Seed",
          "type": "integer"
        },
        "reranker_profile": {
          "minLength": 1,
          "title": "Reranker Profile",
          "type": "string"
        },
        "rrf_k": {
          "minimum": 1,
          "title": "Rrf K",
          "type": "integer"
        },
        "summary_profile": {
          "minLength": 1,
          "title": "Summary Profile",
          "type": "string"
        },
        "token_budget": {
          "minimum": 1,
          "title": "Token Budget",
          "type": "integer"
        }
      },
      "required": [
        "config_version",
        "token_budget",
        "per_channel_candidate_limit",
        "fused_candidate_limit",
        "rrf_k",
        "embedding_profile",
        "reranker_profile",
        "expansion_profile",
        "summary_profile",
        "query_condition",
        "need_profile",
        "random_seed"
      ],
      "title": "Stage1BenchmarkConfig",
      "type": "object"
    },
    "TaskId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "TaskId",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "base_commit": {
      "$ref": "#/$defs/CommitId"
    },
    "bundle_id": {
      "$ref": "#/$defs/StableId"
    },
    "case_id": {
      "$ref": "#/$defs/StableId"
    },
    "config": {
      "$ref": "#/$defs/Stage1BenchmarkConfig"
    },
    "context_frozen": {
      "title": "Context Frozen",
      "type": "boolean"
    },
    "profile_results": {
      "items": {
        "$ref": "#/$defs/BenchmarkProfileResult"
      },
      "title": "Profile Results",
      "type": "array"
    },
    "retrieval_model_calls": {
      "default": [],
      "items": {
        "$ref": "#/$defs/RetrievalInferenceCallRecord"
      },
      "title": "Retrieval Model Calls",
      "type": "array"
    },
    "run_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/RunId"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "snapshot_id": {
      "$ref": "#/$defs/StableId"
    },
    "track": {
      "$ref": "#/$defs/BenchmarkTrack"
    }
  },
  "required": [
    "bundle_id",
    "case_id",
    "track",
    "base_commit",
    "snapshot_id",
    "config",
    "context_frozen",
    "profile_results"
  ],
  "title": "Stage1BenchmarkResult",
  "type": "object"
}
