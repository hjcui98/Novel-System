{
  "$defs": {
    "ChangeOperationType": {
      "enum": [
        "create",
        "replace",
        "retire"
      ],
      "title": "ChangeOperationType",
      "type": "string"
    },
    "CuratedOperationDraftV2": {
      "additionalProperties": false,
      "description": "Curator operation draft that references opaque evidence candidate IDs.",
      "properties": {
        "evidence_candidate_ids": {
          "items": {
            "$ref": "#/$defs/StableId"
          },
          "maxItems": 4,
          "minItems": 1,
          "title": "Evidence Candidate Ids",
          "type": "array"
        },
        "operation": {
          "$ref": "#/$defs/ChangeOperationType"
        },
        "record": {
          "anyOf": [
            {
              "$ref": "#/$defs/CuratorEntityRecord"
            },
            {
              "$ref": "#/$defs/CuratorEventRecord"
            },
            {
              "$ref": "#/$defs/CuratorStateRecord"
            },
            {
              "$ref": "#/$defs/CuratorRelationRecord"
            },
            {
              "$ref": "#/$defs/CuratorObligationRecord"
            }
          ],
          "title": "Record"
        },
        "record_kind": {
          "$ref": "#/$defs/WorldRecordKind"
        },
        "target_id": {
          "$ref": "#/$defs/StableId"
        }
      },
      "required": [
        "operation",
        "record_kind",
        "target_id",
        "record",
        "evidence_candidate_ids"
      ],
      "title": "CuratedOperationDraftV2",
      "type": "object"
    },
    "CuratorEntityRecord": {
      "additionalProperties": false,
      "properties": {
        "aliases": {
          "default": [],
          "items": {
            "maxLength": 160,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 4,
          "title": "Aliases",
          "type": "array"
        },
        "entity_type": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Entity Type",
          "type": "string"
        },
        "identity_invariants": {
          "default": [],
          "items": {
            "maxLength": 160,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 4,
          "title": "Identity Invariants",
          "type": "array"
        },
        "internal_label": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Internal Label",
          "type": "string"
        }
      },
      "required": [
        "entity_type",
        "internal_label"
      ],
      "title": "CuratorEntityRecord",
      "type": "object"
    },
    "CuratorEventRecord": {
      "additionalProperties": false,
      "properties": {
        "effect_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/StableId"
          },
          "maxItems": 4,
          "title": "Effect Refs",
          "type": "array"
        },
        "event_type": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Event Type",
          "type": "string"
        },
        "narrative_order": {
          "anyOf": [
            {
              "$ref": "#/$defs/NarrativeOrder"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "participant_ids": {
          "default": [],
          "items": {
            "$ref": "#/$defs/StableId"
          },
          "maxItems": 6,
          "title": "Participant Ids",
          "type": "array"
        },
        "story_time": {
          "anyOf": [
            {
              "$ref": "#/$defs/CuratorStoryTime"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "truth_class": {
          "$ref": "#/$defs/TruthClass"
        }
      },
      "required": [
        "event_type",
        "truth_class"
      ],
      "title": "CuratorEventRecord",
      "type": "object"
    },
    "CuratorObligationRecord": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "due_chapter": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Due Chapter"
        },
        "kind": {
          "enum": [
            "foreshadowing",
            "promise",
            "objective",
            "unresolved_conflict"
          ],
          "title": "Kind",
          "type": "string"
        },
        "not_before_chapter": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Not Before Chapter"
        },
        "owner_ids": {
          "default": [],
          "items": {
            "$ref": "#/$defs/StableId"
          },
          "maxItems": 6,
          "title": "Owner Ids",
          "type": "array"
        },
        "status": {
          "enum": [
            "open",
            "progressed",
            "resolved",
            "abandoned"
          ],
          "title": "Status",
          "type": "string"
        },
        "target_chapter_end": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Chapter End"
        },
        "target_chapter_start": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Chapter Start"
        }
      },
      "required": [
        "kind",
        "description",
        "status"
      ],
      "title": "CuratorObligationRecord",
      "type": "object"
    },
    "CuratorRelationRecord": {
      "additionalProperties": false,
      "properties": {
        "object_id": {
          "$ref": "#/$defs/StableId"
        },
        "predicate": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Predicate",
          "type": "string"
        },
        "subject_id": {
          "$ref": "#/$defs/StableId"
        },
        "truth_class": {
          "$ref": "#/$defs/TruthClass"
        },
        "valid_time": {
          "$ref": "#/$defs/CuratorStoryTime"
        }
      },
      "required": [
        "predicate",
        "subject_id",
        "object_id",
        "valid_time",
        "truth_class"
      ],
      "title": "CuratorRelationRecord",
      "type": "object"
    },
    "CuratorStateRecord": {
      "additionalProperties": false,
      "properties": {
        "predicate": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Predicate",
          "type": "string"
        },
        "subject_id": {
          "$ref": "#/$defs/StableId"
        },
        "truth_class": {
          "$ref": "#/$defs/TruthClass"
        },
        "valid_time": {
          "$ref": "#/$defs/CuratorStoryTime"
        },
        "value": {
          "anyOf": [
            {
              "maxLength": 160,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "subject_id",
        "predicate",
        "value",
        "valid_time",
        "truth_class"
      ],
      "title": "CuratorStateRecord",
      "type": "object"
    },
    "CuratorStoryTime": {
      "additionalProperties": false,
      "properties": {
        "end_ordinal": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Ordinal"
        },
        "label": {
          "anyOf": [
            {
              "maxLength": 160,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"
        },
        "start_ordinal": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start Ordinal"
        },
        "worldline": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Worldline",
          "type": "string"
        }
      },
      "required": [
        "worldline"
      ],
      "title": "CuratorStoryTime",
      "type": "object"
    },
    "NarrativeOrder": {
      "additionalProperties": false,
      "properties": {
        "block_index": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Block Index"
        },
        "chapter_index": {
          "minimum": 0,
          "title": "Chapter Index",
          "type": "integer"
        },
        "scene_index": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scene Index"
        }
      },
      "required": [
        "chapter_index"
      ],
      "title": "NarrativeOrder",
      "type": "object"
    },
    "StableId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "StableId",
      "type": "string"
    },
    "TruthClass": {
      "enum": [
        "accepted_world_fact",
        "assertion",
        "rumor",
        "dream",
        "prediction",
        "hypothetical",
        "unknown",
        "contested",
        "disproved",
        "retconned",
        "not_applicable"
      ],
      "title": "TruthClass",
      "type": "string"
    },
    "WorldRecordKind": {
      "enum": [
        "entity",
        "event",
        "state",
        "relation",
        "obligation"
      ],
      "title": "WorldRecordKind",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "V2 Curator draft: no model-emitted character offsets.",
  "properties": {
    "chapter_index": {
      "minimum": 1,
      "title": "Chapter Index",
      "type": "integer"
    },
    "coverage": {
      "default": 1.0,
      "maximum": 1,
      "minimum": 0,
      "title": "Coverage",
      "type": "number"
    },
    "declared_vs_observed_diff": {
      "default": [],
      "items": {
        "maxLength": 160,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 4,
      "title": "Declared Vs Observed Diff",
      "type": "array"
    },
    "no_durable_delta_reason": {
      "anyOf": [
        {
          "maxLength": 160,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "No Durable Delta Reason"
    },
    "no_op_evidence_candidate_ids": {
      "default": [],
      "items": {
        "$ref": "#/$defs/StableId"
      },
      "maxItems": 4,
      "title": "No Op Evidence Candidate Ids",
      "type": "array"
    },
    "operations": {
      "items": {
        "$ref": "#/$defs/CuratedOperationDraftV2"
      },
      "maxItems": 4,
      "title": "Operations",
      "type": "array"
    },
    "unresolved": {
      "default": [],
      "items": {
        "maxLength": 160,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 4,
      "title": "Unresolved",
      "type": "array"
    }
  },
  "required": [
    "chapter_index",
    "operations"
  ],
  "title": "ChapterChangeDraftV2",
  "type": "object"
}
