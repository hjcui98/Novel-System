{
  "$defs": {
    "ArtifactId": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "ArtifactId",
      "type": "string"
    },
    "CandidatePool": {
      "enum": [
        "r0",
        "r1",
        "anchor",
        "grounded",
        "hierarchy",
        "graph"
      ],
      "title": "CandidatePool",
      "type": "string"
    },
    "CommitId": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "CommitId",
      "type": "string"
    },
    "ExpectedClaimScope": {
      "enum": [
        "current",
        "historical",
        "knowledge",
        "planned"
      ],
      "title": "ExpectedClaimScope",
      "type": "string"
    },
    "FacetEvidenceRequirement": {
      "enum": [
        "traceable_cutoff_source",
        "cutoff_current_source",
        "plan_provenance",
        "distinct_historical_source"
      ],
      "title": "FacetEvidenceRequirement",
      "type": "string"
    },
    "NeedCompletionSpec": {
      "additionalProperties": false,
      "properties": {
        "evidence_requirement_by_facet": {
          "additionalProperties": {
            "$ref": "#/$defs/FacetEvidenceRequirement"
          },
          "title": "Evidence Requirement By Facet",
          "type": "object"
        },
        "gap_policy": {
          "$ref": "#/$defs/NeedGapPolicy"
        },
        "irreducible_need_facet_ids": {
          "items": {
            "$ref": "#/$defs/StableId"
          },
          "title": "Irreducible Need Facet Ids",
          "type": "array"
        },
        "min_distinct_chapters": {
          "default": 1,
          "minimum": 1,
          "title": "Min Distinct Chapters",
          "type": "integer"
        },
        "min_distinct_evidence_sources": {
          "default": 1,
          "minimum": 1,
          "title": "Min Distinct Evidence Sources",
          "type": "integer"
        },
        "need_id": {
          "$ref": "#/$defs/StableId"
        },
        "predicates_by_facet": {
          "additionalProperties": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "title": "Predicates By Facet",
          "type": "object"
        },
        "producer": {
          "minLength": 1,
          "title": "Producer",
          "type": "string"
        },
        "producer_version": {
          "minLength": 1,
          "title": "Producer Version",
          "type": "string"
        },
        "relation_bindings_by_facet": {
          "additionalProperties": {
            "items": {
              "$ref": "#/$defs/RelationFacetBinding"
            },
            "type": "array"
          },
          "title": "Relation Bindings By Facet",
          "type": "object"
        },
        "require_causal_history": {
          "default": false,
          "title": "Require Causal History",
          "type": "boolean"
        },
        "require_current_claim": {
          "default": false,
          "title": "Require Current Claim",
          "type": "boolean"
        },
        "required_need_facet_ids": {
          "items": {
            "$ref": "#/$defs/StableId"
          },
          "title": "Required Need Facet Ids",
          "type": "array"
        },
        "uncertainty_policy": {
          "$ref": "#/$defs/NeedUncertaintyPolicy"
        }
      },
      "required": [
        "need_id",
        "required_need_facet_ids",
        "irreducible_need_facet_ids",
        "evidence_requirement_by_facet",
        "uncertainty_policy",
        "gap_policy",
        "producer",
        "producer_version"
      ],
      "title": "NeedCompletionSpec",
      "type": "object"
    },
    "NeedFacet": {
      "additionalProperties": false,
      "properties": {
        "derivation_refs": {
          "items": {
            "$ref": "#/$defs/StableId"
          },
          "title": "Derivation Refs",
          "type": "array"
        },
        "expected_claim_scope": {
          "$ref": "#/$defs/ExpectedClaimScope"
        },
        "facet_kind": {
          "$ref": "#/$defs/NeedFacetKind"
        },
        "information_scope": {
          "minLength": 1,
          "title": "Information Scope",
          "type": "string"
        },
        "need_facet_id": {
          "$ref": "#/$defs/StableId"
        },
        "need_id": {
          "$ref": "#/$defs/StableId"
        },
        "producer": {
          "minLength": 1,
          "title": "Producer",
          "type": "string"
        },
        "producer_version": {
          "minLength": 1,
          "title": "Producer Version",
          "type": "string"
        }
      },
      "required": [
        "need_facet_id",
        "need_id",
        "facet_kind",
        "expected_claim_scope",
        "derivation_refs",
        "producer",
        "producer_version",
        "information_scope"
      ],
      "title": "NeedFacet",
      "type": "object"
    },
    "NeedFacetKind": {
      "enum": [
        "current_state",
        "relation_state",
        "capability_status",
        "limitation",
        "knowledge_boundary",
        "causal_history",
        "setup",
        "unresolved_status",
        "commitment",
        "plan_node"
      ],
      "title": "NeedFacetKind",
      "type": "string"
    },
    "NeedGapPolicy": {
      "enum": [
        "emit_typed_gap",
        "fail_mandatory"
      ],
      "title": "NeedGapPolicy",
      "type": "string"
    },
    "NeedRisk": {
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "title": "NeedRisk",
      "type": "string"
    },
    "NeedUncertaintyPolicy": {
      "enum": [
        "allow_gap_only",
        "reject_unverified_claim"
      ],
      "title": "NeedUncertaintyPolicy",
      "type": "string"
    },
    "RelationFacetBinding": {
      "additionalProperties": false,
      "description": "One ordered relation triple that can close a relation facet.\n\n``RetrievalUnit.entity_ids`` preserves the canonical relation direction\n(subject first, object second).  Keeping that direction in the completion\ncontract prevents an anchor for the inverse edge, or an edge that merely\nshares one endpoint, from satisfying an explicit Planner relation.",
      "properties": {
        "object_id": {
          "$ref": "#/$defs/StableId"
        },
        "predicate": {
          "minLength": 1,
          "title": "Predicate",
          "type": "string"
        },
        "subject_id": {
          "$ref": "#/$defs/StableId"
        }
      },
      "required": [
        "subject_id",
        "predicate",
        "object_id"
      ],
      "title": "RelationFacetBinding",
      "type": "object"
    },
    "RequirementLevel": {
      "enum": [
        "mandatory",
        "optional"
      ],
      "title": "RequirementLevel",
      "type": "string"
    },
    "ResolutionPath": {
      "enum": [
        "exact_temporal",
        "anchor_first",
        "hierarchy",
        "grounded_direct",
        "typed_graph"
      ],
      "title": "ResolutionPath",
      "type": "string"
    },
    "RunId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "RunId",
      "type": "string"
    },
    "StableId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "StableId",
      "type": "string"
    },
    "Stage1QueryIntent": {
      "enum": [
        "current_state",
        "known_id",
        "plan_node",
        "mandatory_constraint",
        "semantic_history",
        "related_event",
        "plan_obligation",
        "global_arc",
        "chapter_thread",
        "character_arc",
        "exact_quote",
        "rare_phrase",
        "style_voice",
        "dialogue_sample",
        "causal_multi_hop",
        "relation_chain",
        "anchor_insufficient"
      ],
      "title": "Stage1QueryIntent",
      "type": "string"
    },
    "StoryTime": {
      "additionalProperties": false,
      "properties": {
        "end_ordinal": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Ordinal"
        },
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"
        },
        "start_ordinal": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start Ordinal"
        },
        "worldline": {
          "minLength": 1,
          "title": "Worldline",
          "type": "string"
        }
      },
      "required": [
        "worldline"
      ],
      "title": "StoryTime",
      "type": "object"
    },
    "TaskId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "TaskId",
      "type": "string"
    },
    "WriterContextSection": {
      "enum": [
        "continuity_constraints",
        "current_world_state",
        "relationship_and_emotion",
        "causal_history",
        "knowledge_and_disclosure",
        "plan_and_obligations",
        "long_range_callbacks"
      ],
      "title": "WriterContextSection",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "access_scope": {
      "default": "writer_safe",
      "minLength": 1,
      "title": "Access Scope",
      "type": "string"
    },
    "allow_plan": {
      "default": false,
      "title": "Allow Plan",
      "type": "boolean"
    },
    "allowed_candidate_pools": {
      "items": {
        "$ref": "#/$defs/CandidatePool"
      },
      "minItems": 1,
      "title": "Allowed Candidate Pools",
      "type": "array"
    },
    "base_commit": {
      "$ref": "#/$defs/CommitId"
    },
    "canonical_goal_by_chapter": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Canonical Goal By Chapter",
      "type": "object"
    },
    "chapter_target": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Chapter Target"
    },
    "claim_may_cite_plan": {
      "default": false,
      "title": "Claim May Cite Plan",
      "type": "boolean"
    },
    "completion_criteria": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Completion Criteria"
    },
    "completion_spec": {
      "anyOf": [
        {
          "$ref": "#/$defs/NeedCompletionSpec"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "entity_ids": {
      "default": [],
      "items": {
        "$ref": "#/$defs/StableId"
      },
      "title": "Entity Ids",
      "type": "array"
    },
    "expected_evidence_types": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Expected Evidence Types",
      "type": "array"
    },
    "expected_section": {
      "anyOf": [
        {
          "$ref": "#/$defs/WriterContextSection"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "focus_ids": {
      "default": [],
      "items": {
        "$ref": "#/$defs/StableId"
      },
      "title": "Focus Ids",
      "type": "array"
    },
    "hierarchy_parent_unit_ids": {
      "default": [],
      "items": {
        "$ref": "#/$defs/StableId"
      },
      "title": "Hierarchy Parent Unit Ids",
      "type": "array"
    },
    "horizon_target": {
      "anyOf": [
        {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "integer"
            },
            {
              "type": "integer"
            }
          ],
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Horizon Target"
    },
    "legacy_allow_plan": {
      "default": false,
      "title": "Legacy Allow Plan",
      "type": "boolean"
    },
    "need_facets": {
      "default": [],
      "items": {
        "$ref": "#/$defs/NeedFacet"
      },
      "title": "Need Facets",
      "type": "array"
    },
    "need_id": {
      "$ref": "#/$defs/StableId"
    },
    "need_type": {
      "minLength": 1,
      "title": "Need Type",
      "type": "string"
    },
    "planned_draft_id": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Planned Draft Id"
    },
    "planner_artifact_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/ArtifactId"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "planner_may_read_plan": {
      "default": false,
      "title": "Planner May Read Plan",
      "type": "boolean"
    },
    "predicates": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Predicates",
      "type": "array"
    },
    "preferred_resolution_path": {
      "$ref": "#/$defs/ResolutionPath"
    },
    "priority": {
      "default": 50,
      "maximum": 100,
      "minimum": 0,
      "title": "Priority",
      "type": "integer"
    },
    "purpose": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Purpose"
    },
    "query_hints": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Query Hints",
      "type": "array"
    },
    "query_intent": {
      "$ref": "#/$defs/Stage1QueryIntent"
    },
    "query_text": {
      "minLength": 1,
      "title": "Query Text",
      "type": "string"
    },
    "requirement": {
      "$ref": "#/$defs/RequirementLevel"
    },
    "retrieval_may_return_plan": {
      "default": false,
      "title": "Retrieval May Return Plan",
      "type": "boolean"
    },
    "risk_level": {
      "$ref": "#/$defs/NeedRisk"
    },
    "run_id": {
      "$ref": "#/$defs/RunId"
    },
    "semantic_question": {
      "default": "",
      "title": "Semantic Question",
      "type": "string"
    },
    "stop_condition": {
      "minLength": 1,
      "title": "Stop Condition",
      "type": "string"
    },
    "task_id": {
      "$ref": "#/$defs/TaskId"
    },
    "time_scope": {
      "anyOf": [
        {
          "$ref": "#/$defs/StoryTime"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "trigger_plan_chapters": {
      "default": [],
      "items": {
        "type": "integer"
      },
      "title": "Trigger Plan Chapters",
      "type": "array"
    },
    "trigger_plan_goal": {
      "default": "",
      "title": "Trigger Plan Goal",
      "type": "string"
    },
    "validated_need_set_hash": {
      "anyOf": [
        {
          "$ref": "#/$defs/ArtifactId"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "why_needed": {
      "minLength": 1,
      "title": "Why Needed",
      "type": "string"
    }
  },
  "required": [
    "need_id",
    "run_id",
    "task_id",
    "base_commit",
    "need_type",
    "query_intent",
    "query_text",
    "why_needed",
    "risk_level",
    "requirement",
    "preferred_resolution_path",
    "allowed_candidate_pools",
    "stop_condition"
  ],
  "title": "Stage1MemoryNeed",
  "type": "object"
}
