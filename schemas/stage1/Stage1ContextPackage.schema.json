{
  "$defs": {
    "ArtifactId": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "ArtifactId",
      "type": "string"
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/ArtifactId"
        },
        "byte_length": {
          "minimum": 0,
          "title": "Byte Length",
          "type": "integer"
        },
        "media_type": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "schema_version": {
          "$ref": "#/$defs/SchemaVersion"
        }
      },
      "required": [
        "artifact_id",
        "media_type",
        "byte_length",
        "schema_version"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "ChannelHit": {
      "additionalProperties": false,
      "properties": {
        "candidate_count": {
          "minimum": 1,
          "title": "Candidate Count",
          "type": "integer"
        },
        "channel": {
          "$ref": "#/$defs/RetrievalChannel"
        },
        "channel_rank": {
          "minimum": 1,
          "title": "Channel Rank",
          "type": "integer"
        },
        "hit_reason": {
          "minLength": 1,
          "title": "Hit Reason",
          "type": "string"
        },
        "raw_score": {
          "title": "Raw Score",
          "type": "number"
        },
        "unit": {
          "$ref": "#/$defs/RetrievalUnit"
        }
      },
      "required": [
        "unit",
        "channel",
        "channel_rank",
        "raw_score",
        "candidate_count",
        "hit_reason"
      ],
      "title": "ChannelHit",
      "type": "object"
    },
    "CommitId": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "CommitId",
      "type": "string"
    },
    "ContextBudgetReport": {
      "additionalProperties": false,
      "properties": {
        "dropped_optional_unit_ids": {
          "default": [],
          "items": {
            "$ref": "#/$defs/StableId"
          },
          "title": "Dropped Optional Unit Ids",
          "type": "array"
        },
        "full_chapter_read_count": {
          "minimum": 0,
          "title": "Full Chapter Read Count",
          "type": "integer"
        },
        "mandatory_tokens": {
          "minimum": 0,
          "title": "Mandatory Tokens",
          "type": "integer"
        },
        "optional_tokens": {
          "minimum": 0,
          "title": "Optional Tokens",
          "type": "integer"
        },
        "token_budget": {
          "minimum": 1,
          "title": "Token Budget",
          "type": "integer"
        }
      },
      "required": [
        "token_budget",
        "mandatory_tokens",
        "optional_tokens",
        "full_chapter_read_count"
      ],
      "title": "ContextBudgetReport",
      "type": "object"
    },
    "EvidenceRef": {
      "additionalProperties": false,
      "properties": {
        "chapter_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/StableId"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "evidence_id": {
          "$ref": "#/$defs/StableId"
        },
        "object_hash": {
          "$ref": "#/$defs/ArtifactId"
        },
        "quote_hash": {
          "anyOf": [
            {
              "$ref": "#/$defs/QuoteHash"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "resolved_at_commit": {
          "$ref": "#/$defs/CommitId"
        },
        "root_hash": {
          "$ref": "#/$defs/ArtifactId"
        },
        "scene_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/StableId"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "span": {
          "anyOf": [
            {
              "$ref": "#/$defs/TextSpanRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "support_status": {
          "$ref": "#/$defs/EvidenceSupportStatus"
        }
      },
      "required": [
        "evidence_id",
        "root_hash",
        "object_hash",
        "support_status",
        "resolved_at_commit"
      ],
      "title": "EvidenceRef",
      "type": "object"
    },
    "EvidenceSupportStatus": {
      "enum": [
        "current_support",
        "historical_support",
        "superseded_support",
        "orphaned",
        "contradicted"
      ],
      "title": "EvidenceSupportStatus",
      "type": "string"
    },
    "ExpectedClaimScope": {
      "enum": [
        "current",
        "historical",
        "knowledge",
        "planned"
      ],
      "title": "ExpectedClaimScope",
      "type": "string"
    },
    "FacetEvidenceRequirement": {
      "enum": [
        "traceable_cutoff_source",
        "cutoff_current_source",
        "plan_provenance",
        "distinct_historical_source"
      ],
      "title": "FacetEvidenceRequirement",
      "type": "string"
    },
    "FusedCandidate": {
      "additionalProperties": false,
      "properties": {
        "channel_hits": {
          "items": {
            "$ref": "#/$defs/ChannelHit"
          },
          "minItems": 1,
          "title": "Channel Hits",
          "type": "array"
        },
        "fused_rank": {
          "minimum": 1,
          "title": "Fused Rank",
          "type": "integer"
        },
        "rejection_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rejection Reason"
        },
        "rrf_score": {
          "exclusiveMinimum": 0,
          "title": "Rrf Score",
          "type": "number"
        },
        "selected": {
          "default": true,
          "title": "Selected",
          "type": "boolean"
        },
        "unit": {
          "$ref": "#/$defs/RetrievalUnit"
        }
      },
      "required": [
        "unit",
        "fused_rank",
        "rrf_score",
        "channel_hits"
      ],
      "title": "FusedCandidate",
      "type": "object"
    },
    "NeedCompletionSpec": {
      "additionalProperties": false,
      "properties": {
        "evidence_requirement_by_facet": {
          "additionalProperties": {
            "$ref": "#/$defs/FacetEvidenceRequirement"
          },
          "title": "Evidence Requirement By Facet",
          "type": "object"
        },
        "gap_policy": {
          "$ref": "#/$defs/NeedGapPolicy"
        },
        "irreducible_need_facet_ids": {
          "items": {
            "$ref": "#/$defs/StableId"
          },
          "title": "Irreducible Need Facet Ids",
          "type": "array"
        },
        "min_distinct_chapters": {
          "default": 1,
          "minimum": 1,
          "title": "Min Distinct Chapters",
          "type": "integer"
        },
        "min_distinct_evidence_sources": {
          "default": 1,
          "minimum": 1,
          "title": "Min Distinct Evidence Sources",
          "type": "integer"
        },
        "need_id": {
          "$ref": "#/$defs/StableId"
        },
        "producer": {
          "minLength": 1,
          "title": "Producer",
          "type": "string"
        },
        "producer_version": {
          "minLength": 1,
          "title": "Producer Version",
          "type": "string"
        },
        "require_causal_history": {
          "default": false,
          "title": "Require Causal History",
          "type": "boolean"
        },
        "require_current_claim": {
          "default": false,
          "title": "Require Current Claim",
          "type": "boolean"
        },
        "required_need_facet_ids": {
          "items": {
            "$ref": "#/$defs/StableId"
          },
          "title": "Required Need Facet Ids",
          "type": "array"
        },
        "uncertainty_policy": {
          "$ref": "#/$defs/NeedUncertaintyPolicy"
        }
      },
      "required": [
        "need_id",
        "required_need_facet_ids",
        "irreducible_need_facet_ids",
        "evidence_requirement_by_facet",
        "uncertainty_policy",
        "gap_policy",
        "producer",
        "producer_version"
      ],
      "title": "NeedCompletionSpec",
      "type": "object"
    },
    "NeedExecutionStatus": {
      "description": "Whether a legal Need actually received retrieval budget.",
      "enum": [
        "executed_with_candidates",
        "executed_empty",
        "not_executed_budget_exhausted",
        "not_executed_freshness_blocked",
        "not_executed_scope_blocked"
      ],
      "title": "NeedExecutionStatus",
      "type": "string"
    },
    "NeedFacet": {
      "additionalProperties": false,
      "properties": {
        "derivation_refs": {
          "items": {
            "$ref": "#/$defs/StableId"
          },
          "title": "Derivation Refs",
          "type": "array"
        },
        "expected_claim_scope": {
          "$ref": "#/$defs/ExpectedClaimScope"
        },
        "facet_kind": {
          "$ref": "#/$defs/NeedFacetKind"
        },
        "information_scope": {
          "minLength": 1,
          "title": "Information Scope",
          "type": "string"
        },
        "need_facet_id": {
          "$ref": "#/$defs/StableId"
        },
        "need_id": {
          "$ref": "#/$defs/StableId"
        },
        "producer": {
          "minLength": 1,
          "title": "Producer",
          "type": "string"
        },
        "producer_version": {
          "minLength": 1,
          "title": "Producer Version",
          "type": "string"
        }
      },
      "required": [
        "need_facet_id",
        "need_id",
        "facet_kind",
        "expected_claim_scope",
        "derivation_refs",
        "producer",
        "producer_version",
        "information_scope"
      ],
      "title": "NeedFacet",
      "type": "object"
    },
    "NeedFacetKind": {
      "enum": [
        "current_state",
        "relation_state",
        "capability_status",
        "limitation",
        "knowledge_boundary",
        "causal_history",
        "setup",
        "unresolved_status",
        "commitment",
        "plan_node"
      ],
      "title": "NeedFacetKind",
      "type": "string"
    },
    "NeedGapPolicy": {
      "enum": [
        "emit_typed_gap",
        "fail_mandatory"
      ],
      "title": "NeedGapPolicy",
      "type": "string"
    },
    "NeedUncertaintyPolicy": {
      "enum": [
        "allow_gap_only",
        "reject_unverified_claim"
      ],
      "title": "NeedUncertaintyPolicy",
      "type": "string"
    },
    "QuoteHash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "QuoteHash",
      "type": "string"
    },
    "RangeUnit": {
      "enum": [
        "unicode_codepoint"
      ],
      "title": "RangeUnit",
      "type": "string"
    },
    "RetrievalChannel": {
      "enum": [
        "r0",
        "r1_exact",
        "r1_temporal",
        "anchor_bm25",
        "anchor_dense",
        "grounded_bm25",
        "grounded_dense",
        "hierarchy",
        "typed_graph",
        "rerank"
      ],
      "title": "RetrievalChannel",
      "type": "string"
    },
    "RetrievalStopReason": {
      "enum": [
        "exact_satisfied",
        "budget_satisfied",
        "candidates_exhausted",
        "fallback_exhausted"
      ],
      "title": "RetrievalStopReason",
      "type": "string"
    },
    "RetrievalTrace": {
      "additionalProperties": false,
      "properties": {
        "allowed_channels": {
          "items": {
            "$ref": "#/$defs/RetrievalChannel"
          },
          "title": "Allowed Channels",
          "type": "array"
        },
        "anchors_expanded": {
          "default": 0,
          "minimum": 0,
          "title": "Anchors Expanded",
          "type": "integer"
        },
        "calls_allocated": {
          "default": 0,
          "minimum": 0,
          "title": "Calls Allocated",
          "type": "integer"
        },
        "candidates": {
          "items": {
            "$ref": "#/$defs/FusedCandidate"
          },
          "title": "Candidates",
          "type": "array"
        },
        "channel_candidate_counts": {
          "additionalProperties": {
            "type": "integer"
          },
          "propertyNames": {
            "$ref": "#/$defs/RetrievalChannel"
          },
          "title": "Channel Candidate Counts",
          "type": "object"
        },
        "channel_failures": {
          "additionalProperties": {
            "type": "string"
          },
          "propertyNames": {
            "$ref": "#/$defs/RetrievalChannel"
          },
          "title": "Channel Failures",
          "type": "object"
        },
        "closed_need_facet_ids": {
          "default": [],
          "items": {
            "$ref": "#/$defs/StableId"
          },
          "title": "Closed Need Facet Ids",
          "type": "array"
        },
        "fallback_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fallback Reason"
        },
        "fallback_used": {
          "default": false,
          "title": "Fallback Used",
          "type": "boolean"
        },
        "full_chapters_read": {
          "default": 0,
          "minimum": 0,
          "title": "Full Chapters Read",
          "type": "integer"
        },
        "fusion_applied": {
          "title": "Fusion Applied",
          "type": "boolean"
        },
        "intent": {
          "$ref": "#/$defs/Stage1QueryIntent"
        },
        "irreducible_need_facet_ids": {
          "default": [],
          "items": {
            "$ref": "#/$defs/StableId"
          },
          "title": "Irreducible Need Facet Ids",
          "type": "array"
        },
        "l0_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "L0 Tokens",
          "type": "integer"
        },
        "need_execution_status": {
          "$ref": "#/$defs/NeedExecutionStatus",
          "default": "executed_empty"
        },
        "need_id": {
          "$ref": "#/$defs/StableId"
        },
        "required_need_facet_ids": {
          "default": [],
          "items": {
            "$ref": "#/$defs/StableId"
          },
          "title": "Required Need Facet Ids",
          "type": "array"
        },
        "rerank_applied": {
          "default": false,
          "title": "Rerank Applied",
          "type": "boolean"
        },
        "scenes_expanded": {
          "default": 0,
          "minimum": 0,
          "title": "Scenes Expanded",
          "type": "integer"
        },
        "spans_expanded": {
          "default": 0,
          "minimum": 0,
          "title": "Spans Expanded",
          "type": "integer"
        },
        "stop_reason": {
          "$ref": "#/$defs/RetrievalStopReason"
        }
      },
      "required": [
        "need_id",
        "intent",
        "allowed_channels",
        "channel_candidate_counts",
        "candidates",
        "fusion_applied",
        "stop_reason"
      ],
      "title": "RetrievalTrace",
      "type": "object"
    },
    "RetrievalUnit": {
      "additionalProperties": false,
      "properties": {
        "access_scope": {
          "default": "writer_safe",
          "minLength": 1,
          "title": "Access Scope",
          "type": "string"
        },
        "canonical_alias_receipt_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "canonical_value_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/StableId"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "canonicalizer_version": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Canonicalizer Version"
        },
        "content_hash": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactId"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "derivation_taint": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Derivation Taint",
          "type": "array"
        },
        "entity_ids": {
          "default": [],
          "items": {
            "$ref": "#/$defs/StableId"
          },
          "title": "Entity Ids",
          "type": "array"
        },
        "evidence_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "information_label": {
          "default": "observed",
          "minLength": 1,
          "title": "Information Label",
          "type": "string"
        },
        "mandatory": {
          "default": false,
          "title": "Mandatory",
          "type": "boolean"
        },
        "narrative_end": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Narrative End"
        },
        "narrative_start": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Narrative Start"
        },
        "parent_unit_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/StableId"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "parent_unit_ids": {
          "default": [],
          "items": {
            "$ref": "#/$defs/StableId"
          },
          "title": "Parent Unit Ids",
          "type": "array"
        },
        "predicate": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Predicate"
        },
        "snapshot_id": {
          "$ref": "#/$defs/StableId"
        },
        "source_artifact": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactId"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "source_commit": {
          "$ref": "#/$defs/CommitId"
        },
        "source_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ArtifactId"
          },
          "title": "Source Refs",
          "type": "array"
        },
        "story_time_end": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Story Time End"
        },
        "story_time_start": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Story Time Start"
        },
        "support_status": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Support Status"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "truth_class": {
          "anyOf": [
            {
              "$ref": "#/$defs/TruthClass"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "unit_id": {
          "$ref": "#/$defs/StableId"
        },
        "unit_kind": {
          "$ref": "#/$defs/RetrievalUnitKind"
        },
        "worldline": {
          "default": "main",
          "minLength": 1,
          "title": "Worldline",
          "type": "string"
        }
      },
      "required": [
        "unit_id",
        "unit_kind",
        "source_commit",
        "snapshot_id",
        "text"
      ],
      "title": "RetrievalUnit",
      "type": "object"
    },
    "RetrievalUnitKind": {
      "enum": [
        "fact_anchor",
        "state_anchor",
        "relation_anchor",
        "event_anchor",
        "scene_anchor",
        "chapter_anchor",
        "arc_anchor",
        "plan_anchor",
        "grounded_block",
        "grounded_span"
      ],
      "title": "RetrievalUnitKind",
      "type": "string"
    },
    "SchemaVersion": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "title": "SchemaVersion",
      "type": "string"
    },
    "StableId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "StableId",
      "type": "string"
    },
    "Stage1QueryIntent": {
      "enum": [
        "current_state",
        "known_id",
        "plan_node",
        "mandatory_constraint",
        "semantic_history",
        "related_event",
        "plan_obligation",
        "global_arc",
        "chapter_thread",
        "character_arc",
        "exact_quote",
        "rare_phrase",
        "style_voice",
        "dialogue_sample",
        "causal_multi_hop",
        "relation_chain",
        "anchor_insufficient"
      ],
      "title": "Stage1QueryIntent",
      "type": "string"
    },
    "TextSpanRef": {
      "additionalProperties": false,
      "properties": {
        "block_id": {
          "$ref": "#/$defs/StableId"
        },
        "end": {
          "minimum": 0,
          "title": "End",
          "type": "integer"
        },
        "range_unit": {
          "$ref": "#/$defs/RangeUnit",
          "default": "unicode_codepoint"
        },
        "start": {
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        }
      },
      "required": [
        "block_id",
        "start",
        "end"
      ],
      "title": "TextSpanRef",
      "type": "object"
    },
    "TruthClass": {
      "enum": [
        "accepted_world_fact",
        "assertion",
        "rumor",
        "dream",
        "prediction",
        "hypothetical",
        "unknown",
        "contested",
        "disproved",
        "retconned",
        "not_applicable"
      ],
      "title": "TruthClass",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "active_plan_obligations": {
      "default": [],
      "items": {
        "$ref": "#/$defs/RetrievalUnit"
      },
      "title": "Active Plan Obligations",
      "type": "array"
    },
    "base_commit": {
      "$ref": "#/$defs/CommitId"
    },
    "benchmark_quality_eligible": {
      "default": false,
      "title": "Benchmark Quality Eligible",
      "type": "boolean"
    },
    "budget_report": {
