{
  "$defs": {
    "ArtifactId": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "ArtifactId",
      "type": "string"
    },
    "ChapterDocument": {
      "additionalProperties": false,
      "properties": {
        "chapter_id": {
          "$ref": "#/$defs/StableId"
        },
        "chapter_index": {
          "minimum": 1,
          "title": "Chapter Index",
          "type": "integer"
        },
        "scenes": {
          "default": [],
          "items": {
            "$ref": "#/$defs/SceneDocument"
          },
          "title": "Scenes",
          "type": "array"
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title"
        }
      },
      "required": [
        "chapter_id",
        "chapter_index"
      ],
      "title": "ChapterDocument",
      "type": "object"
    },
    "PreludeDocument": {
      "additionalProperties": false,
      "properties": {
        "prelude_id": {
          "$ref": "#/$defs/StableId"
        },
        "scenes": {
          "items": {
            "$ref": "#/$defs/SceneDocument"
          },
          "title": "Scenes",
          "type": "array"
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title"
        }
      },
      "required": [
        "prelude_id",
        "scenes"
      ],
      "title": "PreludeDocument",
      "type": "object"
    },
    "SceneDocument": {
      "additionalProperties": false,
      "properties": {
        "blocks": {
          "default": [],
          "items": {
            "$ref": "#/$defs/TextBlock"
          },
          "title": "Blocks",
          "type": "array"
        },
        "scene_id": {
          "$ref": "#/$defs/StableId"
        },
        "scene_index": {
          "minimum": 0,
          "title": "Scene Index",
          "type": "integer"
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title"
        }
      },
      "required": [
        "scene_id",
        "scene_index"
      ],
      "title": "SceneDocument",
      "type": "object"
    },
    "SchemaVersion": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "title": "SchemaVersion",
      "type": "string"
    },
    "StableId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "StableId",
      "type": "string"
    },
    "TextBlock": {
      "additionalProperties": false,
      "properties": {
        "block_id": {
          "$ref": "#/$defs/StableId"
        },
        "chapter_id": {
          "$ref": "#/$defs/StableId"
        },
        "narrative_index": {
          "minimum": 0,
          "title": "Narrative Index",
          "type": "integer"
        },
        "scene_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/StableId"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "block_id",
        "chapter_id",
        "narrative_index",
        "text"
      ],
      "title": "TextBlock",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "chapters": {
      "items": {
        "$ref": "#/$defs/ChapterDocument"
      },
      "title": "Chapters",
      "type": "array"
    },
    "prelude": {
      "anyOf": [
        {
          "$ref": "#/$defs/PreludeDocument"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "root_hash": {
      "$ref": "#/$defs/ArtifactId"
    },
    "schema_version": {
      "$ref": "#/$defs/SchemaVersion"
    }
  },
  "required": [
    "root_hash",
    "schema_version",
    "chapters"
  ],
  "title": "TextRootDocument",
  "type": "object"
}
