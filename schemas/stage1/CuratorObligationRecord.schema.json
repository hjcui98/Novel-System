{
  "$defs": {
    "StableId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "StableId",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "description": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Description",
      "type": "string"
    },
    "due_chapter": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Due Chapter"
    },
    "kind": {
      "enum": [
        "foreshadowing",
        "promise",
        "objective",
        "unresolved_conflict"
      ],
      "title": "Kind",
      "type": "string"
    },
    "not_before_chapter": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Not Before Chapter"
    },
    "owner_ids": {
      "default": [],
      "items": {
        "$ref": "#/$defs/StableId"
      },
      "maxItems": 6,
      "title": "Owner Ids",
      "type": "array"
    },
    "status": {
      "enum": [
        "open",
        "progressed",
        "resolved",
        "abandoned"
      ],
      "title": "Status",
      "type": "string"
    },
    "target_chapter_end": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Target Chapter End"
    },
    "target_chapter_start": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Target Chapter Start"
    }
  },
  "required": [
    "kind",
    "description",
    "status"
  ],
  "title": "CuratorObligationRecord",
  "type": "object"
}
