{
  "$defs": {
    "ArtifactId": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "ArtifactId",
      "type": "string"
    },
    "ChangeOperationType": {
      "enum": [
        "create",
        "replace",
        "retire"
      ],
      "title": "ChangeOperationType",
      "type": "string"
    },
    "CommitId": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "CommitId",
      "type": "string"
    },
    "EvidenceRef": {
      "additionalProperties": false,
      "properties": {
        "chapter_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/StableId"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "evidence_id": {
          "$ref": "#/$defs/StableId"
        },
        "object_hash": {
          "$ref": "#/$defs/ArtifactId"
        },
        "quote_hash": {
          "anyOf": [
            {
              "$ref": "#/$defs/QuoteHash"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "resolved_at_commit": {
          "$ref": "#/$defs/CommitId"
        },
        "root_hash": {
          "$ref": "#/$defs/ArtifactId"
        },
        "scene_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/StableId"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "span": {
          "anyOf": [
            {
              "$ref": "#/$defs/TextSpanRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "support_status": {
          "$ref": "#/$defs/EvidenceSupportStatus"
        }
      },
      "required": [
        "evidence_id",
        "root_hash",
        "object_hash",
        "support_status",
        "resolved_at_commit"
      ],
      "title": "EvidenceRef",
      "type": "object"
    },
    "EvidenceSupportStatus": {
      "enum": [
        "current_support",
        "historical_support",
        "superseded_support",
        "orphaned",
        "contradicted"
      ],
      "title": "EvidenceSupportStatus",
      "type": "string"
    },
    "JsonValue": {},
    "ProjectId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "ProjectId",
      "type": "string"
    },
    "QuoteHash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "QuoteHash",
      "type": "string"
    },
    "RangeUnit": {
      "enum": [
        "unicode_codepoint"
      ],
      "title": "RangeUnit",
      "type": "string"
    },
    "ReplayExpectedRecord": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "$ref": "#/$defs/ReplayStateCategory",
          "default": "other"
        },
        "expected_record": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Expected Record",
          "type": "object"
        },
        "record_kind": {
          "$ref": "#/$defs/WorldRecordKind"
        },
        "target_id": {
          "$ref": "#/$defs/StableId"
        }
      },
      "required": [
        "record_kind",
        "target_id",
        "expected_record"
      ],
      "title": "ReplayExpectedRecord",
      "type": "object"
    },
    "ReplayGoldChange": {
      "additionalProperties": false,
      "properties": {
        "chapter_index": {
          "minimum": 1,
          "title": "Chapter Index",
          "type": "integer"
        },
        "critical": {
          "default": false,
          "title": "Critical",
          "type": "boolean"
        },
        "evidence_refs": {
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "minItems": 1,
          "title": "Evidence Refs",
          "type": "array"
        },
        "expected_record": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Expected Record",
          "type": "object"
        },
        "gold_change_id": {
          "$ref": "#/$defs/StableId"
        },
        "operation": {
          "$ref": "#/$defs/ChangeOperationType"
        },
        "record_kind": {
          "$ref": "#/$defs/WorldRecordKind"
        },
        "target_id": {
          "$ref": "#/$defs/StableId"
        }
      },
      "required": [
        "gold_change_id",
        "chapter_index",
        "operation",
        "record_kind",
        "target_id",
        "expected_record",
        "evidence_refs"
      ],
      "title": "ReplayGoldChange",
      "type": "object"
    },
    "ReplayStateCategory": {
      "enum": [
        "ownership",
        "location",
        "vital_or_injury",
        "obligation",
        "other"
      ],
      "title": "ReplayStateCategory",
      "type": "string"
    },
    "ReplayStateCheckpoint": {
      "additionalProperties": false,
      "properties": {
        "chapter_index": {
          "minimum": 1,
          "title": "Chapter Index",
          "type": "integer"
        },
        "expected_records": {
          "items": {
            "$ref": "#/$defs/ReplayExpectedRecord"
          },
          "minItems": 1,
          "title": "Expected Records",
          "type": "array"
        }
      },
      "required": [
        "chapter_index",
        "expected_records"
      ],
      "title": "ReplayStateCheckpoint",
      "type": "object"
    },
    "SchemaVersion": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "title": "SchemaVersion",
      "type": "string"
    },
    "StableId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "StableId",
      "type": "string"
    },
    "TextSpanRef": {
      "additionalProperties": false,
      "properties": {
        "block_id": {
          "$ref": "#/$defs/StableId"
        },
        "end": {
          "minimum": 0,
          "title": "End",
          "type": "integer"
        },
        "range_unit": {
          "$ref": "#/$defs/RangeUnit",
          "default": "unicode_codepoint"
        },
        "start": {
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        }
      },
      "required": [
        "block_id",
        "start",
        "end"
      ],
      "title": "TextSpanRef",
      "type": "object"
    },
    "WorldRecordKind": {
      "enum": [
        "entity",
        "event",
        "state",
        "relation",
        "obligation"
      ],
      "title": "WorldRecordKind",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "annotation_version": {
      "$ref": "#/$defs/SchemaVersion"
    },
    "chapter_range": {
      "maxItems": 2,
      "minItems": 2,
      "prefixItems": [
        {
          "type": "integer"
        },
        {
          "type": "integer"
        }
      ],
      "title": "Chapter Range",
      "type": "array"
    },
    "gate_eligible": {
      "default": true,
      "title": "Gate Eligible",
      "type": "boolean"
    },
    "gold_changes": {
      "items": {
        "$ref": "#/$defs/ReplayGoldChange"
      },
      "title": "Gold Changes",
      "type": "array"
    },
    "initial_world_root": {
      "$ref": "#/$defs/ArtifactId"
    },
    "project_id": {
      "$ref": "#/$defs/ProjectId"
    },
    "replay_case_id": {
      "$ref": "#/$defs/StableId"
    },
    "state_checkpoints": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ReplayStateCheckpoint"
      },
      "title": "State Checkpoints",
      "type": "array"
    },
    "target_text_root": {
      "$ref": "#/$defs/ArtifactId"
    }
  },
  "required": [
    "replay_case_id",
    "project_id",
    "chapter_range",
    "target_text_root",
    "initial_world_root",
    "gold_changes",
    "annotation_version"
  ],
  "title": "ReplayCaseManifest",
  "type": "object"
}
