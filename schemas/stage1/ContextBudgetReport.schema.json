      "type": "array"
    },
    "full_chapter_read_count": {
      "minimum": 0,
      "title": "Full Chapter Read Count",
      "type": "integer"
    },
    "mandatory_tokens": {
      "minimum": 0,
      "title": "Mandatory Tokens",
      "type": "integer"
    },
    "optional_tokens": {
      "minimum": 0,
      "title": "Optional Tokens",
      "type": "integer"
    },
    "token_budget": {
      "minimum": 1,
      "title": "Token Budget",
      "type": "integer"
    }
  },
  "required": [
    "token_budget",
    "mandatory_tokens",
    "optional_tokens",
    "full_chapter_read_count"
  ],
  "title": "ContextBudgetReport",
  "type": "object"
}
