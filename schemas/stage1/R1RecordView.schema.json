{
  "$defs": {
    "CommitId": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "CommitId",
      "type": "string"
    },
    "JsonValue": {},
    "StableId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "StableId",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "entity_ids": {
      "default": [],
      "items": {
        "$ref": "#/$defs/StableId"
      },
      "title": "Entity Ids",
      "type": "array"
    },
    "predicate": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Predicate"
    },
    "record": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Record",
      "type": "object"
    },
    "record_id": {
      "$ref": "#/$defs/StableId"
    },
    "record_kind": {
      "minLength": 1,
      "title": "Record Kind",
      "type": "string"
    },
    "row_id": {
      "$ref": "#/$defs/StableId"
    },
    "source_commit": {
      "$ref": "#/$defs/CommitId"
    },
    "truth_class": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Truth Class"
    },
    "valid_end": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Valid End"
    },
    "valid_start": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Valid Start"
    }
  },
  "required": [
    "row_id",
    "source_commit",
    "record_kind",
    "record_id",
    "record"
  ],
  "title": "R1RecordView",
  "type": "object"
}
