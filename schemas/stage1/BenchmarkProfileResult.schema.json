      "title": "Failure Categories",
      "type": "array"
    },
    "metrics": {
      "$ref": "#/$defs/BenchmarkMetricSet"
    },
    "profile": {
      "minLength": 1,
      "title": "Profile",
      "type": "string"
    },
    "retrieved_evidence_ids": {
      "default": [],
      "items": {
        "$ref": "#/$defs/StableId"
