{
  "$defs": {
    "JsonValue": {},
    "ReplayExpectedRecord": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "$ref": "#/$defs/ReplayStateCategory",
          "default": "other"
        },
        "expected_record": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Expected Record",
          "type": "object"
        },
        "record_kind": {
          "$ref": "#/$defs/WorldRecordKind"
        },
        "target_id": {
          "$ref": "#/$defs/StableId"
        }
      },
      "required": [
        "record_kind",
        "target_id",
        "expected_record"
      ],
      "title": "ReplayExpectedRecord",
      "type": "object"
    },
    "ReplayStateCategory": {
      "enum": [
        "ownership",
        "location",
        "vital_or_injury",
        "obligation",
        "other"
      ],
      "title": "ReplayStateCategory",
      "type": "string"
    },
    "StableId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "StableId",
      "type": "string"
    },
    "WorldRecordKind": {
      "enum": [
        "entity",
        "event",
        "state",
        "relation",
        "obligation"
      ],
      "title": "WorldRecordKind",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "chapter_index": {
      "minimum": 1,
      "title": "Chapter Index",
      "type": "integer"
    },
    "expected_records": {
      "items": {
        "$ref": "#/$defs/ReplayExpectedRecord"
      },
      "minItems": 1,
      "title": "Expected Records",
      "type": "array"
    }
  },
  "required": [
    "chapter_index",
    "expected_records"
  ],
  "title": "ReplayStateCheckpoint",
  "type": "object"
}
