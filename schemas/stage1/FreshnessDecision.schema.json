{
  "$defs": {
    "CommitId": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "CommitId",
      "type": "string"
    },
    "FreshnessStatus": {
      "enum": [
        "ready",
        "waiting",
        "degraded",
        "blocked",
        "overridden"
      ],
      "title": "FreshnessStatus",
      "type": "string"
    },
    "StableId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "StableId",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "actual_alias_commit": {
      "anyOf": [
        {
          "$ref": "#/$defs/CommitId"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "actual_snapshot_commit": {
      "anyOf": [
        {
          "$ref": "#/$defs/CommitId"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "actual_snapshot_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/StableId"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "canonical_commit": {
      "$ref": "#/$defs/CommitId"
    },
    "manual_approval_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/StableId"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "r1_basis_commit": {
      "$ref": "#/$defs/CommitId"
    },
    "reason": {
      "minLength": 1,
      "title": "Reason",
      "type": "string"
    },
    "required_snapshot_id": {
      "$ref": "#/$defs/StableId"
    },
    "status": {
      "$ref": "#/$defs/FreshnessStatus"
    }
  },
  "required": [
    "status",
    "canonical_commit",
    "r1_basis_commit",
    "required_snapshot_id",
    "reason"
  ],
  "title": "FreshnessDecision",
  "type": "object"
}
