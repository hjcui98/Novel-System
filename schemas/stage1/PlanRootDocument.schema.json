{
  "$defs": {
    "ArtifactId": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "ArtifactId",
      "type": "string"
    },
    "ChapterGoal": {
      "additionalProperties": false,
      "properties": {
        "chapter_index": {
          "minimum": 1,
          "title": "Chapter Index",
          "type": "integer"
        },
        "goal_id": {
          "$ref": "#/$defs/StableId"
        },
        "obligation_ids": {
          "default": [],
          "items": {
            "$ref": "#/$defs/StableId"
          },
          "title": "Obligation Ids",
          "type": "array"
        },
        "summary": {
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "goal_id",
        "chapter_index",
        "summary"
      ],
      "title": "ChapterGoal",
      "type": "object"
    },
    "PlanNode": {
      "additionalProperties": false,
      "properties": {
        "node_type": {
          "minLength": 1,
          "title": "Node Type",
          "type": "string"
        },
        "obligation_ids": {
          "default": [],
          "items": {
            "$ref": "#/$defs/StableId"
          },
          "title": "Obligation Ids",
          "type": "array"
        },
        "parent_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/StableId"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "plan_node_id": {
          "$ref": "#/$defs/StableId"
        },
        "summary": {
          "title": "Summary",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "plan_node_id",
        "node_type",
        "title",
        "summary"
      ],
      "title": "PlanNode",
      "type": "object"
    },
    "SchemaVersion": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "title": "SchemaVersion",
      "type": "string"
    },
    "StableId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "StableId",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "chapter_goals": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ChapterGoal"
      },
      "title": "Chapter Goals",
      "type": "array"
    },
    "nodes": {
      "default": [],
      "items": {
        "$ref": "#/$defs/PlanNode"
      },
      "title": "Nodes",
      "type": "array"
    },
    "root_hash": {
      "$ref": "#/$defs/ArtifactId"
    },
    "schema_version": {
      "$ref": "#/$defs/SchemaVersion"
    }
  },
  "required": [
    "root_hash",
    "schema_version"
  ],
  "title": "PlanRootDocument",
  "type": "object"
}
