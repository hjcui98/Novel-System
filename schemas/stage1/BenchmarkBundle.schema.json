{
  "$defs": {
    "ArtifactId": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "ArtifactId",
      "type": "string"
    },
    "AuthorPlanningContext": {
      "additionalProperties": false,
      "description": "Typed, validated projection of the raw input.yaml planning fields.\n\nThis is the single source of truth for the author-visible planning\ninputs (task intent, profile, visible outline, and chapter goals).  It\nnever carries Gold, future prose, or preparation material; the compiler\nnormalizes the raw YAML before it can enter any runtime payload.",
      "properties": {
        "chapter_goals": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ChapterGoal"
          },
          "title": "Chapter Goals",
          "type": "array"
        },
        "planner_may_read_plan": {
          "default": true,
          "title": "Planner May Read Plan",
          "type": "boolean"
        },
        "profile": {
          "$ref": "#/$defs/BenchmarkInformationProfile"
        },
        "source_hash": {
          "$ref": "#/$defs/ArtifactId"
        },
        "target_range": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "integer"
            },
            {
              "type": "integer"
            }
          ],
          "title": "Target Range",
          "type": "array"
        },
        "task_intent": {
          "minLength": 1,
          "title": "Task Intent",
          "type": "string"
        },
        "visible_outline_nodes": {
          "default": [],
          "items": {
            "$ref": "#/$defs/VisibleOutlineNode"
          },
          "title": "Visible Outline Nodes",
          "type": "array"
        }
      },
      "required": [
        "profile",
        "task_intent",
        "target_range",
        "source_hash"
      ],
      "title": "AuthorPlanningContext",
      "type": "object"
    },
    "BenchmarkCaseManifest": {
      "additionalProperties": false,
      "properties": {
        "annotation_version": {
          "$ref": "#/$defs/SchemaVersion"
        },
        "case_id": {
          "$ref": "#/$defs/StableId"
        },
        "chapter_goal_ids": {
          "default": [],
          "items": {
            "$ref": "#/$defs/StableId"
          },
          "title": "Chapter Goal Ids",
          "type": "array"
        },
        "expected_tracks": {
          "default": [
            "oracle_verified",
            "end_to_end"
          ],
          "items": {
            "$ref": "#/$defs/BenchmarkTrack"
          },
          "title": "Expected Tracks",
          "type": "array"
        },
        "future_text_root_private": {
          "$ref": "#/$defs/ArtifactId"
        },
        "gate_eligible": {
          "default": true,
          "title": "Gate Eligible",
          "type": "boolean"
        },
        "gold_need_specs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/GoldNeedSpec"
          },
          "title": "Gold Need Specs",
          "type": "array"
        },
        "history_range": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "integer"
            },
            {
              "type": "integer"
            }
          ],
          "title": "History Range",
          "type": "array"
        },
        "information_profile": {
          "anyOf": [
            {
              "$ref": "#/$defs/BenchmarkInformationProfile"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "input_plan_root": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactId"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "input_summary_root": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactId"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "input_text_root": {
          "$ref": "#/$defs/ArtifactId"
        },
        "input_world_root_verified": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactId"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "observed_use_gold": {
          "items": {
            "$ref": "#/$defs/GoldItem"
          },
          "title": "Observed Use Gold",
          "type": "array"
        },
        "operational_constraint_gold": {
          "items": {
            "$ref": "#/$defs/GoldItem"
          },
          "title": "Operational Constraint Gold",
          "type": "array"
        },
        "plan_obligation_gold": {
          "items": {
            "$ref": "#/$defs/GoldItem"
          },
          "title": "Plan Obligation Gold",
          "type": "array"
        },
        "planning_context_hash": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactId"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "planning_context_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactId"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "project_id": {
          "$ref": "#/$defs/ProjectId"
        },
        "target_range": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "integer"
            },
            {
              "type": "integer"
            }
          ],
          "title": "Target Range",
          "type": "array"
        },
        "task_contract": {
          "anyOf": [
            {
              "$ref": "#/$defs/BenchmarkTaskContract"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "task_intent": {
          "default": "",
          "title": "Task Intent",
          "type": "string"
        }
      },
      "required": [
        "case_id",
        "project_id",
        "history_range",
        "target_range",
        "input_text_root",
        "future_text_root_private",
        "observed_use_gold",
        "operational_constraint_gold",
        "plan_obligation_gold",
        "annotation_version"
      ],
      "title": "BenchmarkCaseManifest",
      "type": "object"
    },
    "BenchmarkInformationProfile": {
      "enum": [
        "visible_at_cutoff",
        "task_intent_only",
        "author_plan_conditioned"
      ],
      "title": "BenchmarkInformationProfile",
      "type": "string"
    },
    "BenchmarkTaskContract": {
      "additionalProperties": false,
      "properties": {
        "checkpoint_chapter": {
          "minimum": 0,
          "title": "Checkpoint Chapter",
          "type": "integer"
        },
        "information_profile": {
          "$ref": "#/$defs/BenchmarkInformationProfile"
        },
        "output_contract_version": {
          "minLength": 1,
          "title": "Output Contract Version",
          "type": "string"
        },
        "planning_context_hash": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactId"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "planning_context_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactId"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "target_chapter_end": {
          "minimum": 1,
          "title": "Target Chapter End",
          "type": "integer"
        },
        "target_chapter_start": {
          "minimum": 1,
          "title": "Target Chapter Start",
          "type": "integer"
        },
        "task_id": {
          "$ref": "#/$defs/StableId"
        },
        "task_intent": {
          "default": "",
          "title": "Task Intent",
          "type": "string"
        },
        "task_kind": {
          "const": "memory_context_for_target_range",
          "default": "memory_context_for_target_range",
          "title": "Task Kind",
          "type": "string"
        },
        "task_template_version": {
          "minLength": 1,
          "title": "Task Template Version",
          "type": "string"
        },
        "task_text": {
          "minLength": 1,
          "title": "Task Text",
          "type": "string"
        }
      },
      "required": [
        "task_id",
        "task_text",
        "checkpoint_chapter",
        "target_chapter_start",
        "target_chapter_end",
        "information_profile",
        "task_template_version",
        "output_contract_version"
      ],
      "title": "BenchmarkTaskContract",
      "type": "object"
    },
    "BenchmarkTrack": {
      "enum": [
        "oracle_verified",
        "end_to_end"
      ],
      "title": "BenchmarkTrack",
      "type": "string"
    },
    "ChangeOperationType": {
      "enum": [
        "create",
        "replace",
        "retire"
      ],
      "title": "ChangeOperationType",
      "type": "string"
    },
    "ChapterDocument": {
      "additionalProperties": false,
      "properties": {
        "chapter_id": {
          "$ref": "#/$defs/StableId"
        },
        "chapter_index": {
          "minimum": 1,
          "title": "Chapter Index",
          "type": "integer"
        },
        "scenes": {
          "default": [],
          "items": {
            "$ref": "#/$defs/SceneDocument"
          },
          "title": "Scenes",
          "type": "array"
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title"
        }
      },
      "required": [
        "chapter_id",
        "chapter_index"
      ],
      "title": "ChapterDocument",
      "type": "object"
    },
    "ChapterGoal": {
      "additionalProperties": false,
      "properties": {
        "chapter_index": {
          "minimum": 1,
          "title": "Chapter Index",
          "type": "integer"
        },
        "goal_id": {
          "$ref": "#/$defs/StableId"
        },
        "obligation_ids": {
          "default": [],
          "items": {
            "$ref": "#/$defs/StableId"
          },
          "title": "Obligation Ids",
          "type": "array"
        },
        "summary": {
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "goal_id",
        "chapter_index",
        "summary"
      ],
      "title": "ChapterGoal",
      "type": "object"
    },
    "ChapterSummary": {
      "additionalProperties": false,
      "properties": {
        "chapter_id": {
          "$ref": "#/$defs/StableId"
        },
        "chapter_index": {
          "minimum": 1,
          "title": "Chapter Index",
          "type": "integer"
        },
        "evidence_refs": {
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "minItems": 1,
          "title": "Evidence Refs",
          "type": "array"
        },
        "summary": {
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "chapter_id",
        "chapter_index",
        "summary",
        "evidence_refs"
      ],
      "title": "ChapterSummary",
      "type": "object"
    },
    "ChapterSummaryRootDocument": {
      "additionalProperties": false,
      "properties": {
        "root_hash": {
          "$ref": "#/$defs/ArtifactId"
        },
        "schema_version": {
          "$ref": "#/$defs/SchemaVersion"
        },
        "source_text_root": {
          "$ref": "#/$defs/ArtifactId"
        },
        "summaries": {
          "items": {
            "$ref": "#/$defs/ChapterSummary"
          },
          "title": "Summaries",
          "type": "array"
        }
      },
      "required": [
        "root_hash",
        "schema_version",
        "source_text_root",
        "summaries"
      ],
      "title": "ChapterSummaryRootDocument",
      "type": "object"
    },
    "CommitId": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "CommitId",
      "type": "string"
    },
    "Entity": {
      "additionalProperties": false,
      "properties": {
        "aliases": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Aliases",
          "type": "array"
        },
        "entity_id": {
          "$ref": "#/$defs/StableId"
        },
        "entity_type": {
          "minLength": 1,
          "title": "Entity Type",
          "type": "string"
        },
        "identity_invariants": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Identity Invariants",
          "type": "array"
        },
        "internal_label": {
          "minLength": 1,
          "title": "Internal Label",
          "type": "string"
        }
      },
      "required": [
        "entity_id",
        "entity_type",
        "internal_label"
      ],
      "title": "Entity",
      "type": "object"
    },
    "EvaluatorAccessPolicy": {
      "enum": [
        "reveal_after_context_freeze"
      ],
      "title": "EvaluatorAccessPolicy",
      "type": "string"
    },
    "Event": {
      "additionalProperties": false,
      "properties": {
        "effect_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/StableId"
          },
          "title": "Effect Refs",
          "type": "array"
        },
        "event_id": {
          "$ref": "#/$defs/StableId"
        },
        "event_type": {
          "minLength": 1,
          "title": "Event Type",
          "type": "string"
        },
        "evidence_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "narrative_order": {
          "anyOf": [
            {
              "$ref": "#/$defs/NarrativeOrder"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "participant_ids": {
          "default": [],
          "items": {
            "$ref": "#/$defs/StableId"
          },
          "title": "Participant Ids",
          "type": "array"
        },
        "story_time": {
          "anyOf": [
            {
              "$ref": "#/$defs/StoryTime"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "truth_class": {
          "$ref": "#/$defs/TruthClass"
        }
      },
      "required": [
        "event_id",
        "event_type",
        "truth_class"
      ],
      "title": "Event",
      "type": "object"
    },
    "EvidenceRef": {
      "additionalProperties": false,
      "properties": {
        "chapter_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/StableId"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "evidence_id": {
          "$ref": "#/$defs/StableId"
        },
        "object_hash": {
          "$ref": "#/$defs/ArtifactId"
        },
        "quote_hash": {
          "anyOf": [
            {
              "$ref": "#/$defs/QuoteHash"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "resolved_at_commit": {
          "$ref": "#/$defs/CommitId"
        },
        "root_hash": {
          "$ref": "#/$defs/ArtifactId"
        },
        "scene_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/StableId"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "span": {
          "anyOf": [
            {
              "$ref": "#/$defs/TextSpanRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "support_status": {
          "$ref": "#/$defs/EvidenceSupportStatus"
        }
      },
      "required": [
        "evidence_id",
        "root_hash",
        "object_hash",
        "support_status",
        "resolved_at_commit"
      ],
      "title": "EvidenceRef",
      "type": "object"
    },
    "EvidenceSet": {
      "additionalProperties": false,
      "description": "One accepted, conjunctive evidence alternative for a Gold item.",
      "properties": {
        "component_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Component Ids",
          "type": "array"
        },
        "evidence_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "evidence_set_id": {
          "$ref": "#/$defs/StableId"
        },
        "plan_node_ids": {
          "default": [],
          "items": {
            "$ref": "#/$defs/StableId"
          },
          "title": "Plan Node Ids",
          "type": "array"
        }
      },
      "required": [
        "evidence_set_id"
      ],
      "title": "EvidenceSet",
      "type": "object"
    },
    "EvidenceSupportStatus": {
      "enum": [
        "current_support",
        "historical_support",
        "superseded_support",
        "orphaned",
        "contradicted"
      ],
      "title": "EvidenceSupportStatus",
      "type": "string"
    },
    "GoldBlindness": {
      "description": "Gold recoverability classification (semantic evaluation §5.7).",
      "enum": [
        "blind_recoverable",
        "plan_dependent",
        "hindsight_only"
      ],
      "title": "GoldBlindness",
      "type": "string"
    },
    "GoldItem": {
      "additionalProperties": false,
      "properties": {
        "accepted_evidence_sets": {
          "default": [],
          "items": {
            "$ref": "#/$defs/EvidenceSet"
          },
          "title": "Accepted Evidence Sets",
          "type": "array"
        },
        "applicable_profiles": {
          "default": [
            "visible_at_cutoff",
            "task_intent_only",
            "author_plan_conditioned"
          ],
          "items": {
            "$ref": "#/$defs/BenchmarkInformationProfile"
          },
          "title": "Applicable Profiles",
          "type": "array"
        },
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "evidence_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "fact": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fact"
        },
        "future_evidence_refs": {
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "minItems": 1,
          "title": "Future Evidence Refs",
          "type": "array"
        },
        "gold_id": {
          "$ref": "#/$defs/StableId"
        },
        "gold_type": {
          "anyOf": [
            {
              "$ref": "#/$defs/GoldType"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "kind": {
          "$ref": "#/$defs/GoldKind"
        },
        "mandatory": {
          "default": false,
          "title": "Mandatory",
          "type": "boolean"
        },
        "plan_evidence_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/PlanEvidenceRef"
          },
          "title": "Plan Evidence Refs",
          "type": "array"
        },
        "target_chapters": {
          "items": {
            "type": "integer"
          },
          "minItems": 1,
          "title": "Target Chapters",
          "type": "array"
        },
        "target_components": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Target Components",
          "type": "array"
        },
        "weight": {
          "default": 1.0,
          "exclusiveMinimum": 0,
          "title": "Weight",
          "type": "number"
        },
        "why_needed": {
          "default": "required by the benchmark annotation",
          "title": "Why Needed",
          "type": "string"
        }
      },
      "required": [
        "gold_id",
        "kind",
        "description",
        "target_chapters",
        "future_evidence_refs"
      ],
      "title": "GoldItem",
      "type": "object"
    },
    "GoldKind": {
      "enum": [
        "observed_use",
        "operational_constraint",
        "plan_obligation"
      ],
      "title": "GoldKind",
      "type": "string"
    },
    "GoldNeedSpec": {
      "additionalProperties": false,
      "description": "Evaluator-side specification of the needs a Gold conclusion requires.\n\nNeed Recall is computed deterministically against these components\n(scope / entity labels / facet kinds), never by another LLM judgment.",
      "properties": {
        "blindness": {
          "$ref": "#/$defs/GoldBlindness",
          "default": "blind_recoverable"
        },
        "gold_id": {
          "$ref": "#/$defs/StableId"
        },
        "required_entities": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Required Entities",
          "type": "array"
        },
        "required_facets": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Required Facets",
          "type": "array"
        },
        "required_need_scopes": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Required Need Scopes",
          "type": "array"
        }
      },
      "required": [
        "gold_id"
      ],
      "title": "GoldNeedSpec",
      "type": "object"
    },
    "GoldType": {
      "enum": [
        "CURRENT_STATE",
        "RELATIONSHIP_EMOTION",
        "CAUSAL_HISTORY",
        "KNOWLEDGE_BOUNDARY",
        "PLAN_OBLIGATION",
        "LONG_RANGE_CALLBACK",
        "OBJECT_CONTINUITY"
      ],
      "title": "GoldType",
      "type": "string"
    },
    "HistoryAccessPolicy": {
      "enum": [
        "history_only"
      ],
      "title": "HistoryAccessPolicy",
      "type": "string"
    },
    "JsonValue": {},
    "NarrativeOrder": {
      "additionalProperties": false,
      "properties": {
        "block_index": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Block Index"
        },
        "chapter_index": {
          "minimum": 0,
          "title": "Chapter Index",
          "type": "integer"
        },
        "scene_index": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scene Index"
        }
      },
      "required": [
        "chapter_index"
      ],
      "title": "NarrativeOrder",
      "type": "object"
    },
    "ObligationKind": {
      "enum": [
        "foreshadowing",
        "promise",
        "objective",
        "unresolved_conflict"
      ],
      "title": "ObligationKind",
      "type": "string"
    },
    "ObligationStatus": {
      "enum": [
        "open",
        "progressed",
        "resolved",
        "abandoned"
      ],
