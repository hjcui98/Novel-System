{
  "$defs": {
    "ArtifactId": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "ArtifactId",
      "type": "string"
    },
    "BenchmarkInformationProfile": {
      "enum": [
        "visible_at_cutoff",
        "author_plan_conditioned"
      ],
      "title": "BenchmarkInformationProfile",
      "type": "string"
    },
    "CommitId": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "CommitId",
      "type": "string"
    },
    "EvidenceRef": {
      "additionalProperties": false,
      "properties": {
        "chapter_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/StableId"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "evidence_id": {
          "$ref": "#/$defs/StableId"
        },
        "object_hash": {
          "$ref": "#/$defs/ArtifactId"
        },
        "quote_hash": {
          "anyOf": [
            {
              "$ref": "#/$defs/QuoteHash"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "resolved_at_commit": {
          "$ref": "#/$defs/CommitId"
        },
        "root_hash": {
          "$ref": "#/$defs/ArtifactId"
        },
        "scene_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/StableId"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "span": {
          "anyOf": [
            {
              "$ref": "#/$defs/TextSpanRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "support_status": {
          "$ref": "#/$defs/EvidenceSupportStatus"
        }
      },
      "required": [
        "evidence_id",
        "root_hash",
        "object_hash",
        "support_status",
        "resolved_at_commit"
      ],
      "title": "EvidenceRef",
      "type": "object"
    },
    "EvidenceSet": {
      "additionalProperties": false,
      "description": "One accepted, conjunctive evidence alternative for a Gold item.",
      "properties": {
        "component_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Component Ids",
          "type": "array"
        },
        "evidence_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "evidence_set_id": {
          "$ref": "#/$defs/StableId"
        },
        "plan_node_ids": {
          "default": [],
          "items": {
            "$ref": "#/$defs/StableId"
          },
          "title": "Plan Node Ids",
          "type": "array"
        }
      },
      "required": [
        "evidence_set_id"
      ],
      "title": "EvidenceSet",
      "type": "object"
    },
    "EvidenceSupportStatus": {
      "enum": [
        "current_support",
        "historical_support",
        "superseded_support",
        "orphaned",
        "contradicted"
      ],
      "title": "EvidenceSupportStatus",
      "type": "string"
    },
    "GoldKind": {
      "enum": [
        "observed_use",
        "operational_constraint",
        "plan_obligation"
      ],
      "title": "GoldKind",
      "type": "string"
    },
    "GoldType": {
      "enum": [
        "CURRENT_STATE",
        "RELATIONSHIP_EMOTION",
        "CAUSAL_HISTORY",
        "KNOWLEDGE_BOUNDARY",
        "PLAN_OBLIGATION",
        "LONG_RANGE_CALLBACK",
        "OBJECT_CONTINUITY"
      ],
      "title": "GoldType",
      "type": "string"
    },
    "PlanEvidenceRef": {
      "additionalProperties": false,
      "description": "Immutable pointer to author-visible intent without promoting it to World fact.",
      "properties": {
        "evidence_id": {
          "$ref": "#/$defs/StableId"
        },
        "goal_id": {
          "$ref": "#/$defs/StableId"
        },
        "object_hash": {
          "$ref": "#/$defs/ArtifactId"
        },
        "plan_root_hash": {
          "$ref": "#/$defs/ArtifactId"
        }
      },
      "required": [
        "evidence_id",
        "plan_root_hash",
        "goal_id",
        "object_hash"
      ],
      "title": "PlanEvidenceRef",
      "type": "object"
    },
    "QuoteHash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "QuoteHash",
      "type": "string"
    },
    "RangeUnit": {
      "enum": [
        "unicode_codepoint"
      ],
      "title": "RangeUnit",
      "type": "string"
    },
    "StableId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "StableId",
      "type": "string"
    },
    "TextSpanRef": {
      "additionalProperties": false,
      "properties": {
        "block_id": {
          "$ref": "#/$defs/StableId"
        },
        "end": {
          "minimum": 0,
          "title": "End",
          "type": "integer"
        },
        "range_unit": {
          "$ref": "#/$defs/RangeUnit",
          "default": "unicode_codepoint"
        },
        "start": {
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        }
      },
      "required": [
        "block_id",
        "start",
        "end"
      ],
      "title": "TextSpanRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "accepted_evidence_sets": {
      "default": [],
      "items": {
        "$ref": "#/$defs/EvidenceSet"
      },
      "title": "Accepted Evidence Sets",
      "type": "array"
    },
    "applicable_profiles": {
      "default": [
        "visible_at_cutoff",
        "author_plan_conditioned"
      ],
      "items": {
        "$ref": "#/$defs/BenchmarkInformationProfile"
      },
      "title": "Applicable Profiles",
      "type": "array"
    },
    "description": {
      "minLength": 1,
      "title": "Description",
      "type": "string"
    },
    "evidence_refs": {
      "default": [],
      "items": {
        "$ref": "#/$defs/EvidenceRef"
      },
      "title": "Evidence Refs",
      "type": "array"
    },
    "fact": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Fact"
    },
    "future_evidence_refs": {
      "items": {
        "$ref": "#/$defs/EvidenceRef"
      },
      "minItems": 1,
      "title": "Future Evidence Refs",
      "type": "array"
    },
    "gold_id": {
      "$ref": "#/$defs/StableId"
    },
    "gold_type": {
      "anyOf": [
        {
          "$ref": "#/$defs/GoldType"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "kind": {
      "$ref": "#/$defs/GoldKind"
    },
    "mandatory": {
      "default": false,
      "title": "Mandatory",
      "type": "boolean"
    },
    "plan_evidence_refs": {
      "default": [],
      "items": {
        "$ref": "#/$defs/PlanEvidenceRef"
      },
      "title": "Plan Evidence Refs",
      "type": "array"
    },
    "target_chapters": {
      "items": {
        "type": "integer"
      },
      "minItems": 1,
      "title": "Target Chapters",
      "type": "array"
    },
    "target_components": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Target Components",
      "type": "array"
    },
    "weight": {
      "default": 1.0,
      "exclusiveMinimum": 0,
      "title": "Weight",
      "type": "number"
    },
    "why_needed": {
      "default": "required by the benchmark annotation",
      "title": "Why Needed",
      "type": "string"
    }
  },
  "required": [
    "gold_id",
    "kind",
    "description",
    "target_chapters",
    "future_evidence_refs"
  ],
  "title": "GoldItem",
  "type": "object"
}
