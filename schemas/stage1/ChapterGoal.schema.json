{
  "$defs": {
    "StableId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "StableId",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "acceptance_criteria": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Acceptance Criteria",
      "type": "array"
    },
    "chapter_index": {
      "minimum": 1,
      "title": "Chapter Index",
      "type": "integer"
    },
    "dependency_ids": {
      "default": [],
      "items": {
        "$ref": "#/$defs/StableId"
      },
      "title": "Dependency Ids",
      "type": "array"
    },
    "forbidden_outcomes": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Forbidden Outcomes",
      "type": "array"
    },
    "goal_id": {
      "$ref": "#/$defs/StableId"
    },
    "invariants": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Invariants",
      "type": "array"
    },
    "obligation_ids": {
      "default": [],
      "items": {
        "$ref": "#/$defs/StableId"
      },
      "title": "Obligation Ids",
      "type": "array"
    },
    "preconditions": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Preconditions",
      "type": "array"
    },
    "required_outcomes": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Required Outcomes",
      "type": "array"
    },
    "summary": {
      "minLength": 1,
      "title": "Summary",
      "type": "string"
    }
  },
  "required": [
    "goal_id",
    "chapter_index",
    "summary"
  ],
  "title": "ChapterGoal",
  "type": "object"
}
