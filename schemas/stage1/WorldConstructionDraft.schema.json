{
  "$defs": {
    "ArtifactId": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "ArtifactId",
      "type": "string"
    },
    "CommitId": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "CommitId",
      "type": "string"
    },
    "Entity": {
      "additionalProperties": false,
      "properties": {
        "aliases": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Aliases",
          "type": "array"
        },
        "entity_id": {
          "$ref": "#/$defs/StableId"
        },
        "entity_type": {
          "minLength": 1,
          "title": "Entity Type",
          "type": "string"
        },
        "identity_invariants": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Identity Invariants",
          "type": "array"
        },
        "internal_label": {
          "minLength": 1,
          "title": "Internal Label",
          "type": "string"
        }
      },
      "required": [
        "entity_id",
        "entity_type",
        "internal_label"
      ],
      "title": "Entity",
      "type": "object"
    },
    "Event": {
      "additionalProperties": false,
      "properties": {
        "effect_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/StableId"
          },
          "title": "Effect Refs",
          "type": "array"
        },
        "event_id": {
          "$ref": "#/$defs/StableId"
        },
        "event_type": {
          "minLength": 1,
          "title": "Event Type",
          "type": "string"
        },
        "evidence_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "narrative_order": {
          "anyOf": [
            {
              "$ref": "#/$defs/NarrativeOrder"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "participant_ids": {
          "default": [],
          "items": {
            "$ref": "#/$defs/StableId"
          },
          "title": "Participant Ids",
          "type": "array"
        },
        "story_time": {
          "anyOf": [
            {
              "$ref": "#/$defs/StoryTime"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "truth_class": {
          "$ref": "#/$defs/TruthClass"
        }
      },
      "required": [
        "event_id",
        "event_type",
        "truth_class"
      ],
      "title": "Event",
      "type": "object"
    },
    "EvidenceRef": {
      "additionalProperties": false,
      "properties": {
        "chapter_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/StableId"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "evidence_id": {
          "$ref": "#/$defs/StableId"
        },
        "object_hash": {
          "$ref": "#/$defs/ArtifactId"
        },
        "quote_hash": {
          "anyOf": [
            {
              "$ref": "#/$defs/QuoteHash"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "resolved_at_commit": {
          "$ref": "#/$defs/CommitId"
        },
        "root_hash": {
          "$ref": "#/$defs/ArtifactId"
        },
        "scene_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/StableId"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "span": {
          "anyOf": [
            {
              "$ref": "#/$defs/TextSpanRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "support_status": {
          "$ref": "#/$defs/EvidenceSupportStatus"
        }
      },
      "required": [
        "evidence_id",
        "root_hash",
        "object_hash",
        "support_status",
        "resolved_at_commit"
      ],
      "title": "EvidenceRef",
      "type": "object"
    },
    "EvidenceSupportStatus": {
      "enum": [
        "current_support",
        "historical_support",
        "superseded_support",
        "orphaned",
        "contradicted"
      ],
      "title": "EvidenceSupportStatus",
      "type": "string"
    },
    "JsonValue": {},
    "NarrativeOrder": {
      "additionalProperties": false,
      "properties": {
        "block_index": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Block Index"
        },
        "chapter_index": {
          "minimum": 0,
          "title": "Chapter Index",
          "type": "integer"
        },
        "scene_index": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scene Index"
        }
      },
      "required": [
        "chapter_index"
      ],
      "title": "NarrativeOrder",
      "type": "object"
    },
    "ObligationKind": {
      "enum": [
        "foreshadowing",
        "promise",
        "objective",
        "unresolved_conflict"
      ],
      "title": "ObligationKind",
      "type": "string"
    },
    "ObligationStatus": {
      "enum": [
        "open",
        "progressed",
        "resolved",
        "abandoned"
      ],
      "title": "ObligationStatus",
      "type": "string"
    },
    "PlanObligation": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "due_chapter": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Due Chapter"
        },
        "evidence_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "kind": {
          "$ref": "#/$defs/ObligationKind"
        },
        "obligation_id": {
          "$ref": "#/$defs/StableId"
        },
        "owner_ids": {
          "default": [],
          "items": {
            "$ref": "#/$defs/StableId"
          },
          "title": "Owner Ids",
          "type": "array"
        },
        "status": {
          "$ref": "#/$defs/ObligationStatus"
        }
      },
      "required": [
        "obligation_id",
        "kind",
        "description",
        "status"
      ],
      "title": "PlanObligation",
      "type": "object"
    },
    "QuoteHash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "QuoteHash",
      "type": "string"
    },
    "RangeUnit": {
      "enum": [
        "unicode_codepoint"
      ],
      "title": "RangeUnit",
      "type": "string"
    },
    "RelationRecord": {
      "additionalProperties": false,
      "properties": {
        "evidence_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "object_id": {
          "$ref": "#/$defs/StableId"
        },
        "predicate": {
          "minLength": 1,
          "title": "Predicate",
          "type": "string"
        },
        "relation_id": {
          "$ref": "#/$defs/StableId"
        },
        "subject_id": {
          "$ref": "#/$defs/StableId"
        },
        "truth_class": {
          "$ref": "#/$defs/TruthClass"
        },
        "valid_time": {
          "$ref": "#/$defs/StoryTime"
        }
      },
      "required": [
        "relation_id",
        "predicate",
        "subject_id",
        "object_id",
        "valid_time",
        "truth_class"
      ],
      "title": "RelationRecord",
      "type": "object"
    },
    "StableId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "StableId",
      "type": "string"
    },
    "StateRecord": {
      "additionalProperties": false,
      "properties": {
        "evidence_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "predicate": {
          "minLength": 1,
          "title": "Predicate",
          "type": "string"
        },
        "state_id": {
          "$ref": "#/$defs/StableId"
        },
        "subject_id": {
          "$ref": "#/$defs/StableId"
        },
        "truth_class": {
          "$ref": "#/$defs/TruthClass"
        },
        "valid_time": {
          "$ref": "#/$defs/StoryTime"
        },
        "value": {
          "$ref": "#/$defs/JsonValue"
        }
      },
      "required": [
        "state_id",
        "subject_id",
        "predicate",
        "value",
        "valid_time",
        "truth_class"
      ],
      "title": "StateRecord",
      "type": "object"
    },
    "StoryTime": {
      "additionalProperties": false,
      "properties": {
        "end_ordinal": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Ordinal"
        },
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"
        },
        "start_ordinal": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start Ordinal"
        },
        "worldline": {
          "minLength": 1,
          "title": "Worldline",
          "type": "string"
        }
      },
      "required": [
        "worldline"
      ],
      "title": "StoryTime",
      "type": "object"
    },
    "TextSpanRef": {
      "additionalProperties": false,
      "properties": {
        "block_id": {
          "$ref": "#/$defs/StableId"
        },
        "end": {
          "minimum": 0,
          "title": "End",
          "type": "integer"
        },
        "range_unit": {
          "$ref": "#/$defs/RangeUnit",
          "default": "unicode_codepoint"
        },
        "start": {
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        }
      },
      "required": [
        "block_id",
        "start",
        "end"
      ],
      "title": "TextSpanRef",
      "type": "object"
    },
    "TruthClass": {
      "enum": [
        "accepted_world_fact",
        "assertion",
        "rumor",
        "dream",
        "prediction",
        "hypothetical",
        "unknown",
        "contested",
        "disproved",
        "retconned",
        "not_applicable"
      ],
      "title": "TruthClass",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "entities": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Entity"
      },
      "title": "Entities",
      "type": "array"
    },
    "events": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Event"
      },
      "title": "Events",
      "type": "array"
    },
    "obligations": {
      "default": [],
      "items": {
        "$ref": "#/$defs/PlanObligation"
      },
      "title": "Obligations",
      "type": "array"
    },
    "relations": {
      "default": [],
      "items": {
        "$ref": "#/$defs/RelationRecord"
      },
      "title": "Relations",
      "type": "array"
    },
    "states": {
      "default": [],
      "items": {
        "$ref": "#/$defs/StateRecord"
      },
      "title": "States",
      "type": "array"
    }
  },
  "title": "WorldConstructionDraft",
  "type": "object"
}
