{
  "$defs": {
    "ArtifactId": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "ArtifactId",
      "type": "string"
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/ArtifactId"
        },
        "byte_length": {
          "minimum": 0,
          "title": "Byte Length",
          "type": "integer"
        },
        "media_type": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "schema_version": {
          "$ref": "#/$defs/SchemaVersion"
        }
      },
      "required": [
        "artifact_id",
        "media_type",
        "byte_length",
        "schema_version"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "ChangeOperation": {
      "additionalProperties": false,
      "properties": {
        "evidence_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "operation": {
          "$ref": "#/$defs/ChangeOperationType"
        },
        "operation_id": {
          "$ref": "#/$defs/StableId"
        },
        "payload": {
          "$ref": "#/$defs/JsonValue"
        },
        "root_kind": {
          "$ref": "#/$defs/RootKind"
        },
        "target_id": {
          "$ref": "#/$defs/StableId"
        }
      },
      "required": [
        "operation_id",
        "root_kind",
        "operation",
        "target_id",
        "payload"
      ],
      "title": "ChangeOperation",
      "type": "object"
    },
    "ChangeOperationType": {
      "enum": [
        "create",
        "replace",
        "retire"
      ],
      "title": "ChangeOperationType",
      "type": "string"
    },
    "CommitId": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "CommitId",
      "type": "string"
    },
    "EvidenceRef": {
      "additionalProperties": false,
      "properties": {
        "chapter_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/StableId"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "evidence_id": {
          "$ref": "#/$defs/StableId"
        },
        "object_hash": {
          "$ref": "#/$defs/ArtifactId"
        },
        "quote_hash": {
          "anyOf": [
            {
              "$ref": "#/$defs/QuoteHash"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "resolved_at_commit": {
          "$ref": "#/$defs/CommitId"
        },
        "root_hash": {
          "$ref": "#/$defs/ArtifactId"
        },
        "scene_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/StableId"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "span": {
          "anyOf": [
            {
              "$ref": "#/$defs/TextSpanRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "support_status": {
          "$ref": "#/$defs/EvidenceSupportStatus"
        }
      },
      "required": [
        "evidence_id",
        "root_hash",
        "object_hash",
        "support_status",
        "resolved_at_commit"
      ],
      "title": "EvidenceRef",
      "type": "object"
    },
    "EvidenceSupportStatus": {
      "enum": [
        "current_support",
        "historical_support",
        "superseded_support",
        "orphaned",
        "contradicted"
      ],
      "title": "EvidenceSupportStatus",
      "type": "string"
    },
    "FreshnessDecision": {
      "additionalProperties": false,
      "properties": {
        "actual_alias_commit": {
          "anyOf": [
            {
              "$ref": "#/$defs/CommitId"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "actual_snapshot_commit": {
          "anyOf": [
            {
              "$ref": "#/$defs/CommitId"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "actual_snapshot_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/StableId"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "canonical_commit": {
          "$ref": "#/$defs/CommitId"
        },
        "manual_approval_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/StableId"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "r1_basis_commit": {
          "$ref": "#/$defs/CommitId"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "required_snapshot_id": {
          "$ref": "#/$defs/StableId"
        },
        "status": {
          "$ref": "#/$defs/FreshnessStatus"
        }
      },
      "required": [
        "status",
        "canonical_commit",
        "r1_basis_commit",
        "required_snapshot_id",
        "reason"
      ],
      "title": "FreshnessDecision",
      "type": "object"
    },
    "FreshnessStatus": {
      "enum": [
        "ready",
        "waiting",
        "degraded",
        "blocked",
        "overridden"
      ],
      "title": "FreshnessStatus",
      "type": "string"
    },
    "JsonValue": {},
    "ModelCallPurpose": {
      "enum": [
        "development",
        "batch_test",
        "evaluation"
      ],
      "title": "ModelCallPurpose",
      "type": "string"
    },
    "ModelCallRecord": {
      "additionalProperties": false,
      "properties": {
        "completed_at": {
          "format": "date-time",
          "title": "Completed At",
          "type": "string"
        },
        "endpoint": {
          "minLength": 1,
          "title": "Endpoint",
          "type": "string"
        },
        "latency_ms": {
          "minimum": 0,
          "title": "Latency Ms",
          "type": "integer"
        },
        "model": {
          "minLength": 1,
          "title": "Model",
          "type": "string"
        },
        "model_role": {
          "$ref": "#/$defs/ModelRole"
        },
        "model_version": {
          "minLength": 1,
          "title": "Model Version",
          "type": "string"
        },
        "purpose": {
          "$ref": "#/$defs/ModelCallPurpose"
        },
        "request_id": {
          "$ref": "#/$defs/StableId"
        },
        "run_id": {
          "$ref": "#/$defs/RunId"
        },
        "span_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Span Id"
        },
        "started_at": {
          "format": "date-time",
          "title": "Started At",
          "type": "string"
        },
        "task_id": {
          "$ref": "#/$defs/TaskId"
        },
        "trace_id": {
          "minLength": 1,
          "title": "Trace Id",
          "type": "string"
        },
        "usage": {
          "$ref": "#/$defs/ModelUsage"
        }
      },
      "required": [
        "request_id",
        "run_id",
        "task_id",
        "model_role",
        "purpose",
        "trace_id",
        "endpoint",
        "model",
        "model_version",
        "usage",
        "latency_ms",
        "started_at",
        "completed_at"
      ],
      "title": "ModelCallRecord",
      "type": "object"
    },
    "ModelRole": {
      "enum": [
        "implementation_model",
        "batch_test_model"
      ],
      "title": "ModelRole",
      "type": "string"
    },
    "ModelUsage": {
      "additionalProperties": false,
      "properties": {
        "cost_usd": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Cost Usd"
        },
        "input_tokens": {
          "minimum": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "output_tokens": {
          "minimum": 0,
          "title": "Output Tokens",
          "type": "integer"
        }
      },
      "required": [
        "input_tokens",
        "output_tokens",
        "cost_usd"
      ],
      "title": "ModelUsage",
      "type": "object"
    },
    "ObservedChangeSet": {
      "additionalProperties": false,
      "properties": {
        "base_commit": {
          "$ref": "#/$defs/CommitId"
        },
        "change_set_id": {
          "$ref": "#/$defs/StableId"
        },
        "operations": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ChangeOperation"
          },
          "title": "Operations",
          "type": "array"
        },
        "source_artifact": {
          "$ref": "#/$defs/ArtifactRef"
        }
      },
      "required": [
        "change_set_id",
        "base_commit",
        "source_artifact"
      ],
      "title": "ObservedChangeSet",
      "type": "object"
    },
    "ProjectId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "ProjectId",
      "type": "string"
    },
    "QuoteHash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "QuoteHash",
      "type": "string"
    },
    "RangeUnit": {
      "enum": [
        "unicode_codepoint"
      ],
      "title": "RangeUnit",
      "type": "string"
    },
    "ReplayChapterResult": {
      "additionalProperties": false,
      "properties": {
        "base_commit": {
          "$ref": "#/$defs/CommitId"
        },
        "chapter_index": {
          "minimum": 1,
          "title": "Chapter Index",
          "type": "integer"
        },
        "commit_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/CommitId"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "freshness": {
          "anyOf": [
            {
              "$ref": "#/$defs/FreshnessDecision"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "manual_repair": {
          "default": false,
          "title": "Manual Repair",
          "type": "boolean"
        },
        "materialized_records": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ReplayMaterializedRecord"
          },
          "title": "Materialized Records",
          "type": "array"
        },
        "observed_changes": {
          "$ref": "#/$defs/ObservedChangeSet"
        },
        "snapshot_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/StableId"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "status": {
          "$ref": "#/$defs/ReplayChapterStatus"
        },
        "validation_report": {
          "$ref": "#/$defs/ValidationReport"
        }
      },
      "required": [
        "chapter_index",
        "base_commit",
        "status",
        "validation_report",
        "observed_changes"
      ],
      "title": "ReplayChapterResult",
      "type": "object"
    },
    "ReplayChapterStatus": {
      "enum": [
        "committed",
        "blocked_by_validation",
        "blocked_by_freshness"
      ],
      "title": "ReplayChapterStatus",
      "type": "string"
    },
    "ReplayMaterializedRecord": {
      "additionalProperties": false,
      "properties": {
        "record": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Record",
          "type": "object"
        },
        "record_kind": {
          "$ref": "#/$defs/WorldRecordKind"
        },
        "target_id": {
          "$ref": "#/$defs/StableId"
        }
      },
      "required": [
        "record_kind",
        "target_id",
        "record"
      ],
      "title": "ReplayMaterializedRecord",
      "type": "object"
    },
    "RootKind": {
      "enum": [
        "text",
        "plan",
        "world",
        "reference",
        "project_profile"
      ],
      "title": "RootKind",
      "type": "string"
    },
    "RunId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "RunId",
      "type": "string"
    },
    "SchemaVersion": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "title": "SchemaVersion",
      "type": "string"
    },
    "StableId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "StableId",
      "type": "string"
    },
    "TaskId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "TaskId",
      "type": "string"
    },
    "TextSpanRef": {
      "additionalProperties": false,
      "properties": {
        "block_id": {
          "$ref": "#/$defs/StableId"
        },
        "end": {
          "minimum": 0,
          "title": "End",
          "type": "integer"
        },
        "range_unit": {
          "$ref": "#/$defs/RangeUnit",
          "default": "unicode_codepoint"
        },
        "start": {
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        }
      },
      "required": [
        "block_id",
        "start",
        "end"
      ],
      "title": "TextSpanRef",
      "type": "object"
    },
    "ValidationFinding": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "evidence_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "severity": {
          "minLength": 1,
          "title": "Severity",
          "type": "string"
        }
      },
      "required": [
        "code",
        "severity",
        "message"
      ],
      "title": "ValidationFinding",
      "type": "object"
    },
    "ValidationReport": {
      "additionalProperties": false,
      "properties": {
        "bundle_id": {
          "$ref": "#/$defs/StableId"
        },
        "findings": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ValidationFinding"
          },
          "title": "Findings",
          "type": "array"
        },
        "report_id": {
          "$ref": "#/$defs/StableId"
        },
        "schema_version": {
          "$ref": "#/$defs/SchemaVersion"
        },
        "status": {
          "$ref": "#/$defs/ValidationStatus"
        },
        "validated_at": {
          "format": "date-time",
          "title": "Validated At",
          "type": "string"
        },
        "validation_profile": {
          "default": "stage1-validator-v1",
          "minLength": 1,
          "title": "Validation Profile",
          "type": "string"
        }
      },
      "required": [
        "report_id",
        "bundle_id",
        "status",
        "schema_version",
        "validated_at"
      ],
      "title": "ValidationReport",
      "type": "object"
    },
    "ValidationStatus": {
      "enum": [
        "passed",
        "failed",
        "needs_review"
      ],
      "title": "ValidationStatus",
      "type": "string"
    },
    "WorldRecordKind": {
      "enum": [
        "entity",
        "event",
        "state",
        "relation",
        "obligation"
      ],
      "title": "WorldRecordKind",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "blocked_chapters": {
      "minimum": 0,
      "title": "Blocked Chapters",
      "type": "integer"
    },
    "chapter_results": {
      "items": {
        "$ref": "#/$defs/ReplayChapterResult"
      },
      "title": "Chapter Results",
      "type": "array"
    },
    "committed_chapters": {
      "minimum": 0,
      "title": "Committed Chapters",
      "type": "integer"
    },
    "first_pollution_chapter": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "First Pollution Chapter"
    },
    "model_calls": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ModelCallRecord"
      },
      "title": "Model Calls",
      "type": "array"
    },
    "project_id": {
      "$ref": "#/$defs/ProjectId"
    },
    "replay_id": {
      "$ref": "#/$defs/StableId"
    },
    "silent_canonical_pollution_count": {
      "minimum": 0,
      "title": "Silent Canonical Pollution Count",
      "type": "integer"
    },
    "silent_stale_snapshot_reads": {
      "minimum": 0,
      "title": "Silent Stale Snapshot Reads",
      "type": "integer"
    }
  },
  "required": [
    "replay_id",
    "project_id",
    "chapter_results",
    "committed_chapters",
    "blocked_chapters",
    "silent_canonical_pollution_count",
    "silent_stale_snapshot_reads"
  ],
  "title": "ContinuousReplayResult",
  "type": "object"
}
