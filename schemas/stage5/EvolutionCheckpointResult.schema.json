{
  "$defs": {
    "ArtifactId": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "ArtifactId",
      "type": "string"
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/ArtifactId"
        },
        "byte_length": {
          "minimum": 0,
          "title": "Byte Length",
          "type": "integer"
        },
        "media_type": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "schema_version": {
          "$ref": "#/$defs/SchemaVersion"
        }
      },
      "required": [
        "artifact_id",
        "media_type",
        "byte_length",
        "schema_version"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "CommitId": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "CommitId",
      "type": "string"
    },
    "EvolutionCheckpointUse": {
      "enum": [
        "calibration",
        "sealed_acceptance",
        "canary"
      ],
      "title": "EvolutionCheckpointUse",
      "type": "string"
    },
    "EvolutionMetricComparison": {
      "additionalProperties": false,
      "properties": {
        "baseline_value": {
          "title": "Baseline Value",
          "type": "number"
        },
        "candidate_value": {
          "title": "Candidate Value",
          "type": "number"
        },
        "metric": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Metric",
          "type": "string"
        }
      },
      "required": [
        "metric",
        "baseline_value",
        "candidate_value"
      ],
      "title": "EvolutionMetricComparison",
      "type": "object"
    },
    "SchemaVersion": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "title": "SchemaVersion",
      "type": "string"
    },
    "StableId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "StableId",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "basis_commit": {
      "$ref": "#/$defs/CommitId"
    },
    "candidate_artifact_id": {
      "$ref": "#/$defs/ArtifactId"
    },
    "checkpoint_id": {
      "$ref": "#/$defs/StableId"
    },
    "comparisons": {
      "items": {
        "$ref": "#/$defs/EvolutionMetricComparison"
      },
      "maxItems": 32,
      "minItems": 1,
      "title": "Comparisons",
      "type": "array"
    },
    "evidence_refs": {
      "items": {
        "$ref": "#/$defs/ArtifactRef"
      },
      "maxItems": 64,
      "minItems": 1,
      "title": "Evidence Refs",
      "type": "array"
    },
    "hard_failure_codes": {
      "default": [],
      "items": {
        "type": "string"
      },
      "maxItems": 32,
      "title": "Hard Failure Codes",
      "type": "array"
    },
    "use": {
      "$ref": "#/$defs/EvolutionCheckpointUse"
    }
  },
  "required": [
    "checkpoint_id",
    "use",
    "basis_commit",
    "candidate_artifact_id",
    "comparisons",
    "evidence_refs"
  ],
  "title": "EvolutionCheckpointResult",
  "type": "object"
}
