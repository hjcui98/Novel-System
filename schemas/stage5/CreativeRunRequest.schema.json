{
  "$defs": {
    "ArtifactId": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "ArtifactId",
      "type": "string"
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/ArtifactId"
        },
        "byte_length": {
          "minimum": 0,
          "title": "Byte Length",
          "type": "integer"
        },
        "media_type": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "schema_version": {
          "$ref": "#/$defs/SchemaVersion"
        }
      },
      "required": [
        "artifact_id",
        "media_type",
        "byte_length",
        "schema_version"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "AutomationMode": {
      "enum": [
        "manual",
        "semi",
        "auto"
      ],
      "title": "AutomationMode",
      "type": "string"
    },
    "CommitId": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "CommitId",
      "type": "string"
    },
    "CreativeRunPolicy": {
      "additionalProperties": false,
      "properties": {
        "auto_accept_draft": {
          "default": false,
          "title": "Auto Accept Draft",
          "type": "boolean"
        },
        "auto_accept_plan": {
          "default": false,
          "title": "Auto Accept Plan",
          "type": "boolean"
        },
        "automation_mode": {
          "$ref": "#/$defs/AutomationMode"
        },
        "enable_planner_lookahead": {
          "default": false,
          "title": "Enable Planner Lookahead",
          "type": "boolean"
        },
        "lookahead_horizon": {
          "default": 3,
          "minimum": 1,
          "title": "Lookahead Horizon",
          "type": "integer"
        },
        "max_task_attempts": {
          "default": 3,
          "minimum": 1,
          "title": "Max Task Attempts",
          "type": "integer"
        },
        "max_tasks_per_advance": {
          "default": 1,
          "minimum": 1,
          "title": "Max Tasks Per Advance",
          "type": "integer"
        },
        "permission_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Permission Hash",
          "type": "string"
        },
        "planning_horizon": {
          "default": 5,
          "minimum": 1,
          "title": "Planning Horizon",
          "type": "integer"
        },
        "policy_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Policy Hash",
          "type": "string"
        },
        "runtime_parallelism": {
          "default": 1,
          "enum": [
            1,
            2
          ],
          "title": "Runtime Parallelism",
          "type": "integer"
        }
      },
      "required": [
        "automation_mode",
        "policy_hash",
        "permission_hash"
      ],
      "title": "CreativeRunPolicy",
      "type": "object"
    },
    "ProjectId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "ProjectId",
      "type": "string"
    },
    "RunId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "RunId",
      "type": "string"
    },
    "SchemaVersion": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "title": "SchemaVersion",
      "type": "string"
    },
    "StableId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "StableId",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "basis_commit": {
      "$ref": "#/$defs/CommitId"
    },
    "basis_snapshot": {
      "anyOf": [
        {
          "$ref": "#/$defs/StableId"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "continuation_artifact_refs": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ArtifactRef"
      },
      "title": "Continuation Artifact Refs",
      "type": "array"
    },
    "current_chapter": {
      "default": 0,
      "maximum": 9999,
      "minimum": 0,
      "title": "Current Chapter",
      "type": "integer"
    },
    "input_artifact_refs": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ArtifactRef"
      },
      "title": "Input Artifact Refs",
      "type": "array"
    },
    "policy": {
      "$ref": "#/$defs/CreativeRunPolicy"
    },
    "project_id": {
      "$ref": "#/$defs/ProjectId"
    },
    "run_id": {
      "$ref": "#/$defs/RunId"
    },
    "target_chapters": {
      "default": 1,
      "maximum": 10000,
      "minimum": 1,
      "title": "Target Chapters",
      "type": "integer"
    }
  },
  "required": [
    "run_id",
    "project_id",
    "basis_commit",
    "policy"
  ],
  "title": "CreativeRunRequest",
  "type": "object"
}
