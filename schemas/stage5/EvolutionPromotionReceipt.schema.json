{
  "$defs": {
    "ArtifactId": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "ArtifactId",
      "type": "string"
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/ArtifactId"
        },
        "byte_length": {
          "minimum": 0,
          "title": "Byte Length",
          "type": "integer"
        },
        "media_type": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "schema_version": {
          "$ref": "#/$defs/SchemaVersion"
        }
      },
      "required": [
        "artifact_id",
        "media_type",
        "byte_length",
        "schema_version"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "EvolutionTargetKind": {
      "enum": [
        "prompt",
        "skill",
        "policy",
        "code"
      ],
      "title": "EvolutionTargetKind",
      "type": "string"
    },
    "SchemaVersion": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "title": "SchemaVersion",
      "type": "string"
    },
    "StableId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "StableId",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "campaign_id": {
      "$ref": "#/$defs/StableId"
    },
    "campaign_result_ref": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "decision": {
      "const": "promote",
      "default": "promote",
      "title": "Decision",
      "type": "string"
    },
    "previous_active_ref": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "production_hot_swap": {
      "const": false,
      "default": false,
      "title": "Production Hot Swap",
      "type": "boolean"
    },
    "promoted_at": {
      "format": "date-time",
      "title": "Promoted At",
      "type": "string"
    },
    "promoted_ref": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "receipt_id": {
      "$ref": "#/$defs/StableId"
    },
    "target_id": {
      "$ref": "#/$defs/StableId"
    },
    "target_kind": {
      "$ref": "#/$defs/EvolutionTargetKind"
    }
  },
  "required": [
    "receipt_id",
    "campaign_id",
    "target_id",
    "target_kind",
    "previous_active_ref",
    "promoted_ref",
    "campaign_result_ref",
    "promoted_at"
  ],
  "title": "EvolutionPromotionReceipt",
  "type": "object"
}
