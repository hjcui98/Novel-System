{
  "$defs": {
    "StableId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "StableId",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "action": {
      "maxLength": 64,
      "minLength": 1,
      "title": "Action",
      "type": "string"
    },
    "actor_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Actor Id",
      "type": "string"
    },
    "additional_attempts": {
      "default": 0,
      "minimum": 0,
      "title": "Additional Attempts",
      "type": "integer"
    },
    "additional_planner_memory_tranches": {
      "default": 0,
      "minimum": 0,
      "title": "Additional Planner Memory Tranches",
      "type": "integer"
    },
    "command_id": {
      "$ref": "#/$defs/StableId"
    },
    "reason": {
      "maxLength": 512,
      "minLength": 1,
      "title": "Reason",
      "type": "string"
    },
    "writer_generation_after": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Writer Generation After"
    }
  },
  "required": [
    "command_id",
    "action",
    "actor_id",
    "reason"
  ],
  "title": "ControlIntentPayload",
  "type": "object"
}
