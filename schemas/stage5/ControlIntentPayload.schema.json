{
  "$defs": {
    "ArtifactId": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "ArtifactId",
      "type": "string"
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/ArtifactId"
        },
        "byte_length": {
          "minimum": 0,
          "title": "Byte Length",
          "type": "integer"
        },
        "media_type": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "schema_version": {
          "$ref": "#/$defs/SchemaVersion"
        }
      },
      "required": [
        "artifact_id",
        "media_type",
        "byte_length",
        "schema_version"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "SchemaVersion": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "title": "SchemaVersion",
      "type": "string"
    },
    "StableId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "StableId",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "action": {
      "maxLength": 64,
      "minLength": 1,
      "title": "Action",
      "type": "string"
    },
    "actor_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Actor Id",
      "type": "string"
    },
    "additional_attempts": {
      "default": 0,
      "minimum": 0,
      "title": "Additional Attempts",
      "type": "integer"
    },
    "additional_planner_memory_tranches": {
      "default": 0,
      "minimum": 0,
      "title": "Additional Planner Memory Tranches",
      "type": "integer"
    },
    "command_id": {
      "$ref": "#/$defs/StableId"
    },
    "model_call_attempt_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/StableId"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "model_call_evidence_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/ArtifactRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "model_call_request_hash": {
      "anyOf": [
        {
          "$ref": "#/$defs/ArtifactId"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "model_call_request_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/StableId"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "reason": {
      "maxLength": 512,
      "minLength": 1,
      "title": "Reason",
      "type": "string"
    },
    "writer_generation_after": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Writer Generation After"
    }
  },
  "required": [
    "command_id",
    "action",
    "actor_id",
    "reason"
  ],
  "title": "ControlIntentPayload",
  "type": "object"
}
