{
  "$defs": {
    "ArtifactId": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "ArtifactId",
      "type": "string"
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/ArtifactId"
        },
        "byte_length": {
          "minimum": 0,
          "title": "Byte Length",
          "type": "integer"
        },
        "media_type": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "schema_version": {
          "$ref": "#/$defs/SchemaVersion"
        }
      },
      "required": [
        "artifact_id",
        "media_type",
        "byte_length",
        "schema_version"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "OperatorReviewFinding": {
      "additionalProperties": false,
      "description": "A host/operator finding, separate from a model ``PlanReview`` receipt.",
      "properties": {
        "actual": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Actual"
        },
        "affected_item_ids": {
          "default": [],
          "items": {
            "$ref": "#/$defs/StableId"
          },
          "title": "Affected Item Ids",
          "type": "array"
        },
        "blocking": {
          "default": true,
          "title": "Blocking",
          "type": "boolean"
        },
        "constraint_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Constraint Id"
        },
        "expected": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected"
        },
        "field_path": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Field Path"
        },
        "issue_id": {
          "$ref": "#/$defs/StableId"
        },
        "kind": {
          "minLength": 1,
          "title": "Kind",
          "type": "string"
        },
        "summary": {
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "issue_id",
        "kind",
        "summary"
      ],
      "title": "OperatorReviewFinding",
      "type": "object"
    },
    "SchemaVersion": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "title": "SchemaVersion",
      "type": "string"
    },
    "StableId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "StableId",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Immutable evidence supplied by the Codex/operator review boundary.",
  "properties": {
    "decision": {
      "const": "revise",
      "default": "revise",
      "title": "Decision",
      "type": "string"
    },
    "issues": {
      "items": {
        "$ref": "#/$defs/OperatorReviewFinding"
      },
      "minItems": 1,
      "title": "Issues",
      "type": "array"
    },
    "reason": {
      "maxLength": 2048,
      "minLength": 1,
      "title": "Reason",
      "type": "string"
    },
    "review_id": {
      "$ref": "#/$defs/StableId"
    },
    "reviewer_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Reviewer Id",
      "type": "string"
    },
    "supporting_review_artifact_refs": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ArtifactRef"
      },
      "title": "Supporting Review Artifact Refs",
      "type": "array"
    },
    "target_artifact_ref": {
      "$ref": "#/$defs/ArtifactRef"
    }
  },
  "required": [
    "review_id",
    "target_artifact_ref",
    "reviewer_id",
    "reason",
    "issues"
  ],
  "title": "OperatorReviewEvidence",
  "type": "object"
}
