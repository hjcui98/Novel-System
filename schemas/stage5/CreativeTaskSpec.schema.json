{
  "$defs": {
    "ArtifactId": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "ArtifactId",
      "type": "string"
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/ArtifactId"
        },
        "byte_length": {
          "minimum": 0,
          "title": "Byte Length",
          "type": "integer"
        },
        "media_type": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "schema_version": {
          "$ref": "#/$defs/SchemaVersion"
        }
      },
      "required": [
        "artifact_id",
        "media_type",
        "byte_length",
        "schema_version"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "CommitId": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "CommitId",
      "type": "string"
    },
    "SchemaVersion": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "title": "SchemaVersion",
      "type": "string"
    },
    "StableId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "StableId",
      "type": "string"
    },
    "TaskId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "TaskId",
      "type": "string"
    },
    "TaskKind": {
      "enum": [
        "plan_candidate",
        "plan_acceptance",
        "plan_commit",
        "draft_candidate",
        "draft_acceptance",
        "draft_commit",
        "projection_freshness",
        "maintenance"
      ],
      "title": "TaskKind",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "basis_commit": {
      "$ref": "#/$defs/CommitId"
    },
    "basis_snapshot": {
      "anyOf": [
        {
          "$ref": "#/$defs/StableId"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "dependency_task_ids": {
      "default": [],
      "items": {
        "$ref": "#/$defs/TaskId"
      },
      "title": "Dependency Task Ids",
      "type": "array"
    },
    "input_artifact_refs": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ArtifactRef"
      },
      "title": "Input Artifact Refs",
      "type": "array"
    },
    "kind": {
      "$ref": "#/$defs/TaskKind"
    },
    "task_id": {
      "$ref": "#/$defs/TaskId"
    }
  },
  "required": [
    "task_id",
    "kind",
    "basis_commit"
  ],
  "title": "CreativeTaskSpec",
  "type": "object"
}
