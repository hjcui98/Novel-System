{
  "$defs": {
    "ArtifactId": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "ArtifactId",
      "type": "string"
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/ArtifactId"
        },
        "byte_length": {
          "minimum": 0,
          "title": "Byte Length",
          "type": "integer"
        },
        "media_type": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "schema_version": {
          "$ref": "#/$defs/SchemaVersion"
        }
      },
      "required": [
        "artifact_id",
        "media_type",
        "byte_length",
        "schema_version"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "RunId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "RunId",
      "type": "string"
    },
    "SchemaVersion": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "title": "SchemaVersion",
      "type": "string"
    },
    "StableId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "StableId",
      "type": "string"
    },
    "TaskId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "TaskId",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "actor_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Actor Id",
      "type": "string"
    },
    "block_cause_fingerprint": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Block Cause Fingerprint",
      "type": "string"
    },
    "changed_evidence_refs": {
      "items": {
        "$ref": "#/$defs/ArtifactRef"
      },
      "minItems": 1,
      "title": "Changed Evidence Refs",
      "type": "array"
    },
    "command_id": {
      "$ref": "#/$defs/StableId"
    },
    "kind": {
      "const": "unblock",
      "default": "unblock",
      "title": "Kind",
      "type": "string"
    },
    "reason": {
      "maxLength": 512,
      "minLength": 1,
      "title": "Reason",
      "type": "string"
    },
    "run_id": {
      "$ref": "#/$defs/RunId"
    },
    "task_id": {
      "$ref": "#/$defs/TaskId"
    }
  },
  "required": [
    "command_id",
    "run_id",
    "task_id",
    "actor_id",
    "reason",
    "block_cause_fingerprint",
    "changed_evidence_refs"
  ],
  "title": "UnblockCommand",
  "type": "object"
}
