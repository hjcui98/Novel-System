{
  "$defs": {
    "ArtifactId": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "ArtifactId",
      "type": "string"
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/ArtifactId"
        },
        "byte_length": {
          "minimum": 0,
          "title": "Byte Length",
          "type": "integer"
        },
        "media_type": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "schema_version": {
          "$ref": "#/$defs/SchemaVersion"
        }
      },
      "required": [
        "artifact_id",
        "media_type",
        "byte_length",
        "schema_version"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "AttemptOutcome": {
      "enum": [
        "succeeded",
        "failed",
        "suspended",
        "cancelled"
      ],
      "title": "AttemptOutcome",
      "type": "string"
    },
    "FailureClass": {
      "enum": [
        "worker_startup",
        "worker_lease_expired",
        "provider_transient",
        "scheduling_timeout",
        "scheduling_budget_unsatisfiable",
        "leaf_schema_rejected",
        "leaf_review_required",
        "canon_extraction_gap",
        "basis_changed",
        "permission_denied",
        "validation_rejected",
        "commit_conflict",
        "projection_failed",
        "freshness_waiting",
        "freshness_blocked",
        "writer_lane_busy",
        "effect_uncertain",
        "poison_loop",
        "budget_exhausted",
        "cancelled",
        "runtime_capability_unavailable",
        "external_resource_unavailable",
        "unknown"
      ],
      "title": "FailureClass",
      "type": "string"
    },
    "SchemaVersion": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "title": "SchemaVersion",
      "type": "string"
    },
    "StableId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "StableId",
      "type": "string"
    },
    "TaskStatus": {
      "enum": [
        "pending",
        "ready",
        "running",
        "waiting_input",
        "waiting_retry",
        "budget_review",
        "recovery_pending",
        "blocked",
        "succeeded",
        "failed",
        "cancelled"
      ],
      "title": "TaskStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "attempt_id": {
      "$ref": "#/$defs/StableId"
    },
    "block_cause": {
      "anyOf": [
        {
          "maxLength": 512,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Block Cause"
    },
    "ended_at": {
      "format": "date-time",
      "title": "Ended At",
      "type": "string"
    },
    "failure_class": {
      "anyOf": [
        {
          "$ref": "#/$defs/FailureClass"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "outcome": {
      "$ref": "#/$defs/AttemptOutcome"
    },
    "task_status": {
      "$ref": "#/$defs/TaskStatus"
    },
    "terminal_artifact_refs": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ArtifactRef"
      },
      "title": "Terminal Artifact Refs",
      "type": "array"
    }
  },
  "required": [
    "attempt_id",
    "outcome",
    "task_status",
    "ended_at"
  ],
  "title": "TaskAttemptSettledPayload",
  "type": "object"
}
