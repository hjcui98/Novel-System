{
  "$defs": {
    "ArtifactId": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "ArtifactId",
      "type": "string"
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/ArtifactId"
        },
        "byte_length": {
          "minimum": 0,
          "title": "Byte Length",
          "type": "integer"
        },
        "media_type": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "schema_version": {
          "$ref": "#/$defs/SchemaVersion"
        }
      },
      "required": [
        "artifact_id",
        "media_type",
        "byte_length",
        "schema_version"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "CommitId": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "CommitId",
      "type": "string"
    },
    "ProjectId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "ProjectId",
      "type": "string"
    },
    "RunId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "RunId",
      "type": "string"
    },
    "SchemaVersion": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "title": "SchemaVersion",
      "type": "string"
    },
    "StableId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "StableId",
      "type": "string"
    },
    "TaskId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "TaskId",
      "type": "string"
    },
    "TaskPurpose": {
      "enum": [
        "normal",
        "lookahead",
        "replan",
        "derived_maintenance"
      ],
      "title": "TaskPurpose",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "basis_commit": {
      "$ref": "#/$defs/CommitId"
    },
    "basis_snapshot": {
      "anyOf": [
        {
          "$ref": "#/$defs/StableId"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "chapter_index": {
      "default": 0,
      "minimum": 0,
      "title": "Chapter Index",
      "type": "integer"
    },
    "horizon_end": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Horizon End"
    },
    "horizon_start": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Horizon Start"
    },
    "input_artifact_refs": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ArtifactRef"
      },
      "title": "Input Artifact Refs",
      "type": "array"
    },
    "project_id": {
      "$ref": "#/$defs/ProjectId"
    },
    "protected_chapter_index": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Protected Chapter Index"
    },
    "purpose": {
      "$ref": "#/$defs/TaskPurpose",
      "default": "normal"
    },
    "run_id": {
      "$ref": "#/$defs/RunId"
    },
    "task_id": {
      "$ref": "#/$defs/TaskId"
    }
  },
  "required": [
    "run_id",
    "task_id",
    "project_id",
    "basis_commit"
  ],
  "title": "PlanningLoopRequest",
  "type": "object"
}
