{
  "$defs": {
    "ArtifactId": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "ArtifactId",
      "type": "string"
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/ArtifactId"
        },
        "byte_length": {
          "minimum": 0,
          "title": "Byte Length",
          "type": "integer"
        },
        "media_type": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "schema_version": {
          "$ref": "#/$defs/SchemaVersion"
        }
      },
      "required": [
        "artifact_id",
        "media_type",
        "byte_length",
        "schema_version"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "CommitId": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "CommitId",
      "type": "string"
    },
    "CreativeRunTerminal": {
      "enum": [
        "PROGRESSED",
        "WAITING_PLAN_ACCEPTANCE",
        "WAITING_DRAFT_ACCEPTANCE",
        "WAITING_RETRY",
        "RECOVERY_PENDING",
        "REVIEW_REQUIRED",
        "BLOCKED",
        "COMPLETED",
        "CANCELLED"
      ],
      "title": "CreativeRunTerminal",
      "type": "string"
    },
    "ProjectId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "ProjectId",
      "type": "string"
    },
    "RunId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "RunId",
      "type": "string"
    },
    "SchemaVersion": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "title": "SchemaVersion",
      "type": "string"
    },
    "StableId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "StableId",
      "type": "string"
    },
    "TaskId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "TaskId",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "artifact_refs": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ArtifactRef"
      },
      "title": "Artifact Refs",
      "type": "array"
    },
    "basis_commit": {
      "$ref": "#/$defs/CommitId"
    },
    "current_attempt_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/StableId"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "current_commit": {
      "$ref": "#/$defs/CommitId"
    },
    "current_task_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/TaskId"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "next_legal_commands": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Next Legal Commands",
      "type": "array"
    },
    "project_id": {
      "$ref": "#/$defs/ProjectId"
    },
    "reason_code": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Reason Code",
      "type": "string"
    },
    "receipt_refs": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ArtifactRef"
      },
      "title": "Receipt Refs",
      "type": "array"
    },
    "run_id": {
      "$ref": "#/$defs/RunId"
    },
    "terminal": {
      "$ref": "#/$defs/CreativeRunTerminal"
    }
  },
  "required": [
    "run_id",
    "project_id",
    "terminal",
    "basis_commit",
    "current_commit",
    "reason_code"
  ],
  "title": "CreativeRunResult",
  "type": "object"
}
