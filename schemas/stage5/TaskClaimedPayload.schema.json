{
  "$defs": {
    "AttemptOutcome": {
      "enum": [
        "succeeded",
        "failed",
        "suspended",
        "cancelled"
      ],
      "title": "AttemptOutcome",
      "type": "string"
    },
    "FailureClass": {
      "enum": [
        "worker_startup",
        "worker_lease_expired",
        "provider_transient",
        "leaf_schema_rejected",
        "leaf_review_required",
        "canon_extraction_gap",
        "basis_changed",
        "permission_denied",
        "validation_rejected",
        "commit_conflict",
        "projection_failed",
        "freshness_waiting",
        "freshness_blocked",
        "writer_lane_busy",
        "effect_uncertain",
        "poison_loop",
        "budget_exhausted",
        "cancelled",
        "runtime_capability_unavailable",
        "external_resource_unavailable",
        "unknown"
      ],
      "title": "FailureClass",
      "type": "string"
    },
    "StableId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "StableId",
      "type": "string"
    },
    "TaskAttempt": {
      "additionalProperties": false,
      "properties": {
        "attempt_id": {
          "$ref": "#/$defs/StableId"
        },
        "attempt_no": {
          "minimum": 1,
          "title": "Attempt No",
          "type": "integer"
        },
        "claim_token_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Claim Token Digest",
          "type": "string"
        },
        "claimed_at": {
          "format": "date-time",
          "title": "Claimed At",
          "type": "string"
        },
        "effect_frontier": {
          "default": [],
          "items": {
            "$ref": "#/$defs/StableId"
          },
          "title": "Effect Frontier",
          "type": "array"
        },
        "ended_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ended At"
        },
        "failure_class": {
          "anyOf": [
            {
              "$ref": "#/$defs/FailureClass"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "fence_generation": {
          "minimum": 1,
          "title": "Fence Generation",
          "type": "integer"
        },
        "heartbeat_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Heartbeat At"
        },
        "lease_expires_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lease Expires At"
        },
        "outcome": {
          "anyOf": [
            {
              "$ref": "#/$defs/AttemptOutcome"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "source_checkpoint_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/StableId"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "started_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Started At"
        },
        "task_id": {
          "$ref": "#/$defs/TaskId"
        },
        "worker_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Worker Id",
          "type": "string"
        }
      },
      "required": [
        "attempt_id",
        "task_id",
        "attempt_no",
        "worker_id",
        "claim_token_digest",
        "fence_generation",
        "claimed_at"
      ],
      "title": "TaskAttempt",
      "type": "object"
    },
    "TaskId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "TaskId",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "attempt": {
      "$ref": "#/$defs/TaskAttempt"
    },
    "fence_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Fence Digest",
      "type": "string"
    }
  },
  "required": [
    "attempt",
    "fence_digest"
  ],
  "title": "TaskClaimedPayload",
  "type": "object"
}
