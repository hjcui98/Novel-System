{
  "$defs": {
    "ArtifactId": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "ArtifactId",
      "type": "string"
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/ArtifactId"
        },
        "byte_length": {
          "minimum": 0,
          "title": "Byte Length",
          "type": "integer"
        },
        "media_type": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "schema_version": {
          "$ref": "#/$defs/SchemaVersion"
        }
      },
      "required": [
        "artifact_id",
        "media_type",
        "byte_length",
        "schema_version"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "CandidateBinding": {
      "additionalProperties": false,
      "properties": {
        "affects_future_plan": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Affects Future Plan"
        },
        "artifact_ref": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "basis_commit": {
          "$ref": "#/$defs/CommitId"
        },
        "basis_snapshot": {
          "anyOf": [
            {
              "$ref": "#/$defs/StableId"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "candidate_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Candidate Hash",
          "type": "string"
        },
        "candidate_id": {
          "$ref": "#/$defs/StableId"
        },
        "horizon_end": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Horizon End"
        },
        "horizon_start": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Horizon Start"
        },
        "kind": {
          "$ref": "#/$defs/CandidateKind"
        },
        "lineage_artifact_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          },
          "title": "Lineage Artifact Refs",
          "type": "array"
        },
        "planning_purpose": {
          "$ref": "#/$defs/TaskPurpose",
          "default": "normal"
        },
        "protected_chapter_index": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Protected Chapter Index"
        }
      },
      "required": [
        "candidate_id",
        "kind",
        "artifact_ref",
        "candidate_hash",
        "basis_commit"
      ],
      "title": "CandidateBinding",
      "type": "object"
    },
    "CandidateKind": {
      "enum": [
        "plan",
        "draft"
      ],
      "title": "CandidateKind",
      "type": "string"
    },
    "CommitId": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "CommitId",
      "type": "string"
    },
    "PlanningTerminalStatus": {
      "enum": [
        "PLAN_CANDIDATE_READY",
        "REVIEW_REQUIRED",
        "SUSPENDED",
        "BLOCKED"
      ],
      "title": "PlanningTerminalStatus",
      "type": "string"
    },
    "RunId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "RunId",
      "type": "string"
    },
    "SchemaVersion": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "title": "SchemaVersion",
      "type": "string"
    },
    "StableId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "StableId",
      "type": "string"
    },
    "TaskId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "TaskId",
      "type": "string"
    },
    "TaskPurpose": {
      "enum": [
        "normal",
        "lookahead",
        "replan",
        "derived_maintenance"
      ],
      "title": "TaskPurpose",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "artifact_refs": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ArtifactRef"
      },
      "title": "Artifact Refs",
      "type": "array"
    },
    "candidate": {
      "anyOf": [
        {
          "$ref": "#/$defs/CandidateBinding"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "failure_code": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Failure Code"
    },
    "failure_detail": {
      "anyOf": [
        {
          "maxLength": 512,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Failure Detail"
    },
    "result_id": {
      "$ref": "#/$defs/StableId"
    },
    "run_id": {
      "$ref": "#/$defs/RunId"
    },
    "status": {
      "$ref": "#/$defs/PlanningTerminalStatus"
    },
    "task_id": {
      "$ref": "#/$defs/TaskId"
    }
  },
  "required": [
    "result_id",
    "run_id",
    "task_id",
    "status"
  ],
  "title": "PlanningLoopResult",
  "type": "object"
}
