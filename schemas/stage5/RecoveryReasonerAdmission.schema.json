{
  "$defs": {
    "ArtifactId": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "ArtifactId",
      "type": "string"
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/ArtifactId"
        },
        "byte_length": {
          "minimum": 0,
          "title": "Byte Length",
          "type": "integer"
        },
        "media_type": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "schema_version": {
          "$ref": "#/$defs/SchemaVersion"
        }
      },
      "required": [
        "artifact_id",
        "media_type",
        "byte_length",
        "schema_version"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "SchemaVersion": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "title": "SchemaVersion",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Evidence gate required before the offline reasoner can be called.",
  "properties": {
    "canonical_or_skill_mutation_observed": {
      "const": false,
      "default": false,
      "title": "Canonical Or Skill Mutation Observed",
      "type": "boolean"
    },
    "decision": {
      "const": "U8_C_ADMITTED",
      "default": "U8_C_ADMITTED",
      "title": "Decision",
      "type": "string"
    },
    "evidence_refs": {
      "items": {
        "$ref": "#/$defs/ArtifactRef"
      },
      "maxItems": 16,
      "minItems": 3,
      "title": "Evidence Refs",
      "type": "array"
    },
    "gate_authority": {
      "const": "codex_or_human",
      "default": "codex_or_human",
      "title": "Gate Authority",
      "type": "string"
    },
    "held_out_beats_deterministic_baseline": {
      "const": true,
      "default": true,
      "title": "Held Out Beats Deterministic Baseline",
      "type": "boolean"
    },
    "receipt_state_cannot_disambiguate": {
      "const": true,
      "default": true,
      "title": "Receipt State Cannot Disambiguate",
      "type": "boolean"
    },
    "same_failure_boundary_has_multiple_valid_actions": {
      "const": true,
      "default": true,
      "title": "Same Failure Boundary Has Multiple Valid Actions",
      "type": "boolean"
    }
  },
  "required": [
    "evidence_refs"
  ],
  "title": "RecoveryReasonerAdmission",
  "type": "object"
}
