{
  "$defs": {
    "ArtifactId": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "ArtifactId",
      "type": "string"
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/ArtifactId"
        },
        "byte_length": {
          "minimum": 0,
          "title": "Byte Length",
          "type": "integer"
        },
        "media_type": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "schema_version": {
          "$ref": "#/$defs/SchemaVersion"
        }
      },
      "required": [
        "artifact_id",
        "media_type",
        "byte_length",
        "schema_version"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "CommitId": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "CommitId",
      "type": "string"
    },
    "EvolutionCheckpointUse": {
      "enum": [
        "calibration",
        "sealed_acceptance",
        "canary"
      ],
      "title": "EvolutionCheckpointUse",
      "type": "string"
    },
    "SchemaVersion": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "title": "SchemaVersion",
      "type": "string"
    },
    "StableId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "StableId",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "basis_commit": {
      "$ref": "#/$defs/CommitId"
    },
    "basis_ref": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "checkpoint_id": {
      "$ref": "#/$defs/StableId"
    },
    "incident_ids": {
      "items": {
        "$ref": "#/$defs/StableId"
      },
      "maxItems": 64,
      "minItems": 1,
      "title": "Incident Ids",
      "type": "array"
    },
    "use": {
      "$ref": "#/$defs/EvolutionCheckpointUse"
    }
  },
  "required": [
    "checkpoint_id",
    "use",
    "basis_commit",
    "basis_ref",
    "incident_ids"
  ],
  "title": "EvolutionCheckpointAssignment",
  "type": "object"
}
