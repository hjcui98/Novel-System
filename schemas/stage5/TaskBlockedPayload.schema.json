{
  "$defs": {
    "ArtifactId": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "ArtifactId",
      "type": "string"
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/ArtifactId"
        },
        "byte_length": {
          "minimum": 0,
          "title": "Byte Length",
          "type": "integer"
        },
        "media_type": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "schema_version": {
          "$ref": "#/$defs/SchemaVersion"
        }
      },
      "required": [
        "artifact_id",
        "media_type",
        "byte_length",
        "schema_version"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "FailureClass": {
      "enum": [
        "worker_startup",
        "provider_transient",
        "leaf_review_required",
        "basis_changed",
        "permission_denied",
        "validation_rejected",
        "commit_conflict",
        "projection_failed",
        "freshness_waiting",
        "freshness_blocked",
        "effect_uncertain",
        "poison_loop",
        "budget_exhausted",
        "cancelled"
      ],
      "title": "FailureClass",
      "type": "string"
    },
    "SchemaVersion": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "title": "SchemaVersion",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "cause_fingerprint": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Cause Fingerprint",
      "type": "string"
    },
    "error_artifact_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/ArtifactRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "failure_class": {
      "$ref": "#/$defs/FailureClass"
    },
    "sanitized_message": {
      "maxLength": 512,
      "minLength": 1,
      "title": "Sanitized Message",
      "type": "string"
    }
  },
  "required": [
    "failure_class",
    "cause_fingerprint",
    "sanitized_message"
  ],
  "title": "TaskBlockedPayload",
  "type": "object"
}
