{
  "$defs": {
    "ArtifactId": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "ArtifactId",
      "type": "string"
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/ArtifactId"
        },
        "byte_length": {
          "minimum": 0,
          "title": "Byte Length",
          "type": "integer"
        },
        "media_type": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "schema_version": {
          "$ref": "#/$defs/SchemaVersion"
        }
      },
      "required": [
        "artifact_id",
        "media_type",
        "byte_length",
        "schema_version"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "FailureLedgerRef": {
      "additionalProperties": false,
      "properties": {
        "artifact": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "entry_count": {
          "minimum": 0,
          "title": "Entry Count",
          "type": "integer"
        },
        "ledger_type": {
          "$ref": "#/$defs/FailureLedgerType"
        }
      },
      "required": [
        "ledger_type",
        "artifact",
        "entry_count"
      ],
      "title": "FailureLedgerRef",
      "type": "object"
    },
    "FailureLedgerType": {
      "enum": [
        "bootstrap",
        "controller",
        "curator"
      ],
      "title": "FailureLedgerType",
      "type": "string"
    },
    "SchemaVersion": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "title": "SchemaVersion",
      "type": "string"
    },
    "StableId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "StableId",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "agentic_gain_proven": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Agentic Gain Proven"
    },
    "agentic_safety_regression_count": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Agentic Safety Regression Count"
    },
    "bootstrap_user_data_imported": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Bootstrap User Data Imported"
    },
    "checkpoint_chain_consistent": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Checkpoint Chain Consistent"
    },
    "checkpoint_chapters": {
      "default": [],
      "items": {
        "type": "integer"
      },
      "title": "Checkpoint Chapters",
      "type": "array"
    },
    "configuration_fingerprint": {
      "$ref": "#/$defs/ArtifactId"
    },
    "contracts_versioned": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Contracts Versioned"
    },
    "controller_checkpoint_resume_passed": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Controller Checkpoint Resume Passed"
    },
    "controller_read_only_bounded": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Controller Read Only Bounded"
    },
    "curator_real_replay_passed": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Curator Real Replay Passed"
    },
    "evaluation_ledger_complete": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Evaluation Ledger Complete"
    },
    "evidence_id": {
      "$ref": "#/$defs/StableId"
    },
    "failure_ledgers": {
      "default": [],
      "items": {
        "$ref": "#/$defs/FailureLedgerRef"
      },
      "title": "Failure Ledgers",
      "type": "array"
    },
    "freshness_violation_count": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Freshness Violation Count"
    },
    "future_isolation_failure_count": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Future Isolation Failure Count"
    },
    "future_leakage_count": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Future Leakage Count"
    },
    "genesis_author_approved": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Genesis Author Approved"
    },
    "held_out_complex_classes_with_gain": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Held Out Complex Classes With Gain"
    },
    "information_profiles_separate": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Information Profiles Separate"
    },
    "paired_results_count": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Paired Results Count"
    },
    "real_bundle_hash": {
      "anyOf": [
        {
          "$ref": "#/$defs/ArtifactId"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "real_replay_chapters": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Real Replay Chapters"
    },
    "rejected_patch_pollution_count": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Rejected Patch Pollution Count"
    },
    "source_traceability_passed": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Traceability Passed"
    },
    "tool_calls_replayable": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Tool Calls Replayable"
    }
  },
  "required": [
    "evidence_id",
    "configuration_fingerprint"
  ],
  "title": "Stage2GateEvidence",
  "type": "object"
}
