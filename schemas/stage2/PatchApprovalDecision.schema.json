{
  "$defs": {
    "AuthorApprovalStatus": {
      "enum": [
        "pending",
        "approved",
        "rejected",
        "needs_changes"
      ],
      "title": "AuthorApprovalStatus",
      "type": "string"
    },
    "CommitId": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "CommitId",
      "type": "string"
    },
    "ProjectId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "ProjectId",
      "type": "string"
    },
    "StableId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "StableId",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "approval_request_id": {
      "$ref": "#/$defs/StableId"
    },
    "author_id": {
      "$ref": "#/$defs/StableId"
    },
    "base_commit": {
      "$ref": "#/$defs/CommitId"
    },
    "change_set_id": {
      "$ref": "#/$defs/StableId"
    },
    "decided_at": {
      "format": "date-time",
      "title": "Decided At",
      "type": "string"
    },
    "decision_id": {
      "$ref": "#/$defs/StableId"
    },
    "guardian_decision_id": {
      "$ref": "#/$defs/StableId"
    },
    "project_id": {
      "$ref": "#/$defs/ProjectId"
    },
    "reason": {
      "minLength": 1,
      "title": "Reason",
      "type": "string"
    },
    "risk_assessment_id": {
      "$ref": "#/$defs/StableId"
    },
    "status": {
      "$ref": "#/$defs/AuthorApprovalStatus"
    }
  },
  "required": [
    "decision_id",
    "approval_request_id",
    "project_id",
    "change_set_id",
    "base_commit",
    "risk_assessment_id",
    "guardian_decision_id",
    "status",
    "author_id",
    "reason",
    "decided_at"
  ],
  "title": "PatchApprovalDecision",
  "type": "object"
}
