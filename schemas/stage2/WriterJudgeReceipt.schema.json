{
  "$defs": {
    "ArtifactId": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "ArtifactId",
      "type": "string"
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/ArtifactId"
        },
        "byte_length": {
          "minimum": 0,
          "title": "Byte Length",
          "type": "integer"
        },
        "media_type": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "schema_version": {
          "$ref": "#/$defs/SchemaVersion"
        }
      },
      "required": [
        "artifact_id",
        "media_type",
        "byte_length",
        "schema_version"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "RunId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "RunId",
      "type": "string"
    },
    "SchemaVersion": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "title": "SchemaVersion",
      "type": "string"
    },
    "StableId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "StableId",
      "type": "string"
    },
    "WriterJudgeAvailability": {
      "enum": [
        "available",
        "pending",
        "unavailable"
      ],
      "title": "WriterJudgeAvailability",
      "type": "string"
    },
    "WriterJudgeKind": {
      "enum": [
        "answer_judge",
        "evidence_support_judge"
      ],
      "title": "WriterJudgeKind",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "One Answer or Evidence-Support Judge phase. Pending is not a zero score.",
  "properties": {
    "availability": {
      "$ref": "#/$defs/WriterJudgeAvailability"
    },
    "freeze_receipt_id": {
      "$ref": "#/$defs/StableId"
    },
    "input_artifact_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/ArtifactRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "kind": {
      "$ref": "#/$defs/WriterJudgeKind"
    },
    "logical_phase": {
      "minLength": 1,
      "title": "Logical Phase",
      "type": "string"
    },
    "model_request_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/StableId"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "output_artifact_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/ArtifactRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "receipt_id": {
      "$ref": "#/$defs/StableId"
    },
    "response_ref": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "run_id": {
      "$ref": "#/$defs/RunId"
    },
    "score": {
      "anyOf": [
        {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Score"
    },
    "task_id": {
      "$ref": "#/$defs/StableId"
    }
  },
  "required": [
    "receipt_id",
    "kind",
    "availability",
    "logical_phase",
    "run_id",
    "task_id",
    "freeze_receipt_id",
    "response_ref"
  ],
  "title": "WriterJudgeReceipt",
  "type": "object"
}
