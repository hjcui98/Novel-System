{
  "$defs": {
    "ArmExecutionStatus": {
      "enum": [
        "COMPLETED",
        "SKIPPED",
        "FAILED"
      ],
      "title": "ArmExecutionStatus",
      "type": "string"
    },
    "ArtifactId": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "ArtifactId",
      "type": "string"
    },
    "BenchmarkInformationProfile": {
      "enum": [
        "visible_at_cutoff",
        "task_intent_only",
        "author_plan_conditioned"
      ],
      "title": "BenchmarkInformationProfile",
      "type": "string"
    },
    "ControllerStopReason": {
      "enum": [
        "sufficient",
        "mandatory_gap_unresolved",
        "budget_exhausted",
        "freshness_blocked",
        "access_blocked",
        "conflict_requires_review",
        "tool_failure",
        "no_additional_evidence"
      ],
      "title": "ControllerStopReason",
      "type": "string"
    },
    "PairedPilotArmMetrics": {
      "additionalProperties": false,
      "properties": {
        "evidence_traceability": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Evidence Traceability",
          "type": "number"
        },
        "future_leakage_count": {
          "minimum": 0,
          "title": "Future Leakage Count",
          "type": "integer"
        },
        "gold_evidence_recall": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Gold Evidence Recall",
          "type": "number"
        },
        "mandatory_constraint_coverage": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Mandatory Constraint Coverage",
          "type": "number"
        },
        "observed_use_coverage": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Observed Use Coverage",
          "type": "number"
        },
        "operational_constraint_coverage": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Operational Constraint Coverage",
          "type": "number"
        },
        "plan_obligation_coverage": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Plan Obligation Coverage",
          "type": "number"
        },
        "retrieval_call_count": {
          "minimum": 0,
          "title": "Retrieval Call Count",
          "type": "integer"
        },
        "selected_unit_count": {
          "minimum": 0,
          "title": "Selected Unit Count",
          "type": "integer"
        },
        "stop_reason": {
          "$ref": "#/$defs/ControllerStopReason"
        }
      },
      "required": [
        "gold_evidence_recall",
        "observed_use_coverage",
        "operational_constraint_coverage",
        "plan_obligation_coverage",
        "mandatory_constraint_coverage",
        "evidence_traceability",
        "selected_unit_count",
        "retrieval_call_count",
        "future_leakage_count",
        "stop_reason"
      ],
      "title": "PairedPilotArmMetrics",
      "type": "object"
    },
    "StableId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "StableId",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "accuracy_gain": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Accuracy Gain"
    },
    "agentic_execution_status": {
      "$ref": "#/$defs/ArmExecutionStatus",
      "default": "COMPLETED"
    },
    "agentic_metrics": {
      "anyOf": [
        {
          "$ref": "#/$defs/PairedPilotArmMetrics"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "blockers": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Blockers",
      "type": "array"
    },
    "case_id": {
      "$ref": "#/$defs/StableId"
    },
    "checkpoint_chapter": {
      "minimum": 0,
      "title": "Checkpoint Chapter",
      "type": "integer"
    },
    "comparable": {
      "title": "Comparable",
      "type": "boolean"
    },
    "comparison_basis_fingerprint": {
      "$ref": "#/$defs/ArtifactId"
    },
    "delta_metrics": {
      "anyOf": [
        {
          "$ref": "#/$defs/PairedPilotArmMetrics"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "deterministic_execution_status": {
      "$ref": "#/$defs/ArmExecutionStatus",
      "default": "COMPLETED"
    },
    "deterministic_metrics": {
      "$ref": "#/$defs/PairedPilotArmMetrics"
    },
    "information_profile": {
      "$ref": "#/$defs/BenchmarkInformationProfile"
    },
    "pair_id": {
      "$ref": "#/$defs/StableId"
    },
    "paired_comparison_status": {
      "default": "COMPARABLE",
      "title": "Paired Comparison Status",
      "type": "string"
    },
    "request_id": {
      "$ref": "#/$defs/StableId"
    },
    "safety_regression": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Safety Regression"
    },
    "tool_call_reduction": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Tool Call Reduction"
    }
  },
  "required": [
    "case_id",
    "information_profile",
    "checkpoint_chapter",
    "pair_id",
    "request_id",
    "comparison_basis_fingerprint",
    "comparable",
    "deterministic_metrics"
  ],
  "title": "PairedPilotCaseResult",
  "type": "object"
}
