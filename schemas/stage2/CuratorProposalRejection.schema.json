{
  "$defs": {
    "ArtifactId": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "ArtifactId",
      "type": "string"
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/ArtifactId"
        },
        "byte_length": {
          "minimum": 0,
          "title": "Byte Length",
          "type": "integer"
        },
        "media_type": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "schema_version": {
          "$ref": "#/$defs/SchemaVersion"
        }
      },
      "required": [
        "artifact_id",
        "media_type",
        "byte_length",
        "schema_version"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "CommitId": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "CommitId",
      "type": "string"
    },
    "ProposalConflict": {
      "additionalProperties": false,
      "properties": {
        "evidence_hashes": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ArtifactId"
          },
          "title": "Evidence Hashes",
          "type": "array"
        },
        "operation_indexes": {
          "items": {
            "type": "integer"
          },
          "minItems": 2,
          "title": "Operation Indexes",
          "type": "array"
        },
        "record_kind": {
          "$ref": "#/$defs/WorldRecordKind"
        },
        "semantic_hashes": {
          "items": {
            "$ref": "#/$defs/ArtifactId"
          },
          "minItems": 1,
          "title": "Semantic Hashes",
          "type": "array"
        },
        "target_id": {
          "$ref": "#/$defs/StableId"
        }
      },
      "required": [
        "record_kind",
        "target_id",
        "operation_indexes",
        "semantic_hashes"
      ],
      "title": "ProposalConflict",
      "type": "object"
    },
    "ProposalRejectionKind": {
      "enum": [
        "schema_rejected",
        "chapter_mismatch",
        "record_kind_mismatch",
        "duplicate_target",
        "normalized_target_collision",
        "incomplete_delta",
        "invalid_evidence",
        "scope_violation",
        "poison_loop"
      ],
      "title": "ProposalRejectionKind",
      "type": "string"
    },
    "ProposalRejectionStage": {
      "enum": [
        "structured_schema",
        "trusted_normalization",
        "semantic_contract",
        "information_boundary"
      ],
      "title": "ProposalRejectionStage",
      "type": "string"
    },
    "SchemaVersion": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "title": "SchemaVersion",
      "type": "string"
    },
    "StableId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "StableId",
      "type": "string"
    },
    "WorldRecordKind": {
      "enum": [
        "entity",
        "event",
        "state",
        "relation",
        "obligation"
      ],
      "title": "WorldRecordKind",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "attempt_id": {
      "$ref": "#/$defs/StableId"
    },
    "base_commit": {
      "$ref": "#/$defs/CommitId"
    },
    "conflicts": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ProposalConflict"
      },
      "title": "Conflicts",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "json_pointers": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Json Pointers",
      "type": "array"
    },
    "kind": {
      "$ref": "#/$defs/ProposalRejectionKind"
    },
    "normalized_output_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/ArtifactRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "operation_indexes": {
      "default": [],
      "items": {
        "type": "integer"
      },
      "title": "Operation Indexes",
      "type": "array"
    },
    "output_hash": {
      "anyOf": [
        {
          "$ref": "#/$defs/ArtifactId"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "raw_draft_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/ArtifactRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "reason_code": {
      "minLength": 1,
      "title": "Reason Code",
      "type": "string"
    },
    "rejection_id": {
      "$ref": "#/$defs/StableId"
    },
    "rejection_signature": {
      "$ref": "#/$defs/ArtifactId"
    },
    "retryable": {
      "title": "Retryable",
      "type": "boolean"
    },
    "safe_feedback": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Safe Feedback",
      "type": "array"
    },
    "stage": {
      "$ref": "#/$defs/ProposalRejectionStage"
    },
    "validation_error_paths": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Validation Error Paths",
      "type": "array"
    },
    "violation_rule": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Violation Rule"
    },
    "workflow_request_id": {
      "$ref": "#/$defs/StableId"
    }
  },
  "required": [
    "rejection_id",
    "attempt_id",
    "workflow_request_id",
    "base_commit",
    "stage",
    "kind",
    "reason_code",
    "retryable",
    "rejection_signature",
    "created_at"
  ],
  "title": "CuratorProposalRejection",
  "type": "object"
}
