{
  "$defs": {
    "AgentMode": {
      "enum": [
        "project_bootstrap",
        "story",
        "arc_volume",
        "chapter",
        "scene",
        "replan",
        "bootstrap",
        "replay",
        "curator_repair",
        "bounded_r2",
        "risk_review",
        "draft",
        "continue",
        "major_rewrite",
        "review",
        "local_repair",
        "observe",
        "chapter_set"
      ],
      "title": "AgentMode",
      "type": "string"
    },
    "ArtifactId": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "ArtifactId",
      "type": "string"
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/ArtifactId"
        },
        "byte_length": {
          "minimum": 0,
          "title": "Byte Length",
          "type": "integer"
        },
        "media_type": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "schema_version": {
          "$ref": "#/$defs/SchemaVersion"
        }
      },
      "required": [
        "artifact_id",
        "media_type",
        "byte_length",
        "schema_version"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "BootstrapStrategy": {
      "enum": [
        "normalize_only",
        "develop_candidates"
      ],
      "title": "BootstrapStrategy",
      "type": "string"
    },
    "JsonValue": {},
    "PlanDeviationRecordCandidate": {
      "additionalProperties": false,
      "properties": {
        "affected_plan_item_ids": {
          "items": {
            "$ref": "#/$defs/StableId"
          },
          "minItems": 1,
          "title": "Affected Plan Item Ids",
          "type": "array"
        },
        "deviation_id": {
          "$ref": "#/$defs/StableId"
        },
        "invalidated_artifact_ids": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ArtifactId"
          },
          "title": "Invalidated Artifact Ids",
          "type": "array"
        },
        "replacement_item_ids": {
          "default": [],
          "items": {
            "$ref": "#/$defs/StableId"
          },
          "title": "Replacement Item Ids",
          "type": "array"
        },
        "summary": {
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "deviation_id",
        "summary",
        "affected_plan_item_ids"
      ],
      "title": "PlanDeviationRecordCandidate",
      "type": "object"
    },
    "PlanUnresolvedIssueDraft": {
      "additionalProperties": false,
      "description": "Untrusted structured unresolved statement emitted by the Planner.\n\nThe host, rather than the model, assigns ``issue_id``.  A revision refers to a\nprior host identity through ``parent_issue_id``; a fresh statement is an ADD.\n``source_ids`` and ``affected_chapters`` are deliberately explicit because a\nsummary string is not a stable identity or a usable scope.",
      "properties": {
        "affected_chapters": {
          "default": [],
          "items": {
            "type": "integer"
          },
          "title": "Affected Chapters",
          "type": "array"
        },
        "allowed_assumptions": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Allowed Assumptions",
          "type": "array"
        },
        "blocking": {
          "default": false,
          "title": "Blocking",
          "type": "boolean"
        },
        "closure_reason": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Closure Reason"
        },
        "forbidden_assumptions": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Forbidden Assumptions",
          "type": "array"
        },
        "kind": {
          "$ref": "#/$defs/PlanUnresolvedKind",
          "default": "UNSPECIFIED"
        },
        "operation": {
          "$ref": "#/$defs/PlanUnresolvedOperation",
          "default": "add"
        },
        "parent_issue_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/StableId"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "resolution_owner": {
          "default": "PLANNER",
          "minLength": 1,
          "title": "Resolution Owner",
          "type": "string"
        },
        "source_artifact_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          },
          "title": "Source Artifact Refs",
          "type": "array"
        },
        "source_ids": {
          "default": [],
          "items": {
            "$ref": "#/$defs/StableId"
          },
          "title": "Source Ids",
          "type": "array"
        },
        "summary": {
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "summary"
      ],
      "title": "PlanUnresolvedIssueDraft",
      "type": "object"
    },
    "PlanUnresolvedKind": {
      "enum": [
        "AUTHOR_INTENT_CONFLICT",
        "CURRENT_STATE_UNKNOWN",
        "POWER_LEVEL_UNKNOWN",
        "KNOWLEDGE_BOUNDARY_UNKNOWN",
        "OBLIGATION_WINDOW_CONFLICT",
        "UNSPECIFIED"
      ],
      "title": "PlanUnresolvedKind",
      "type": "string"
    },
    "PlanUnresolvedOperation": {
      "description": "The lifecycle operation represented by one unresolved statement.",
      "enum": [
        "add",
        "modify",
        "close"
      ],
      "title": "PlanUnresolvedOperation",
      "type": "string"
    },
    "ProposalProvenance": {
      "enum": [
        "author_supplied",
        "planner_proposed"
      ],
      "title": "ProposalProvenance",
      "type": "string"
    },
    "ProposedItem": {
      "additionalProperties": false,
      "properties": {
        "item_id": {
          "$ref": "#/$defs/StableId"
        },
        "kind": {
          "minLength": 1,
          "title": "Kind",
          "type": "string"
        },
        "payload": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Payload",
          "type": "object"
        },
        "provenance": {
          "$ref": "#/$defs/ProposalProvenance"
        },
        "source_ids": {
          "default": [],
          "items": {
            "$ref": "#/$defs/StableId"
          },
          "title": "Source Ids",
          "type": "array"
        }
      },
      "required": [
        "item_id",
        "kind",
        "payload",
        "provenance"
      ],
      "title": "ProposedItem",
      "type": "object"
    },
    "SchemaVersion": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "title": "SchemaVersion",
      "type": "string"
    },
    "StableId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "StableId",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "alternatives": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Alternatives",
      "type": "array"
    },
    "coverage": {
      "maximum": 1,
      "minimum": 0,
      "title": "Coverage",
      "type": "number"
    },
    "deviations": {
      "default": [],
      "items": {
        "$ref": "#/$defs/PlanDeviationRecordCandidate"
      },
      "title": "Deviations",
      "type": "array"
    },
    "mode": {
      "$ref": "#/$defs/AgentMode"
    },
    "plan_items": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ProposedItem"
      },
      "title": "Plan Items",
      "type": "array"
    },
    "profile_items": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ProposedItem"
      },
      "title": "Profile Items",
      "type": "array"
    },
    "project_intent_items": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ProposedItem"
      },
      "title": "Project Intent Items",
      "type": "array"
    },
    "selection_rationale": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Selection Rationale"
    },
    "strategy": {
      "anyOf": [
        {
          "$ref": "#/$defs/BootstrapStrategy"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "unresolved": {
      "default": [],
      "items": {
        "$ref": "#/$defs/PlanUnresolvedIssueDraft"
      },
      "title": "Unresolved",
      "type": "array"
    },
    "world_design_items": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ProposedItem"
      },
      "title": "World Design Items",
      "type": "array"
    }
  },
  "required": [
    "mode",
    "coverage"
  ],
  "title": "PlannerProposalDraft",
  "type": "object"
}
