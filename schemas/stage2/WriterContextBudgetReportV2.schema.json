{
  "$defs": {
    "ContextAssemblyStatus": {
      "enum": [
        "READY",
        "NEEDS_REDUCTION",
        "CONTEXT_BUDGET_INSUFFICIENT",
        "EVIDENCE_INSUFFICIENT",
        "POLICY_BLOCKED"
      ],
      "title": "ContextAssemblyStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "actual_rendered_ledger_tokens": {
      "minimum": 0,
