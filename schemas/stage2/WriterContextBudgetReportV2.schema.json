    },
    "gap_item_count": {
      "minimum": 0,
      "title": "Gap Item Count",
      "type": "integer"
    },
    "item_count": {
      "minimum": 0,
      "title": "Item Count",
      "type": "integer"
    },
    "ledger_entry_count": {
      "minimum": 0,
      "title": "Ledger Entry Count",
      "type": "integer"
    },
    "tokenizer": {
      "minLength": 1,
      "title": "Tokenizer",
      "type": "string"
    },
    "tokenizer_version": {
      "minLength": 1,
      "title": "Tokenizer Version",
      "type": "string"
    }
  },
  "required": [
    "tokenizer",
    "tokenizer_version",
    "configured_writer_token_budget",
    "actual_rendered_writer_tokens",
    "configured_ledger_token_budget",
    "actual_rendered_ledger_tokens",
    "item_count",
    "evidence_item_count",
    "gap_item_count",
    "ledger_entry_count",
    "final_status"
