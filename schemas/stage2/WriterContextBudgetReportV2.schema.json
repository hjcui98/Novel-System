      "type": "integer"
    },
    "actual_rendered_writer_tokens": {
      "minimum": 0,
      "title": "Actual Rendered Writer Tokens",
      "type": "integer"
    },
    "configured_ledger_token_budget": {
      "minimum": 1,
      "title": "Configured Ledger Token Budget",
      "type": "integer"
    },
    "configured_writer_token_budget": {
      "minimum": 1,
      "title": "Configured Writer Token Budget",
      "type": "integer"
    },
    "dropped_slice_reasons": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Dropped Slice Reasons",
      "type": "object"
