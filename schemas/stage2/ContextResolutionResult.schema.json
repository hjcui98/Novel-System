{
  "$defs": {
    "AccessScope": {
      "enum": [
        "writer_safe",
        "author_planning",
        "evaluator"
      ],
      "title": "AccessScope",
      "type": "string"
    },
    "AgentExecutionReceipt": {
      "additionalProperties": false,
      "properties": {
        "agent_mode": {
          "$ref": "#/$defs/AgentMode"
        },
        "agent_spec": {
          "$ref": "#/$defs/ContractRef"
        },
        "agent_type": {
          "$ref": "#/$defs/AgentType"
        },
        "base_commit": {
          "anyOf": [
            {
              "$ref": "#/$defs/CommitId"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "completed_at": {
          "format": "date-time",
          "title": "Completed At",
          "type": "string"
        },
        "configuration_fingerprint": {
          "$ref": "#/$defs/ArtifactId"
        },
        "escalations": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Escalations",
          "type": "array"
        },
        "input_artifacts": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          },
          "title": "Input Artifacts",
          "type": "array"
        },
        "latency_ms": {
          "minimum": 0,
          "title": "Latency Ms",
          "type": "integer"
        },
        "model_call_ids": {
          "default": [],
          "items": {
            "$ref": "#/$defs/StableId"
          },
          "title": "Model Call Ids",
          "type": "array"
        },
        "output_artifacts": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          },
          "title": "Output Artifacts",
          "type": "array"
        },
        "prompt_fingerprint": {
          "$ref": "#/$defs/ArtifactId"
        },
        "receipt_id": {
          "$ref": "#/$defs/StableId"
        },
        "run_id": {
          "$ref": "#/$defs/RunId"
        },
        "skill_receipts": {
          "default": [],
          "items": {
            "$ref": "#/$defs/SkillExecutionReceipt"
          },
          "title": "Skill Receipts",
          "type": "array"
        },
        "started_at": {
          "format": "date-time",
          "title": "Started At",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/ExecutionStatus"
        },
        "task_id": {
          "$ref": "#/$defs/TaskId"
        },
        "tool_call_ids": {
          "default": [],
          "items": {
            "$ref": "#/$defs/StableId"
          },
          "title": "Tool Call Ids",
          "type": "array"
        },
        "unresolved": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Unresolved",
          "type": "array"
        }
      },
      "required": [
        "receipt_id",
        "run_id",
        "task_id",
        "agent_spec",
        "agent_type",
        "agent_mode",
        "prompt_fingerprint",
        "configuration_fingerprint",
        "status",
        "started_at",
        "completed_at",
        "latency_ms"
      ],
      "title": "AgentExecutionReceipt",
      "type": "object"
    },
    "AgentMode": {
      "enum": [
        "project_bootstrap",
        "story",
        "arc_volume",
        "chapter",
        "scene",
        "replan",
        "bootstrap",
        "replay",
        "curator_repair",
        "bounded_r2",
        "risk_review",
        "draft",
        "continue",
        "major_rewrite",
        "review",
        "local_repair"
      ],
      "title": "AgentMode",
      "type": "string"
    },
    "AgentType": {
      "enum": [
        "planner",
        "memory_curator",
        "memory_controller",
        "memory_guardian",
        "writer",
        "editor"
      ],
      "title": "AgentType",
      "type": "string"
    },
    "ArtifactId": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "ArtifactId",
      "type": "string"
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/ArtifactId"
        },
        "byte_length": {
          "minimum": 0,
          "title": "Byte Length",
          "type": "integer"
        },
        "media_type": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "schema_version": {
          "$ref": "#/$defs/SchemaVersion"
        }
      },
      "required": [
        "artifact_id",
        "media_type",
        "byte_length",
        "schema_version"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "CandidatePool": {
      "enum": [
        "r0",
        "r1",
        "anchor",
        "grounded",
        "hierarchy",
        "graph"
      ],
      "title": "CandidatePool",
      "type": "string"
    },
    "CommitId": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "CommitId",
      "type": "string"
    },
    "ContextAssemblySpec": {
      "additionalProperties": false,
      "properties": {
        "allowed_claim_variant_ids_by_support_group": {
          "additionalProperties": {
            "items": {
              "$ref": "#/$defs/StableId"
            },
            "type": "array"
          },
          "title": "Allowed Claim Variant Ids By Support Group",
          "type": "object"
        },
        "closed_need_facet_ids": {
          "default": [],
          "items": {
            "$ref": "#/$defs/StableId"
          },
          "title": "Closed Need Facet Ids",
          "type": "array"
        },
        "evidence_ledger_token_budget": {
          "default": 12000,
          "minimum": 1,
          "title": "Evidence Ledger Token Budget",
          "type": "integer"
        },
        "mandatory_claim_variant_ids": {
          "default": [],
          "items": {
            "$ref": "#/$defs/StableId"
          },
          "title": "Mandatory Claim Variant Ids",
          "type": "array"
        },
        "mandatory_support_group_ids": {
          "default": [],
          "items": {
            "$ref": "#/$defs/StableId"
          },
          "title": "Mandatory Support Group Ids",
          "type": "array"
        },
        "mandatory_unit_ids": {
          "default": [],
          "items": {
            "$ref": "#/$defs/StableId"
          },
          "title": "Mandatory Unit Ids",
          "type": "array"
        },
        "ordered_optional_support_group_ids": {
          "default": [],
          "items": {
            "$ref": "#/$defs/StableId"
          },
          "title": "Ordered Optional Support Group Ids",
          "type": "array"
        },
        "reduction_allowed": {
          "default": true,
          "title": "Reduction Allowed",
          "type": "boolean"
        },
        "reduction_policy": {
          "default": "receipt_bound_variants_only",
          "minLength": 1,
          "title": "Reduction Policy",
          "type": "string"
        },
        "selected_support_group_ids": {
          "default": [],
          "items": {
            "$ref": "#/$defs/StableId"
          },
          "title": "Selected Support Group Ids",
          "type": "array"
        },
        "selected_unit_ids": {
          "default": [],
          "items": {
            "$ref": "#/$defs/StableId"
          },
          "title": "Selected Unit Ids",
          "type": "array"
        },
        "selection_policy_version": {
          "default": "legacy_unit_selection.v1",
          "minLength": 1,
          "title": "Selection Policy Version",
          "type": "string"
        },
        "token_budget": {
          "default": 1,
          "minimum": 1,
          "title": "Token Budget",
          "type": "integer"
        },
        "unresolved_need_facet_ids": {
          "default": [],
          "items": {
            "$ref": "#/$defs/StableId"
          },
          "title": "Unresolved Need Facet Ids",
          "type": "array"
        },
        "writer_token_budget": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Writer Token Budget"
        }
      },
      "title": "ContextAssemblySpec",
      "type": "object"
    },
    "ContractRef": {
      "additionalProperties": false,
      "properties": {
        "content_hash": {
          "$ref": "#/$defs/ArtifactId"
        },
        "contract_id": {
          "$ref": "#/$defs/StableId"
        },
        "version": {
          "$ref": "#/$defs/SchemaVersion"
        }
      },
      "required": [
        "contract_id",
        "version",
        "content_hash"
      ],
      "title": "ContractRef",
      "type": "object"
    },
    "ControllerStopReason": {
      "enum": [
        "sufficient",
        "mandatory_gap_unresolved",
        "budget_exhausted",
        "freshness_blocked",
        "access_blocked",
        "conflict_requires_review",
        "tool_failure",
        "no_additional_evidence"
      ],
      "title": "ControllerStopReason",
      "type": "string"
    },
    "EvidenceLedgerEntry": {
      "additionalProperties": false,
      "properties": {
        "access_scope": {
          "$ref": "#/$defs/AccessScope"
        },
        "basis_commit": {
          "$ref": "#/$defs/CommitId"
        },
        "evidence_refs": {
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "snapshot_id": {
          "$ref": "#/$defs/StableId"
        },
        "unit_id": {
          "$ref": "#/$defs/StableId"
        }
      },
      "required": [
        "unit_id",
        "evidence_refs",
        "basis_commit",
        "snapshot_id",
        "access_scope"
      ],
      "title": "EvidenceLedgerEntry",
      "type": "object"
    },
    "EvidenceRef": {
      "additionalProperties": false,
      "properties": {
        "chapter_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/StableId"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "evidence_id": {
          "$ref": "#/$defs/StableId"
        },
        "object_hash": {
          "$ref": "#/$defs/ArtifactId"
        },
        "quote_hash": {
          "anyOf": [
            {
              "$ref": "#/$defs/QuoteHash"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "resolved_at_commit": {
          "$ref": "#/$defs/CommitId"
        },
        "root_hash": {
          "$ref": "#/$defs/ArtifactId"
        },
        "scene_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/StableId"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "span": {
          "anyOf": [
            {
              "$ref": "#/$defs/TextSpanRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "support_status": {
          "$ref": "#/$defs/EvidenceSupportStatus"
        }
      },
      "required": [
        "evidence_id",
        "root_hash",
        "object_hash",
        "support_status",
        "resolved_at_commit"
      ],
      "title": "EvidenceRef",
      "type": "object"
    },
    "EvidenceSupportStatus": {
      "enum": [
        "current_support",
        "historical_support",
        "superseded_support",
        "orphaned",
        "contradicted"
      ],
      "title": "EvidenceSupportStatus",
      "type": "string"
    },
    "ExecutionStatus": {
      "enum": [
        "succeeded",
        "failed",
        "suspended",
        "rejected"
      ],
      "title": "ExecutionStatus",
      "type": "string"
    },
    "ExpectedClaimScope": {
      "enum": [
        "current",
        "historical",
        "knowledge",
        "planned"
      ],
      "title": "ExpectedClaimScope",
      "type": "string"
    },
    "FacetEvidenceRequirement": {
      "enum": [
        "traceable_cutoff_source",
        "cutoff_current_source",
        "plan_provenance",
        "distinct_historical_source"
      ],
      "title": "FacetEvidenceRequirement",
      "type": "string"
    },
    "MemorySelection": {
      "additionalProperties": false,
      "properties": {
        "candidate_pool": {
          "$ref": "#/$defs/CandidatePool"
        },
        "decision": {
          "$ref": "#/$defs/SelectionDecision"
        },
        "mandatory": {
          "default": false,
          "title": "Mandatory",
          "type": "boolean"
        },
        "need_ids": {
          "items": {
            "$ref": "#/$defs/StableId"
          },
          "title": "Need Ids",
          "type": "array"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "unit_id": {
          "$ref": "#/$defs/StableId"
        }
      },
      "required": [
        "unit_id",
        "need_ids",
        "candidate_pool",
        "decision",
        "reason"
      ],
      "title": "MemorySelection",
      "type": "object"
    },
    "NeedCompletionSpec": {
      "additionalProperties": false,
      "properties": {
        "evidence_requirement_by_facet": {
          "additionalProperties": {
            "$ref": "#/$defs/FacetEvidenceRequirement"
          },
          "title": "Evidence Requirement By Facet",
          "type": "object"
        },
        "gap_policy": {
          "$ref": "#/$defs/NeedGapPolicy"
        },
        "irreducible_need_facet_ids": {
          "items": {
            "$ref": "#/$defs/StableId"
          },
          "title": "Irreducible Need Facet Ids",
          "type": "array"
        },
        "min_distinct_chapters": {
          "default": 1,
          "minimum": 1,
          "title": "Min Distinct Chapters",
          "type": "integer"
        },
        "min_distinct_evidence_sources": {
          "default": 1,
          "minimum": 1,
          "title": "Min Distinct Evidence Sources",
          "type": "integer"
        },
        "need_id": {
          "$ref": "#/$defs/StableId"
        },
        "producer": {
          "minLength": 1,
          "title": "Producer",
          "type": "string"
        },
        "producer_version": {
          "minLength": 1,
          "title": "Producer Version",
          "type": "string"
        },
        "require_causal_history": {
          "default": false,
          "title": "Require Causal History",
          "type": "boolean"
        },
        "require_current_claim": {
          "default": false,
          "title": "Require Current Claim",
          "type": "boolean"
        },
        "required_need_facet_ids": {
          "items": {
            "$ref": "#/$defs/StableId"
          },
          "title": "Required Need Facet Ids",
          "type": "array"
        },
        "uncertainty_policy": {
          "$ref": "#/$defs/NeedUncertaintyPolicy"
        }
      },
      "required": [
        "need_id",
        "required_need_facet_ids",
        "irreducible_need_facet_ids",
        "evidence_requirement_by_facet",
        "uncertainty_policy",
        "gap_policy",
        "producer",
        "producer_version"
      ],
      "title": "NeedCompletionSpec",
      "type": "object"
    },
    "NeedFacet": {
      "additionalProperties": false,
      "properties": {
        "derivation_refs": {
          "items": {
            "$ref": "#/$defs/StableId"
          },
          "title": "Derivation Refs",
          "type": "array"
        },
        "expected_claim_scope": {
          "$ref": "#/$defs/ExpectedClaimScope"
        },
        "facet_kind": {
          "$ref": "#/$defs/NeedFacetKind"
        },
        "information_scope": {
          "minLength": 1,
          "title": "Information Scope",
          "type": "string"
        },
        "need_facet_id": {
          "$ref": "#/$defs/StableId"
        },
        "need_id": {
          "$ref": "#/$defs/StableId"
        },
        "producer": {
          "minLength": 1,
          "title": "Producer",
          "type": "string"
        },
        "producer_version": {
          "minLength": 1,
          "title": "Producer Version",
          "type": "string"
        }
      },
      "required": [
        "need_facet_id",
        "need_id",
        "facet_kind",
        "expected_claim_scope",
        "derivation_refs",
        "producer",
        "producer_version",
        "information_scope"
      ],
      "title": "NeedFacet",
      "type": "object"
    },
    "NeedFacetKind": {
      "enum": [
        "current_state",
        "relation_state",
        "capability_status",
        "limitation",
        "knowledge_boundary",
        "causal_history",
        "setup",
        "unresolved_status",
        "commitment",
        "plan_node"
      ],
      "title": "NeedFacetKind",
      "type": "string"
    },
    "NeedGapPolicy": {
      "enum": [
        "emit_typed_gap",
        "fail_mandatory"
      ],
      "title": "NeedGapPolicy",
      "type": "string"
    },
    "NeedRisk": {
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "title": "NeedRisk",
      "type": "string"
    },
    "NeedUncertaintyPolicy": {
      "enum": [
        "allow_gap_only",
        "reject_unverified_claim"
      ],
      "title": "NeedUncertaintyPolicy",
      "type": "string"
    },
    "QuoteHash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "QuoteHash",
      "type": "string"
    },
    "RangeUnit": {
      "enum": [
        "unicode_codepoint"
      ],
      "title": "RangeUnit",
      "type": "string"
    },
    "RequirementLevel": {
      "enum": [
        "mandatory",
        "optional"
      ],
      "title": "RequirementLevel",
      "type": "string"
    },
    "ResolutionPath": {
      "enum": [
        "exact_temporal",
        "anchor_first",
        "hierarchy",
        "grounded_direct",
        "typed_graph"
      ],
      "title": "ResolutionPath",
      "type": "string"
    },
    "ResolutionStatus": {
      "enum": [
        "ready",
        "partial",
        "blocked",
        "failed"
      ],
      "title": "ResolutionStatus",
      "type": "string"
    },
    "RunId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "RunId",
      "type": "string"
    },
    "SchemaVersion": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "title": "SchemaVersion",
      "type": "string"
    },
    "SelectionDecision": {
      "enum": [
        "selected",
        "excluded"
      ],
      "title": "SelectionDecision",
      "type": "string"
    },
    "SkillContractRef": {
      "additionalProperties": false,
      "properties": {
        "content_hash": {
          "$ref": "#/$defs/ArtifactId"
        },
        "contract_id": {
          "$ref": "#/$defs/StableId"
        },
        "version": {
          "$ref": "#/$defs/SchemaVersion"
        }
      },
      "required": [
        "contract_id",
        "version",
        "content_hash"
      ],
      "title": "SkillContractRef",
      "type": "object"
    },
    "SkillExecutionReceipt": {
      "additionalProperties": false,
      "properties": {
        "agent_mode": {
          "$ref": "#/$defs/AgentMode"
        },
        "agent_type": {
          "$ref": "#/$defs/AgentType"
        },
        "base_commit": {
          "anyOf": [
            {
              "$ref": "#/$defs/CommitId"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "completed_checkpoints": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Completed Checkpoints",
          "type": "array"
        },
        "context_manifest": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactId"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "escalations": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Escalations",
          "type": "array"
        },
        "input_artifacts": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          },
          "title": "Input Artifacts",
          "type": "array"
        },
        "latency_ms": {
          "minimum": 0,
          "title": "Latency Ms",
          "type": "integer"
        },
        "output_artifacts": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          },
          "title": "Output Artifacts",
          "type": "array"
        },
        "receipt_id": {
          "$ref": "#/$defs/StableId"
        },
        "run_id": {
          "$ref": "#/$defs/RunId"
        },
        "skill": {
          "$ref": "#/$defs/SkillContractRef"
        },
        "skipped_checkpoints": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Skipped Checkpoints",
          "type": "array"
        },
        "status": {
          "$ref": "#/$defs/ExecutionStatus"
        },
        "task_id": {
          "$ref": "#/$defs/TaskId"
        },
        "tool_call_ids": {
          "default": [],
          "items": {
            "$ref": "#/$defs/StableId"
          },
          "title": "Tool Call Ids",
          "type": "array"
        },
        "unresolved": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Unresolved",
          "type": "array"
        }
      },
      "required": [
        "receipt_id",
        "run_id",
        "task_id",
        "skill",
        "agent_type",
        "agent_mode",
        "status",
        "latency_ms"
      ],
      "title": "SkillExecutionReceipt",
      "type": "object"
    },
    "StableId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "StableId",
      "type": "string"
    },
    "Stage1MemoryNeed": {
      "additionalProperties": false,
      "properties": {
        "access_scope": {
          "default": "writer_safe",
          "minLength": 1,
          "title": "Access Scope",
          "type": "string"
        },
        "allow_plan": {
          "default": false,
          "title": "Allow Plan",
          "type": "boolean"
        },
        "allowed_candidate_pools": {
          "items": {
            "$ref": "#/$defs/CandidatePool"
          },
          "minItems": 1,
          "title": "Allowed Candidate Pools",
          "type": "array"
        },
        "base_commit": {
          "$ref": "#/$defs/CommitId"
        },
        "chapter_target": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
