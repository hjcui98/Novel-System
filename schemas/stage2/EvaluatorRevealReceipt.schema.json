{
  "$defs": {
    "ArtifactId": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "ArtifactId",
      "type": "string"
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/ArtifactId"
        },
        "byte_length": {
          "minimum": 0,
          "title": "Byte Length",
          "type": "integer"
        },
        "media_type": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "schema_version": {
          "$ref": "#/$defs/SchemaVersion"
        }
      },
      "required": [
        "artifact_id",
        "media_type",
        "byte_length",
        "schema_version"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "SchemaVersion": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "title": "SchemaVersion",
      "type": "string"
    },
    "StableId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "StableId",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "canonical_write_count": {
      "default": 0,
      "maximum": 0,
      "minimum": 0,
      "title": "Canonical Write Count",
      "type": "integer"
    },
    "completed_at": {
      "format": "date-time",
      "title": "Completed At",
      "type": "string"
    },
    "evaluator_context_destroyed": {
      "title": "Evaluator Context Destroyed",
      "type": "boolean"
    },
    "evaluator_source_ids": {
      "items": {
        "$ref": "#/$defs/StableId"
      },
      "minItems": 1,
      "title": "Evaluator Source Ids",
      "type": "array"
    },
    "freeze_id": {
      "$ref": "#/$defs/StableId"
    },
    "reveal_id": {
      "$ref": "#/$defs/StableId"
    },
    "score_artifacts": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ArtifactRef"
      },
      "title": "Score Artifacts",
      "type": "array"
    }
  },
  "required": [
    "reveal_id",
    "freeze_id",
    "evaluator_source_ids",
    "evaluator_context_destroyed",
    "completed_at"
  ],
  "title": "EvaluatorRevealReceipt",
  "type": "object"
}
