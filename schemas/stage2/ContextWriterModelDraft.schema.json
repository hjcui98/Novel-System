{
  "$defs": {
    "ArtifactId": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "ArtifactId",
      "type": "string"
    },
    "CommitId": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "CommitId",
      "type": "string"
    },
    "ContextWriterConclusion": {
      "additionalProperties": false,
      "description": "One evidence-backed conclusion the Writer returns in Track B.\n\nConclusions are not target-window prose. Each conclusion must cite at\nleast one evidence ref so the answer can be evaluated independently of\nthe WCP diagnostic layer.",
      "properties": {
        "conclusion_id": {
          "$ref": "#/$defs/StableId"
        },
        "evidence_refs": {
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "minItems": 1,
          "title": "Evidence Refs",
          "type": "array"
        },
        "gap_ids": {
          "default": [],
          "items": {
            "$ref": "#/$defs/StableId"
          },
          "title": "Gap Ids",
          "type": "array"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "conclusion_id",
        "text",
        "evidence_refs"
      ],
      "title": "ContextWriterConclusion",
      "type": "object"
    },
    "ContextWriterExpectedAction": {
      "enum": [
        "request_memory",
        "declare_assumption",
        "defer_beat",
        "ask_author"
      ],
      "title": "ContextWriterExpectedAction",
      "type": "string"
    },
    "ContextWriterGap": {
      "additionalProperties": false,
      "description": "One typed gap declared by the real Writer in Track B.",
      "properties": {
        "blocking": {
          "title": "Blocking",
          "type": "boolean"
        },
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "evidence_available": {
          "title": "Evidence Available",
          "type": "boolean"
        },
        "expected_action": {
          "$ref": "#/$defs/ContextWriterExpectedAction"
        },
        "gap_id": {
          "$ref": "#/$defs/StableId"
        },
        "gap_type": {
          "$ref": "#/$defs/ContextWriterGapType"
        }
      },
      "required": [
        "gap_id",
        "description",
        "gap_type",
        "blocking",
        "evidence_available",
        "expected_action"
      ],
      "title": "ContextWriterGap",
      "type": "object"
    },
    "ContextWriterGapType": {
      "enum": [
        "MISSING_HISTORY",
        "EPISTEMIC_BOUNDARY",
        "UNRESOLVED_OBLIGATION",
        "CONFLICT",
        "FUTURE_REVEAL"
      ],
      "title": "ContextWriterGapType",
      "type": "string"
    },
    "EvidenceRef": {
      "additionalProperties": false,
      "properties": {
        "chapter_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/StableId"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "evidence_id": {
          "$ref": "#/$defs/StableId"
        },
        "object_hash": {
          "$ref": "#/$defs/ArtifactId"
        },
        "quote_hash": {
          "anyOf": [
            {
              "$ref": "#/$defs/QuoteHash"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "resolved_at_commit": {
          "$ref": "#/$defs/CommitId"
        },
        "root_hash": {
          "$ref": "#/$defs/ArtifactId"
        },
        "scene_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/StableId"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "span": {
          "anyOf": [
            {
              "$ref": "#/$defs/TextSpanRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "support_status": {
          "$ref": "#/$defs/EvidenceSupportStatus"
        }
      },
      "required": [
        "evidence_id",
        "root_hash",
        "object_hash",
        "support_status",
        "resolved_at_commit"
      ],
      "title": "EvidenceRef",
      "type": "object"
    },
    "EvidenceSupportStatus": {
      "enum": [
        "current_support",
        "historical_support",
        "superseded_support",
        "orphaned",
        "contradicted"
      ],
      "title": "EvidenceSupportStatus",
      "type": "string"
    },
    "QuoteHash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "QuoteHash",
      "type": "string"
    },
    "RangeUnit": {
      "enum": [
        "unicode_codepoint"
      ],
      "title": "RangeUnit",
      "type": "string"
    },
    "StableId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "StableId",
      "type": "string"
    },
    "TextSpanRef": {
      "additionalProperties": false,
      "properties": {
        "block_id": {
          "$ref": "#/$defs/StableId"
        },
        "end": {
          "minimum": 0,
          "title": "End",
          "type": "integer"
        },
        "range_unit": {
          "$ref": "#/$defs/RangeUnit",
          "default": "unicode_codepoint"
        },
        "start": {
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        }
      },
      "required": [
        "block_id",
        "start",
        "end"
      ],
      "title": "TextSpanRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Benchmark-only Writer JSON before host identity/freeze stamping.",
  "properties": {
    "conclusions": {
      "items": {
        "$ref": "#/$defs/ContextWriterConclusion"
      },
      "minItems": 1,
      "title": "Conclusions",
      "type": "array"
    },
    "gaps": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ContextWriterGap"
      },
      "title": "Gaps",
      "type": "array"
    },
    "rendered_response": {
      "default": "",
      "title": "Rendered Response",
      "type": "string"
    }
  },
  "required": [
    "conclusions"
  ],
  "title": "ContextWriterModelDraft",
  "type": "object"
}
