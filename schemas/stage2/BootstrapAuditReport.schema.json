{
  "$defs": {
    "ArtifactId": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "ArtifactId",
      "type": "string"
    },
    "AuthorApprovalStatus": {
      "enum": [
        "pending",
        "approved",
        "rejected",
        "needs_changes"
      ],
      "title": "AuthorApprovalStatus",
      "type": "string"
    },
    "BootstrapSourceAuditEntry": {
      "additionalProperties": false,
      "properties": {
        "allowed_destinations": {
          "items": {
            "$ref": "#/$defs/SourceDestination"
          },
          "title": "Allowed Destinations",
          "type": "array"
        },
        "content_hash": {
          "$ref": "#/$defs/ArtifactId"
        },
        "evaluator_only": {
          "title": "Evaluator Only",
          "type": "boolean"
        },
        "forbidden_destinations": {
          "items": {
            "$ref": "#/$defs/SourceDestination"
          },
          "title": "Forbidden Destinations",
          "type": "array"
        },
        "source_class": {
          "$ref": "#/$defs/SourceClass"
        },
        "source_id": {
          "$ref": "#/$defs/StableId"
        }
      },
      "required": [
        "source_id",
        "source_class",
        "content_hash",
        "evaluator_only",
        "allowed_destinations",
        "forbidden_destinations"
      ],
      "title": "BootstrapSourceAuditEntry",
      "type": "object"
    },
    "CommitId": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "CommitId",
      "type": "string"
    },
    "FreshnessDecision": {
      "additionalProperties": false,
      "properties": {
        "actual_alias_commit": {
          "anyOf": [
            {
              "$ref": "#/$defs/CommitId"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "actual_snapshot_commit": {
          "anyOf": [
            {
              "$ref": "#/$defs/CommitId"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "actual_snapshot_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/StableId"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "canonical_commit": {
          "$ref": "#/$defs/CommitId"
        },
        "manual_approval_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/StableId"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "r1_basis_commit": {
          "$ref": "#/$defs/CommitId"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "required_snapshot_id": {
          "$ref": "#/$defs/StableId"
        },
        "status": {
          "$ref": "#/$defs/FreshnessStatus"
        }
      },
      "required": [
        "status",
        "canonical_commit",
        "r1_basis_commit",
        "required_snapshot_id",
        "reason"
      ],
      "title": "FreshnessDecision",
      "type": "object"
    },
    "FreshnessStatus": {
      "enum": [
        "ready",
        "waiting",
        "degraded",
        "blocked",
        "overridden"
      ],
      "title": "FreshnessStatus",
      "type": "string"
    },
    "ProjectId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "ProjectId",
      "type": "string"
    },
    "SourceClass": {
      "enum": [
        "author_initial_brief",
        "author_known_future_plan",
        "baseline_setting",
        "chapter_text_n",
        "retrospective_summary",
        "future_text_private",
        "read_gold",
        "replay_gold",
        "style_guide",
        "external_reference"
      ],
      "title": "SourceClass",
      "type": "string"
    },
    "SourceDestination": {
      "enum": [
        "text",
        "plan",
        "world",
        "reference",
        "project_profile",
        "evaluation"
      ],
      "title": "SourceDestination",
      "type": "string"
    },
    "StableId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "StableId",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "approval_request_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/StableId"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "approval_status": {
      "anyOf": [
        {
          "$ref": "#/$defs/AuthorApprovalStatus"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "blockers": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Blockers",
      "type": "array"
    },
    "bootstrap_bundle_id": {
      "$ref": "#/$defs/StableId"
    },
    "bundle_hash": {
      "$ref": "#/$defs/ArtifactId"
    },
    "candidate_manifest_hash": {
      "$ref": "#/$defs/ArtifactId"
    },
    "complete": {
      "title": "Complete",
      "type": "boolean"
    },
    "configuration_fingerprint": {
      "$ref": "#/$defs/ArtifactId"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "curator_coverage": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Curator Coverage",
      "type": "number"
    },
    "curator_proposal_id": {
      "$ref": "#/$defs/StableId"
    },
    "curator_unresolved": {
      "items": {
        "type": "string"
      },
      "title": "Curator Unresolved",
      "type": "array"
    },
    "freshness": {
      "anyOf": [
        {
          "$ref": "#/$defs/FreshnessDecision"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "genesis_commit_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/CommitId"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "genesis_receipt_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/StableId"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "planner_coverage": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Planner Coverage",
      "type": "number"
    },
    "planner_proposal_id": {
      "$ref": "#/$defs/StableId"
    },
    "planner_unresolved": {
      "items": {
        "type": "string"
      },
      "title": "Planner Unresolved",
      "type": "array"
    },
    "project_id": {
      "$ref": "#/$defs/ProjectId"
    },
    "report_id": {
      "$ref": "#/$defs/StableId"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/BootstrapSourceAuditEntry"
      },
      "title": "Sources",
      "type": "array"
    },
    "validation_report_id": {
      "$ref": "#/$defs/StableId"
    },
    "validation_status": {
      "minLength": 1,
      "title": "Validation Status",
      "type": "string"
    }
  },
  "required": [
    "report_id",
    "project_id",
    "bootstrap_bundle_id",
    "bundle_hash",
    "sources",
    "planner_proposal_id",
    "planner_coverage",
    "planner_unresolved",
    "curator_proposal_id",
    "curator_coverage",
    "curator_unresolved",
    "candidate_manifest_hash",
    "validation_report_id",
    "validation_status",
    "complete",
    "configuration_fingerprint",
    "created_at"
  ],
  "title": "BootstrapAuditReport",
  "type": "object"
}
