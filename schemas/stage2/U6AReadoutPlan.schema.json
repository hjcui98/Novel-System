{
  "$defs": {
    "ArtifactId": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "ArtifactId",
      "type": "string"
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/ArtifactId"
        },
        "byte_length": {
          "minimum": 0,
          "title": "Byte Length",
          "type": "integer"
        },
        "media_type": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "schema_version": {
          "$ref": "#/$defs/SchemaVersion"
        }
      },
      "required": [
        "artifact_id",
        "media_type",
        "byte_length",
        "schema_version"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "SchemaVersion": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "title": "SchemaVersion",
      "type": "string"
    },
    "StableId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "StableId",
      "type": "string"
    },
    "U6ACanaryJob": {
      "additionalProperties": false,
      "description": "One Track C/D or free-run job attached to an existing N-1 basis.",
      "properties": {
        "basis_id": {
          "$ref": "#/$defs/StableId"
        },
        "checkpoint_chapter": {
          "maximum": 300,
          "minimum": 1,
          "title": "Checkpoint Chapter",
          "type": "integer"
        },
        "future_visibility": {
          "const": "evaluator_only",
          "default": "evaluator_only",
          "title": "Future Visibility",
          "type": "string"
        },
        "job_id": {
          "$ref": "#/$defs/StableId"
        },
        "lifecycle": {
          "default": [
            "freeze",
            "release",
            "wcp",
            "writer",
            "response_freeze",
            "evaluator_reveal",
            "discard"
          ],
          "items": {
            "type": "string"
          },
          "title": "Lifecycle",
          "type": "array"
        },
        "release_policy": {
          "const": "after_basis_freeze",
          "default": "after_basis_freeze",
          "title": "Release Policy",
          "type": "string"
        },
        "status": {
          "default": "PLANNED",
          "enum": [
            "PLANNED",
            "EXECUTED",
            "REVIEW_REQUIRED"
          ],
          "title": "Status",
          "type": "string"
        },
        "track": {
          "$ref": "#/$defs/U6AReadoutTrack"
        }
      },
      "required": [
        "job_id",
        "track",
        "checkpoint_chapter",
        "basis_id"
      ],
      "title": "U6ACanaryJob",
      "type": "object"
    },
    "U6AReadoutTask": {
      "additionalProperties": false,
      "description": "One public QA/Context task released against one frozen basis.",
      "properties": {
        "basis_id": {
          "$ref": "#/$defs/StableId"
        },
        "checkpoint_chapter": {
          "maximum": 300,
          "minimum": 1,
          "title": "Checkpoint Chapter",
          "type": "integer"
        },
        "future_visibility": {
          "const": "evaluator_only",
          "default": "evaluator_only",
          "title": "Future Visibility",
          "type": "string"
        },
        "lifecycle": {
          "default": [
            "freeze",
            "release",
            "wcp",
            "writer",
            "response_freeze",
            "evaluator_reveal",
            "discard"
          ],
          "items": {
            "type": "string"
          },
          "title": "Lifecycle",
          "type": "array"
        },
        "source_task_id": {
          "$ref": "#/$defs/StableId"
        },
        "status": {
          "default": "PLANNED",
          "enum": [
            "PLANNED",
            "EXECUTED",
            "REVIEW_REQUIRED"
          ],
          "title": "Status",
          "type": "string"
        },
        "task_id": {
          "$ref": "#/$defs/StableId"
        },
        "track": {
          "enum": [
            "novelmem_qa",
            "novelmem_context"
          ],
          "title": "Track",
          "type": "string"
        }
      },
      "required": [
        "task_id",
        "track",
        "checkpoint_chapter",
        "basis_id",
        "source_task_id"
      ],
      "title": "U6AReadoutTask",
      "type": "object"
    },
    "U6AReadoutTrack": {
      "enum": [
        "novelmem_qa",
        "novelmem_context",
        "c_roll",
        "d_short",
        "free_run"
      ],
      "title": "U6AReadoutTrack",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "One immutable task/job plan consumed by the future real readout runner.",
  "properties": {
    "basis_manifest_ref": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "campaign_id": {
      "$ref": "#/$defs/StableId"
    },
    "canary_job_count": {
      "minimum": 0,
      "title": "Canary Job Count",
      "type": "integer"
    },
    "canary_jobs": {
      "items": {
        "$ref": "#/$defs/U6ACanaryJob"
      },
      "title": "Canary Jobs",
      "type": "array"
    },
    "context_task_count": {
      "minimum": 0,
      "title": "Context Task Count",
      "type": "integer"
    },
    "qa_task_count": {
      "minimum": 0,
      "title": "Qa Task Count",
      "type": "integer"
    },
    "schema": {
      "const": "u6a-readout-plan.v1",
      "default": "u6a-readout-plan.v1",
      "title": "Schema",
      "type": "string"
    },
    "source_readout_manifest_ref": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "status": {
      "enum": [
        "READY",
        "EXECUTED",
        "REVIEW_REQUIRED"
      ],
      "title": "Status",
      "type": "string"
    },
    "tasks": {
      "items": {
        "$ref": "#/$defs/U6AReadoutTask"
      },
      "title": "Tasks",
      "type": "array"
    }
  },
  "required": [
    "campaign_id",
    "basis_manifest_ref",
    "source_readout_manifest_ref",
    "tasks",
    "canary_jobs",
    "qa_task_count",
    "context_task_count",
    "canary_job_count",
    "status"
  ],
  "title": "U6AReadoutPlan",
  "type": "object"
}
