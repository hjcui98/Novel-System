{
  "$defs": {
    "QaEvidenceItem": {
      "additionalProperties": false,
      "description": "One Track A evidence pointer. Chapter must be at or before the cutoff.",
      "properties": {
        "chapter": {
          "maximum": 300,
          "minimum": 0,
          "title": "Chapter",
          "type": "integer"
        },
        "span": {
          "minLength": 1,
          "title": "Span",
          "type": "string"
        }
      },
      "required": [
        "chapter",
        "span"
      ],
      "title": "QaEvidenceItem",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Track A product main result: answer plus at most 20 history evidence items.",
  "properties": {
    "answer": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "boolean"
        },
        {
          "type": "integer"
        },
        {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      ],
      "title": "Answer"
    },
    "evidence": {
      "default": [],
      "items": {
        "$ref": "#/$defs/QaEvidenceItem"
      },
      "maxItems": 20,
      "title": "Evidence",
      "type": "array"
    }
  },
  "required": [
    "answer"
  ],
  "title": "QaWriterResponse",
  "type": "object"
}
