{
  "$defs": {
    "StableId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "StableId",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "accepted_reference_count": {
      "minimum": 0,
      "title": "Accepted Reference Count",
      "type": "integer"
    },
    "complete_alternative_ids": {
      "default": [],
      "items": {
        "$ref": "#/$defs/StableId"
      },
      "title": "Complete Alternative Ids",
      "type": "array"
    },
    "matched_reference_count": {
      "minimum": 0,
      "title": "Matched Reference Count",
      "type": "integer"
    },
    "partial_alternative_ids": {
      "default": [],
      "items": {
        "$ref": "#/$defs/StableId"
      },
      "title": "Partial Alternative Ids",
      "type": "array"
    }
  },
  "required": [
    "accepted_reference_count",
    "matched_reference_count"
  ],
  "title": "EvidenceStageCoverage",
  "type": "object"
}
