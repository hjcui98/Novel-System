{
  "$defs": {
    "ArtifactId": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "ArtifactId",
      "type": "string"
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/ArtifactId"
        },
        "byte_length": {
          "minimum": 0,
          "title": "Byte Length",
          "type": "integer"
        },
        "media_type": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "schema_version": {
          "$ref": "#/$defs/SchemaVersion"
        }
      },
      "required": [
        "artifact_id",
        "media_type",
        "byte_length",
        "schema_version"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "BenchmarkInformationProfile": {
      "enum": [
        "visible_at_cutoff",
        "task_intent_only",
        "author_plan_conditioned"
      ],
      "title": "BenchmarkInformationProfile",
      "type": "string"
    },
    "CheckpointGateMetricReport": {
      "additionalProperties": false,
      "properties": {
        "applicable_gold_count": {
          "minimum": 0,
          "title": "Applicable Gold Count",
          "type": "integer"
        },
        "arm": {
          "enum": [
            "A",
            "B",
            "C"
          ],
          "title": "Arm",
          "type": "string"
        },
        "assembly_status": {
          "$ref": "#/$defs/ContextAssemblyStatus"
        },
        "case_id": {
          "$ref": "#/$defs/StableId"
        },
        "checkpoint_chapter": {
          "minimum": 0,
          "title": "Checkpoint Chapter",
          "type": "integer"
        },
        "current_state": {
          "$ref": "#/$defs/GateMetricAxisResult"
        },
        "historical": {
          "$ref": "#/$defs/GateMetricAxisResult"
        },
        "mandatory_status_counts": {
          "additionalProperties": {
            "type": "integer"
          },
          "propertyNames": {
            "$ref": "#/$defs/GoldMatchStatus"
          },
          "title": "Mandatory Status Counts",
          "type": "object"
        },
        "operational_plan": {
          "$ref": "#/$defs/GateMetricAxisResult"
        },
        "typed_failure": {
          "title": "Typed Failure",
          "type": "boolean"
        }
      },
      "required": [
        "case_id",
        "checkpoint_chapter",
        "arm",
        "assembly_status",
        "typed_failure",
        "applicable_gold_count",
        "current_state",
        "operational_plan",
        "historical",
        "mandatory_status_counts"
      ],
      "title": "CheckpointGateMetricReport",
      "type": "object"
    },
    "ContextAssemblyStatus": {
      "enum": [
        "READY",
        "NEEDS_REDUCTION",
        "CONTEXT_BUDGET_INSUFFICIENT",
        "EVIDENCE_INSUFFICIENT",
        "POLICY_BLOCKED"
      ],
      "title": "ContextAssemblyStatus",
      "type": "string"
    },
    "EvidenceStageCoverage": {
      "additionalProperties": false,
      "properties": {
        "accepted_reference_count": {
          "minimum": 0,
          "title": "Accepted Reference Count",
          "type": "integer"
        },
        "complete_alternative_ids": {
          "default": [],
          "items": {
            "$ref": "#/$defs/StableId"
          },
          "title": "Complete Alternative Ids",
          "type": "array"
        },
        "matched_reference_count": {
          "minimum": 0,
          "title": "Matched Reference Count",
          "type": "integer"
        },
        "partial_alternative_ids": {
          "default": [],
          "items": {
            "$ref": "#/$defs/StableId"
          },
          "title": "Partial Alternative Ids",
          "type": "array"
        }
      },
      "required": [
        "accepted_reference_count",
        "matched_reference_count"
      ],
      "title": "EvidenceStageCoverage",
      "type": "object"
    },
    "EvidenceStageFailure": {
      "enum": [
        "COMPLETE",
        "F-ASSEMBLY",
        "F-RANK",
        "F-NEED_ROUTE_RETRIEVE",
        "F-CLAIM-EVALUATOR"
      ],
      "title": "EvidenceStageFailure",
      "type": "string"
    },
    "FiveSegmentReport": {
      "additionalProperties": false,
      "description": "Five-segment diagnostic view: goals, needs, evidence, completion, leakage.\n\nLeakage is reported separately and never folded into accuracy segments.\n``planner_fallback_rate`` and ``grounding_success_rate`` are the Gate 1\nplanning-health segments: the fallback share of Need-generation runs and\nthe GROUNDED share of all grounded entity mentions.",
      "properties": {
        "bindings": {
          "default": [],
          "items": {
            "$ref": "#/$defs/GoldNeedBinding"
          },
          "title": "Bindings",
          "type": "array"
        },
        "completion_accuracy": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Completion Accuracy"
        },
        "completion_availability": {
          "$ref": "#/$defs/SegmentAvailability",
          "default": "available"
        },
        "completion_gold_total": {
          "default": 0,
          "minimum": 0,
          "title": "Completion Gold Total",
          "type": "integer"
        },
        "completion_weight_total": {
          "default": 0.0,
          "minimum": 0.0,
          "title": "Completion Weight Total",
          "type": "number"
        },
        "evidence_recall": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence Recall"
        },
        "evidence_recall_availability": {
          "$ref": "#/$defs/SegmentAvailability",
          "default": "available"
        },
        "evidence_recall_matched": {
          "default": 0,
          "minimum": 0,
          "title": "Evidence Recall Matched",
          "type": "integer"
        },
        "evidence_recall_total": {
          "default": 0,
          "minimum": 0,
          "title": "Evidence Recall Total",
          "type": "integer"
        },
        "future_leakage_count": {
          "minimum": 0,
          "title": "Future Leakage Count",
          "type": "integer"
        },
        "grounded_status_counts": {
          "default": [
            0,
            0,
            0
          ],
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "integer"
            },
            {
              "type": "integer"
            },
            {
              "type": "integer"
            }
          ],
          "title": "Grounded Status Counts",
          "type": "array"
        },
        "grounding_success_rate": {
          "default": 1.0,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Grounding Success Rate",
          "type": "number"
        },
        "legacy_plan_obligation_coverage": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Legacy Plan Obligation Coverage"
        },
        "legacy_plan_obligation_unavailable_reason": {
          "default": "NOT_APPLICABLE_STRICT_D9",
          "title": "Legacy Plan Obligation Unavailable Reason",
          "type": "string"
        },
        "missing_spec_gold_ids": {
          "default": [],
          "items": {
            "$ref": "#/$defs/StableId"
          },
          "title": "Missing Spec Gold Ids",
          "type": "array"
        },
        "need_recall": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Need Recall"
        },
        "need_recall_availability": {
          "$ref": "#/$defs/SegmentAvailability",
          "default": "available"
        },
        "need_recall_matched": {
          "minimum": 0,
          "title": "Need Recall Matched",
          "type": "integer"
        },
        "need_recall_total": {
          "minimum": 0,
          "title": "Need Recall Total",
          "type": "integer"
        },
        "plan_citation_count": {
          "minimum": 0,
          "title": "Plan Citation Count",
          "type": "integer"
        },
        "plan_goal_availability": {
          "$ref": "#/$defs/SegmentAvailability",
          "default": "available"
        },
        "plan_goal_coverage": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Plan Goal Coverage"
        },
        "plan_goals_covered": {
          "minimum": 0,
          "title": "Plan Goals Covered",
          "type": "integer"
        },
        "plan_goals_total": {
          "minimum": 0,
          "title": "Plan Goals Total",
          "type": "integer"
        },
        "plan_leakage_count": {
          "minimum": 0,
          "title": "Plan Leakage Count",
          "type": "integer"
        },
        "planner_artifact_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "planner_fallback_rate": {
          "default": 0.0,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Planner Fallback Rate",
          "type": "number"
        },
        "planner_fallback_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Planner Fallback Reason"
        }
      },
      "required": [
        "plan_goals_total",
        "plan_goals_covered",
        "need_recall_total",
        "need_recall_matched",
        "future_leakage_count",
        "plan_citation_count",
        "plan_leakage_count"
      ],
      "title": "FiveSegmentReport",
      "type": "object"
    },
    "GateMetricAxis": {
      "enum": [
        "current_state_accuracy",
        "operational_plan_coverage",
        "key_historical_evidence_recall"
      ],
      "title": "GateMetricAxis",
      "type": "string"
    },
    "GateMetricAxisResult": {
      "additionalProperties": false,
      "properties": {
        "axis": {
          "$ref": "#/$defs/GateMetricAxis"
        },
        "denominator_weight": {
          "exclusiveMinimum": 0,
          "title": "Denominator Weight",
          "type": "number"
        },
        "item_count": {
          "minimum": 0,
          "title": "Item Count",
          "type": "integer"
        },
        "passed": {
          "title": "Passed",
          "type": "boolean"
        },
        "threshold": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Threshold",
          "type": "number"
        },
        "value": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Value",
          "type": "number"
        },
        "weighted_score_sum": {
          "minimum": 0,
          "title": "Weighted Score Sum",
          "type": "number"
        }
      },
      "required": [
        "axis",
        "item_count",
        "denominator_weight",
        "weighted_score_sum",
        "value",
        "threshold",
        "passed"
      ],
      "title": "GateMetricAxisResult",
      "type": "object"
    },
    "GoldBlindness": {
      "description": "Gold recoverability classification (semantic evaluation §5.7).",
      "enum": [
        "blind_recoverable",
        "plan_dependent",
        "hindsight_only"
      ],
      "title": "GoldBlindness",
      "type": "string"
    },
    "GoldMatchStatus": {
      "enum": [
        "HIT",
        "PARTIAL",
        "MISS",
        "CONTRADICTS",
        "UNTRACEABLE"
      ],
      "title": "GoldMatchStatus",
      "type": "string"
    },
    "GoldNeedBinding": {
      "additionalProperties": false,
      "description": "Evaluator-only, deterministic Gold -> one Need -> its Ledger subset.",
      "properties": {
        "availability": {
          "$ref": "#/$defs/SegmentAvailability",
          "default": "available"
        },
        "blindness": {
          "anyOf": [
            {
              "$ref": "#/$defs/GoldBlindness"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "eligible_ledger_ids": {
          "default": [],
          "items": {
            "$ref": "#/$defs/StableId"
          },
          "title": "Eligible Ledger Ids",
          "type": "array"
        },
        "entity_hits": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Entity Hits",
          "type": "array"
        },
        "entity_misses": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Entity Misses",
          "type": "array"
        },
        "facet_hits": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Facet Hits",
          "type": "array"
        },
        "facet_misses": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Facet Misses",
          "type": "array"
        },
        "full_need_match": {
          "default": false,
          "title": "Full Need Match",
          "type": "boolean"
        },
        "gold_id": {
          "$ref": "#/$defs/StableId"
        },
        "profile": {
          "$ref": "#/$defs/BenchmarkInformationProfile"
        },
        "scope_hits": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Scope Hits",
          "type": "array"
        },
        "scope_misses": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Scope Misses",
          "type": "array"
        },
        "selected_need_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/StableId"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "spec_hash": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactId"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "tie_break_evidence": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Tie Break Evidence",
          "type": "array"
        },
        "unavailable_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unavailable Reason"
        }
      },
      "required": [
        "profile",
        "gold_id"
      ],
      "title": "GoldNeedBinding",
      "type": "object"
    },
    "MemoryBenchmarkCaseArmReport": {
      "additionalProperties": false,
      "properties": {
        "arm": {
          "enum": [
            "A",
            "B",
            "C"
          ],
          "title": "Arm",
          "type": "string"
        },
        "assembly_status": {
          "$ref": "#/$defs/ContextAssemblyStatus"
        },
        "benchmark_contract_hash": {
          "$ref": "#/$defs/ArtifactId"
        },
        "case_id": {
          "$ref": "#/$defs/StableId"
        },
        "checkpoint_chapter": {
          "minimum": 0,
          "title": "Checkpoint Chapter",
          "type": "integer"
        },
        "code_version": {
          "minLength": 1,
          "title": "Code Version",
          "type": "string"
        },
        "comparable": {
          "title": "Comparable",
          "type": "boolean"
        },
        "evaluation": {
          "$ref": "#/$defs/MemoryBenchmarkEvaluationReport"
        },
        "evidence_ledger_token_budget": {
          "minimum": 1,
          "title": "Evidence Ledger Token Budget",
          "type": "integer"
        },
        "evidence_tokens": {
          "minimum": 0,
          "title": "Evidence Tokens",
          "type": "integer"
        },
        "matcher_version": {
          "minLength": 1,
          "title": "Matcher Version",
          "type": "string"
        },
        "run_config_hash": {
          "$ref": "#/$defs/ArtifactId"
        },
        "selected_unit_count": {
          "minimum": 0,
          "title": "Selected Unit Count",
          "type": "integer"
        },
        "writer_evidence_ledger_ref": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "writer_token_budget": {
          "minimum": 1,
          "title": "Writer Token Budget",
          "type": "integer"
        },
        "writer_tokens": {
          "minimum": 0,
          "title": "Writer Tokens",
          "type": "integer"
        }
      },
      "required": [
        "case_id",
        "checkpoint_chapter",
        "arm",
        "code_version",
        "run_config_hash",
        "benchmark_contract_hash",
        "matcher_version",
        "writer_token_budget",
        "evidence_ledger_token_budget",
        "assembly_status",
        "writer_tokens",
        "evidence_tokens",
        "selected_unit_count",
        "comparable",
        "writer_evidence_ledger_ref",
        "evaluation"
      ],
      "title": "MemoryBenchmarkCaseArmReport",
      "type": "object"
    },
    "MemoryBenchmarkEvaluationReport": {
      "additionalProperties": false,
      "properties": {
        "comparisons": {
          "items": {
            "$ref": "#/$defs/PerGoldComparison"
          },
          "title": "Comparisons",
          "type": "array"
        },
        "contradiction_rate": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Contradiction Rate",
          "type": "number"
        },
        "evaluator_manifest_hash": {
          "$ref": "#/$defs/ArtifactId"
        },
        "evaluator_manifest_id": {
          "$ref": "#/$defs/StableId"
        },
        "evaluator_manifest_ref": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "evaluator_version": {
          "minLength": 1,
          "title": "Evaluator Version",
          "type": "string"
        },
        "five_segments": {
          "anyOf": [
            {
              "$ref": "#/$defs/FiveSegmentReport"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "freeze_receipt_id": {
          "$ref": "#/$defs/StableId"
        },
        "gate_metric_formula_hash": {
          "$ref": "#/$defs/ArtifactId"
        },
        "gate_metric_formula_version": {
          "minLength": 1,
          "title": "Gate Metric Formula Version",
          "type": "string"
        },
        "mandatory_hit_rate": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Mandatory Hit Rate",
          "type": "number"
        },
        "profile": {
          "$ref": "#/$defs/BenchmarkInformationProfile"
        },
        "schema_version": {
          "$ref": "#/$defs/SchemaVersion",
          "default": "2.0.0"
        },
        "stage_loss_diagnostics": {
          "default": [],
          "items": {
            "$ref": "#/$defs/PerGoldStageLossDiagnostic"
          },
          "title": "Stage Loss Diagnostics",
          "type": "array"
        },
        "untraceable_rate": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Untraceable Rate",
          "type": "number"
        },
        "weighted_coverage": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Weighted Coverage",
          "type": "number"
        }
      },
      "required": [
        "evaluator_version",
        "profile",
        "comparisons",
        "weighted_coverage",
        "mandatory_hit_rate",
        "contradiction_rate",
        "untraceable_rate",
        "freeze_receipt_id",
        "evaluator_manifest_id",
        "evaluator_manifest_ref",
        "evaluator_manifest_hash",
        "gate_metric_formula_version",
        "gate_metric_formula_hash"
      ],
      "title": "MemoryBenchmarkEvaluationReport",
      "type": "object"
    },
    "PerGoldComparison": {
      "additionalProperties": false,
      "properties": {
        "explanation": {
          "minLength": 1,
          "title": "Explanation",
          "type": "string"
        },
        "gold_id": {
          "$ref": "#/$defs/StableId"
        },
        "gold_metric_descriptor_hash": {
          "$ref": "#/$defs/ArtifactId"
        },
        "gold_metric_descriptor_ref": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "mandatory": {
          "title": "Mandatory",
          "type": "boolean"
        },
        "matched_context_item_ids": {
          "default": [],
          "items": {
            "$ref": "#/$defs/StableId"
          },
          "title": "Matched Context Item Ids",
          "type": "array"
        },
        "matched_evidence_ledger_ids": {
          "default": [],
          "items": {
            "$ref": "#/$defs/StableId"
          },
          "title": "Matched Evidence Ledger Ids",
          "type": "array"
        },
        "missing_components": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Missing Components",
          "type": "array"
        },
        "status": {
          "$ref": "#/$defs/GoldMatchStatus"
        },
        "supported_components": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Supported Components",
          "type": "array"
        },
        "verifier_receipt_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "weight": {
          "exclusiveMinimum": 0,
          "title": "Weight",
          "type": "number"
        }
      },
      "required": [
        "gold_id",
        "status",
        "weight",
        "mandatory",
        "gold_metric_descriptor_ref",
        "gold_metric_descriptor_hash",
        "explanation"
      ],
      "title": "PerGoldComparison",
      "type": "object"
    },
    "PerGoldStageLossDiagnostic": {
      "additionalProperties": false,
      "description": "Evaluator-only accepted-evidence coverage across the frozen retrieval stages.",
      "properties": {
        "candidate": {
          "$ref": "#/$defs/EvidenceStageCoverage"
        },
        "gold_id": {
          "$ref": "#/$defs/StableId"
        },
        "primary_failure": {
          "$ref": "#/$defs/EvidenceStageFailure"
        },
        "rank_selected": {
          "$ref": "#/$defs/EvidenceStageCoverage"
        },
        "stage1_selected": {
          "$ref": "#/$defs/EvidenceStageCoverage"
        },
        "writer_ledger": {
          "$ref": "#/$defs/EvidenceStageCoverage"
        }
      },
      "required": [
        "gold_id",
        "candidate",
        "rank_selected",
        "stage1_selected",
        "writer_ledger",
        "primary_failure"
      ],
      "title": "PerGoldStageLossDiagnostic",
      "type": "object"
    },
    "SchemaVersion": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "title": "SchemaVersion",
      "type": "string"
    },
    "SegmentAvailability": {
      "enum": [
        "available",
        "unavailable"
      ],
      "title": "SegmentAvailability",
      "type": "string"
    },
