{
  "$defs": {
    "ArtifactId": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "ArtifactId",
      "type": "string"
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/ArtifactId"
        },
        "byte_length": {
          "minimum": 0,
          "title": "Byte Length",
          "type": "integer"
        },
        "media_type": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "schema_version": {
          "$ref": "#/$defs/SchemaVersion"
        }
      },
      "required": [
        "artifact_id",
        "media_type",
        "byte_length",
        "schema_version"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "ReferenceAsset": {
      "additionalProperties": false,
      "properties": {
        "artifact": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "asset_id": {
          "$ref": "#/$defs/StableId"
        },
        "source_class": {
          "$ref": "#/$defs/SourceClass"
        },
        "source_id": {
          "$ref": "#/$defs/StableId"
        },
        "title": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title"
        }
      },
      "required": [
        "asset_id",
        "source_id",
        "source_class",
        "artifact"
      ],
      "title": "ReferenceAsset",
      "type": "object"
    },
    "SchemaVersion": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "title": "SchemaVersion",
      "type": "string"
    },
    "SourceClass": {
      "enum": [
        "author_initial_brief",
        "author_known_future_plan",
        "baseline_setting",
        "chapter_text_n",
        "retrospective_summary",
        "future_text_private",
        "read_gold",
        "replay_gold",
        "style_guide",
        "external_reference"
      ],
      "title": "SourceClass",
      "type": "string"
    },
    "StableId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "StableId",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "assets": {
      "items": {
        "$ref": "#/$defs/ReferenceAsset"
      },
      "title": "Assets",
      "type": "array"
    },
    "root_hash": {
      "$ref": "#/$defs/ArtifactId"
    },
    "schema_version": {
      "$ref": "#/$defs/SchemaVersion"
    }
  },
  "required": [
    "root_hash",
    "schema_version",
    "assets"
  ],
  "title": "ReferenceRootDocument",
  "type": "object"
}
