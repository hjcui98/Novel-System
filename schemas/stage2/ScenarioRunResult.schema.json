{
  "$defs": {
    "AgentExecutionReceipt": {
      "additionalProperties": false,
      "properties": {
        "agent_mode": {
          "$ref": "#/$defs/AgentMode"
        },
        "agent_spec": {
          "$ref": "#/$defs/ContractRef"
        },
        "agent_type": {
          "$ref": "#/$defs/AgentType"
        },
        "base_commit": {
          "anyOf": [
            {
              "$ref": "#/$defs/CommitId"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "completed_at": {
          "format": "date-time",
          "title": "Completed At",
          "type": "string"
        },
        "configuration_fingerprint": {
          "$ref": "#/$defs/ArtifactId"
        },
        "escalations": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Escalations",
          "type": "array"
        },
        "input_artifacts": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          },
          "title": "Input Artifacts",
          "type": "array"
        },
        "latency_ms": {
          "minimum": 0,
          "title": "Latency Ms",
          "type": "integer"
        },
        "model_call_ids": {
          "default": [],
          "items": {
            "$ref": "#/$defs/StableId"
          },
          "title": "Model Call Ids",
          "type": "array"
        },
        "output_artifacts": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          },
          "title": "Output Artifacts",
          "type": "array"
        },
        "prompt_fingerprint": {
          "$ref": "#/$defs/ArtifactId"
        },
        "receipt_id": {
          "$ref": "#/$defs/StableId"
        },
        "run_id": {
          "$ref": "#/$defs/RunId"
        },
        "skill_receipts": {
          "default": [],
          "items": {
            "$ref": "#/$defs/SkillExecutionReceipt"
          },
          "title": "Skill Receipts",
          "type": "array"
        },
        "started_at": {
          "format": "date-time",
          "title": "Started At",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/ExecutionStatus"
        },
        "task_id": {
          "$ref": "#/$defs/TaskId"
        },
        "tool_call_ids": {
          "default": [],
          "items": {
            "$ref": "#/$defs/StableId"
          },
          "title": "Tool Call Ids",
          "type": "array"
        },
        "unresolved": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Unresolved",
          "type": "array"
        }
      },
      "required": [
        "receipt_id",
        "run_id",
        "task_id",
        "agent_spec",
        "agent_type",
        "agent_mode",
        "prompt_fingerprint",
        "configuration_fingerprint",
        "status",
        "started_at",
        "completed_at",
        "latency_ms"
      ],
      "title": "AgentExecutionReceipt",
      "type": "object"
    },
    "AgentMode": {
      "enum": [
        "project_bootstrap",
        "story",
        "arc_volume",
        "chapter",
        "scene",
        "replan",
        "bootstrap",
        "replay",
        "curator_repair",
        "bounded_r2",
        "risk_review",
        "draft",
        "continue",
        "major_rewrite",
        "review",
        "local_repair"
      ],
      "title": "AgentMode",
      "type": "string"
    },
    "AgentType": {
      "enum": [
        "planner",
        "memory_curator",
        "memory_controller",
        "memory_guardian",
        "writer",
        "editor"
      ],
      "title": "AgentType",
      "type": "string"
    },
    "ArtifactId": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "ArtifactId",
      "type": "string"
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/ArtifactId"
        },
        "byte_length": {
          "minimum": 0,
          "title": "Byte Length",
          "type": "integer"
        },
        "media_type": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "schema_version": {
          "$ref": "#/$defs/SchemaVersion"
        }
      },
      "required": [
        "artifact_id",
        "media_type",
        "byte_length",
        "schema_version"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "BenchmarkCheckpointBasis": {
      "additionalProperties": false,
      "properties": {
        "anchor_alias": {
          "minLength": 1,
          "title": "Anchor Alias",
          "type": "string"
        },
        "branch": {
          "minLength": 1,
          "title": "Branch",
          "type": "string"
        },
        "canonical_commit": {
          "$ref": "#/$defs/CommitId"
        },
        "case_id": {
          "$ref": "#/$defs/StableId"
        },
        "configuration_fingerprint": {
          "$ref": "#/$defs/ArtifactId"
        },
        "derived_snapshot_id": {
          "$ref": "#/$defs/StableId"
        },
        "future_isolation": {
          "$ref": "#/$defs/FutureIsolationAttestation"
        },
        "grounded_alias": {
          "minLength": 1,
          "title": "Grounded Alias",
          "type": "string"
        },
        "last_revealed_chapter": {
          "minimum": 0,
          "title": "Last Revealed Chapter",
          "type": "integer"
        },
        "plan_root": {
          "$ref": "#/$defs/ArtifactId"
        },
        "project_id": {
          "$ref": "#/$defs/ProjectId"
        },
        "project_profile": {
          "$ref": "#/$defs/ArtifactId"
        },
        "r1_basis_commit": {
          "$ref": "#/$defs/CommitId"
        },
        "state_build_receipt_chain_hash": {
          "$ref": "#/$defs/ArtifactId"
        },
        "text_root": {
          "$ref": "#/$defs/ArtifactId"
        },
        "world_root": {
          "$ref": "#/$defs/ArtifactId"
        }
      },
      "required": [
        "case_id",
        "project_id",
        "branch",
        "canonical_commit",
        "text_root",
        "plan_root",
        "world_root",
        "derived_snapshot_id",
        "r1_basis_commit",
        "anchor_alias",
        "grounded_alias",
        "project_profile",
        "configuration_fingerprint",
        "last_revealed_chapter",
        "future_isolation",
        "state_build_receipt_chain_hash"
      ],
      "title": "BenchmarkCheckpointBasis",
      "type": "object"
    },
    "ChapterStateBuildReceipt": {
      "additionalProperties": false,
      "properties": {
        "chain_hash": {
          "$ref": "#/$defs/ArtifactId"
        },
        "chapter_index": {
          "minimum": 0,
          "title": "Chapter Index",
          "type": "integer"
        },
        "curator_receipt": {
          "$ref": "#/$defs/AgentExecutionReceipt"
        },
        "parent_commit": {
          "$ref": "#/$defs/CommitId"
        },
        "previous_chain_hash": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactId"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "project_id": {
          "$ref": "#/$defs/ProjectId"
        },
        "projection_snapshot_id": {
          "$ref": "#/$defs/StableId"
        },
        "receipt_id": {
          "$ref": "#/$defs/StableId"
        },
        "resulting_commit": {
          "$ref": "#/$defs/CommitId"
        },
        "source_id": {
          "$ref": "#/$defs/StableId"
        },
        "validation_artifact": {
          "$ref": "#/$defs/ArtifactRef"
        }
      },
      "required": [
        "receipt_id",
        "project_id",
        "chapter_index",
        "parent_commit",
        "resulting_commit",
        "source_id",
        "curator_receipt",
        "validation_artifact",
        "projection_snapshot_id",
        "chain_hash"
      ],
      "title": "ChapterStateBuildReceipt",
      "type": "object"
    },
    "CommitId": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "CommitId",
      "type": "string"
    },
    "ContextFreezeReceipt": {
      "additionalProperties": false,
      "properties": {
        "canonical_commit": {
          "$ref": "#/$defs/CommitId"
        },
        "case_id": {
          "$ref": "#/$defs/StableId"
        },
        "checkpoint_chapter": {
          "minimum": 1,
          "title": "Checkpoint Chapter",
          "type": "integer"
        },
        "configuration_fingerprint": {
          "$ref": "#/$defs/ArtifactId"
        },
        "context_artifact": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "freeze_id": {
          "$ref": "#/$defs/StableId"
        },
        "frozen_at": {
          "format": "date-time",
          "title": "Frozen At",
          "type": "string"
        },
        "snapshot_id": {
          "$ref": "#/$defs/StableId"
        }
      },
      "required": [
        "freeze_id",
        "case_id",
        "checkpoint_chapter",
        "canonical_commit",
        "snapshot_id",
        "context_artifact",
        "configuration_fingerprint",
        "frozen_at"
      ],
      "title": "ContextFreezeReceipt",
      "type": "object"
    },
    "ContractRef": {
      "additionalProperties": false,
      "properties": {
        "content_hash": {
          "$ref": "#/$defs/ArtifactId"
        },
        "contract_id": {
          "$ref": "#/$defs/StableId"
        },
        "version": {
          "$ref": "#/$defs/SchemaVersion"
        }
      },
      "required": [
        "contract_id",
        "version",
        "content_hash"
      ],
      "title": "ContractRef",
      "type": "object"
    },
    "EvaluatorRevealReceipt": {
      "additionalProperties": false,
      "properties": {
        "canonical_write_count": {
          "default": 0,
          "maximum": 0,
          "minimum": 0,
          "title": "Canonical Write Count",
          "type": "integer"
        },
        "completed_at": {
          "format": "date-time",
          "title": "Completed At",
          "type": "string"
        },
        "evaluator_context_destroyed": {
          "title": "Evaluator Context Destroyed",
          "type": "boolean"
        },
        "evaluator_source_ids": {
          "items": {
            "$ref": "#/$defs/StableId"
          },
          "minItems": 1,
          "title": "Evaluator Source Ids",
          "type": "array"
        },
        "freeze_id": {
          "$ref": "#/$defs/StableId"
        },
        "reveal_id": {
          "$ref": "#/$defs/StableId"
        },
        "score_artifacts": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          },
          "title": "Score Artifacts",
          "type": "array"
        }
      },
      "required": [
        "reveal_id",
        "freeze_id",
        "evaluator_source_ids",
        "evaluator_context_destroyed",
        "completed_at"
      ],
      "title": "EvaluatorRevealReceipt",
      "type": "object"
    },
    "ExecutionStatus": {
      "enum": [
        "succeeded",
        "failed",
        "suspended",
        "rejected"
      ],
      "title": "ExecutionStatus",
      "type": "string"
    },
    "FutureIsolationAttestation": {
      "additionalProperties": false,
      "properties": {
        "attestation_id": {
          "$ref": "#/$defs/StableId"
        },
        "canonical_source_ids": {
          "items": {
            "$ref": "#/$defs/StableId"
          },
          "title": "Canonical Source Ids",
          "type": "array"
        },
        "checkpoint_chapter": {
          "minimum": 0,
          "title": "Checkpoint Chapter",
          "type": "integer"
        },
        "configuration_fingerprint": {
          "$ref": "#/$defs/ArtifactId"
        },
        "evaluator_only_source_ids": {
          "items": {
            "$ref": "#/$defs/StableId"
          },
          "title": "Evaluator Only Source Ids",
          "type": "array"
        },
        "overlap_source_ids": {
          "default": [],
          "items": {
            "$ref": "#/$defs/StableId"
          },
          "title": "Overlap Source Ids",
          "type": "array"
        },
        "passed": {
          "title": "Passed",
          "type": "boolean"
        }
      },
      "required": [
        "attestation_id",
        "checkpoint_chapter",
        "canonical_source_ids",
        "evaluator_only_source_ids",
        "passed",
        "configuration_fingerprint"
      ],
      "title": "FutureIsolationAttestation",
      "type": "object"
    },
    "ProjectId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "ProjectId",
      "type": "string"
    },
    "RunId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "RunId",
      "type": "string"
    },
    "ScenarioBuildMode": {
      "enum": [
        "continuous_replay",
        "independent_rebuild"
      ],
      "title": "ScenarioBuildMode",
      "type": "string"
    },
    "SchemaVersion": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "title": "SchemaVersion",
      "type": "string"
    },
    "SkillContractRef": {
      "additionalProperties": false,
      "properties": {
        "content_hash": {
          "$ref": "#/$defs/ArtifactId"
        },
        "contract_id": {
          "$ref": "#/$defs/StableId"
        },
        "version": {
          "$ref": "#/$defs/SchemaVersion"
        }
      },
      "required": [
        "contract_id",
        "version",
        "content_hash"
      ],
      "title": "SkillContractRef",
      "type": "object"
    },
    "SkillExecutionReceipt": {
      "additionalProperties": false,
      "properties": {
        "agent_mode": {
          "$ref": "#/$defs/AgentMode"
        },
        "agent_type": {
          "$ref": "#/$defs/AgentType"
        },
        "base_commit": {
          "anyOf": [
            {
              "$ref": "#/$defs/CommitId"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "completed_checkpoints": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Completed Checkpoints",
          "type": "array"
        },
        "context_manifest": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactId"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "escalations": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Escalations",
          "type": "array"
        },
        "input_artifacts": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          },
          "title": "Input Artifacts",
          "type": "array"
        },
        "latency_ms": {
          "minimum": 0,
          "title": "Latency Ms",
          "type": "integer"
        },
        "output_artifacts": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          },
          "title": "Output Artifacts",
          "type": "array"
        },
        "receipt_id": {
          "$ref": "#/$defs/StableId"
        },
        "run_id": {
          "$ref": "#/$defs/RunId"
        },
        "skill": {
          "$ref": "#/$defs/SkillContractRef"
        },
        "skipped_checkpoints": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Skipped Checkpoints",
          "type": "array"
        },
        "status": {
          "$ref": "#/$defs/ExecutionStatus"
        },
        "task_id": {
          "$ref": "#/$defs/TaskId"
        },
        "tool_call_ids": {
          "default": [],
          "items": {
            "$ref": "#/$defs/StableId"
          },
          "title": "Tool Call Ids",
          "type": "array"
        },
        "unresolved": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Unresolved",
          "type": "array"
        }
      },
      "required": [
        "receipt_id",
        "run_id",
        "task_id",
        "skill",
        "agent_type",
        "agent_mode",
        "status",
        "latency_ms"
      ],
      "title": "SkillExecutionReceipt",
      "type": "object"
    },
    "StableId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "StableId",
      "type": "string"
    },
    "TaskId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "TaskId",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "blockers": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Blockers",
      "type": "array"
    },
    "build_mode": {
      "$ref": "#/$defs/ScenarioBuildMode"
    },
    "chapter_receipts": {
      "items": {
        "$ref": "#/$defs/ChapterStateBuildReceipt"
      },
      "title": "Chapter Receipts",
      "type": "array"
    },
    "checkpoints": {
      "items": {
        "$ref": "#/$defs/BenchmarkCheckpointBasis"
      },
      "title": "Checkpoints",
      "type": "array"
    },
    "completed": {
      "title": "Completed",
      "type": "boolean"
    },
    "evaluator_reveals": {
      "default": [],
      "items": {
        "$ref": "#/$defs/EvaluatorRevealReceipt"
      },
      "title": "Evaluator Reveals",
      "type": "array"
    },
    "freezes": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ContextFreezeReceipt"
      },
      "title": "Freezes",
      "type": "array"
    },
    "project_id": {
      "$ref": "#/$defs/ProjectId"
    },
    "scenario_id": {
      "$ref": "#/$defs/StableId"
    }
  },
  "required": [
    "scenario_id",
    "project_id",
    "build_mode",
    "chapter_receipts",
    "checkpoints",
    "completed"
  ],
  "title": "ScenarioRunResult",
  "type": "object"
}
