{
  "$defs": {
    "ArtifactId": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "ArtifactId",
      "type": "string"
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/ArtifactId"
        },
        "byte_length": {
          "minimum": 0,
          "title": "Byte Length",
          "type": "integer"
        },
        "media_type": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "schema_version": {
          "$ref": "#/$defs/SchemaVersion"
        }
      },
      "required": [
        "artifact_id",
        "media_type",
        "byte_length",
        "schema_version"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "FailureLedgerEntry": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "failure_id": {
          "$ref": "#/$defs/StableId"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "occurred_at": {
          "format": "date-time",
          "title": "Occurred At",
          "type": "string"
        },
        "run_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/RunId"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "severity": {
          "$ref": "#/$defs/FailureSeverity"
        },
        "source_artifacts": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          },
          "title": "Source Artifacts",
          "type": "array"
        },
        "task_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/TaskId"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "failure_id",
        "code",
        "severity",
        "message",
        "occurred_at"
      ],
      "title": "FailureLedgerEntry",
      "type": "object"
    },
    "FailureLedgerType": {
      "enum": [
        "bootstrap",
        "controller",
        "curator"
      ],
      "title": "FailureLedgerType",
      "type": "string"
    },
    "FailureSeverity": {
      "enum": [
        "warning",
        "error",
        "blocker"
      ],
      "title": "FailureSeverity",
      "type": "string"
    },
    "RunId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "RunId",
      "type": "string"
    },
    "SchemaVersion": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "title": "SchemaVersion",
      "type": "string"
    },
    "StableId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "StableId",
      "type": "string"
    },
    "TaskId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "TaskId",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "configuration_fingerprint": {
      "$ref": "#/$defs/ArtifactId"
    },
    "entries": {
      "items": {
        "$ref": "#/$defs/FailureLedgerEntry"
      },
      "title": "Entries",
      "type": "array"
    },
    "ledger_id": {
      "$ref": "#/$defs/StableId"
    },
    "ledger_type": {
      "$ref": "#/$defs/FailureLedgerType"
    }
  },
  "required": [
    "ledger_id",
    "ledger_type",
    "configuration_fingerprint",
    "entries"
  ],
  "title": "FailureLedgerDocument",
  "type": "object"
}
