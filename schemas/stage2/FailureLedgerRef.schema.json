{
  "$defs": {
    "ArtifactId": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "ArtifactId",
      "type": "string"
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/ArtifactId"
        },
        "byte_length": {
          "minimum": 0,
          "title": "Byte Length",
          "type": "integer"
        },
        "media_type": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "schema_version": {
          "$ref": "#/$defs/SchemaVersion"
        }
      },
      "required": [
        "artifact_id",
        "media_type",
        "byte_length",
        "schema_version"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "FailureLedgerType": {
      "enum": [
        "bootstrap",
        "controller",
        "curator"
      ],
      "title": "FailureLedgerType",
      "type": "string"
    },
    "SchemaVersion": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "title": "SchemaVersion",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "artifact": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "entry_count": {
      "minimum": 0,
      "title": "Entry Count",
      "type": "integer"
    },
    "ledger_type": {
      "$ref": "#/$defs/FailureLedgerType"
    }
  },
  "required": [
    "ledger_type",
    "artifact",
    "entry_count"
  ],
  "title": "FailureLedgerRef",
  "type": "object"
}
