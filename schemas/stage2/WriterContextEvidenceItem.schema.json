{
  "$defs": {
    "ArtifactId": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "ArtifactId",
      "type": "string"
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/ArtifactId"
        },
        "byte_length": {
          "minimum": 0,
          "title": "Byte Length",
          "type": "integer"
        },
        "media_type": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "schema_version": {
          "$ref": "#/$defs/SchemaVersion"
        }
      },
      "required": [
        "artifact_id",
        "media_type",
        "byte_length",
        "schema_version"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "EvidenceFirstGap": {
      "additionalProperties": false,
      "properties": {
        "gap_id": {
          "$ref": "#/$defs/StableId"
        },
        "kind": {
          "$ref": "#/$defs/EvidenceGapKind"
        },
        "need_facet_ids": {
          "items": {
            "$ref": "#/$defs/StableId"
          },
          "title": "Need Facet Ids",
          "type": "array"
        },
        "need_ids": {
          "items": {
            "$ref": "#/$defs/StableId"
          },
          "title": "Need Ids",
          "type": "array"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "gap_id",
        "need_ids",
        "need_facet_ids",
        "kind",
        "reason"
      ],
      "title": "EvidenceFirstGap",
      "type": "object"
    },
    "EvidenceGapKind": {
      "enum": [
        "no_selected_evidence",
        "budget_exceeded",
        "slice_oversized",
        "cutoff_tainted",
        "scope_tainted",
        "dereference_failed",
        "heading_source_role",
        "semantic_partial",
        "semantic_unsupported",
        "semantic_unresolved"
      ],
      "title": "EvidenceGapKind",
      "type": "string"
    },
    "NeedEvidenceSemanticStatus": {
      "description": "Model relevance verdict for one public Need/facet evidence set.",
      "enum": [
        "SUPPORTED",
        "PARTIAL",
        "UNSUPPORTED",
        "UNRESOLVED"
      ],
      "title": "NeedEvidenceSemanticStatus",
      "type": "string"
    },
    "SchemaVersion": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "title": "SchemaVersion",
      "type": "string"
    },
    "StableId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "StableId",
      "type": "string"
    },
    "WriterContextSection": {
      "enum": [
        "continuity_constraints",
        "current_world_state",
        "relationship_and_emotion",
        "causal_history",
        "knowledge_and_disclosure",
        "plan_and_obligations",
        "long_range_callbacks"
      ],
      "title": "WriterContextSection",
      "type": "string"
    },
    "WriterContextValidity": {
      "enum": [
        "current",
        "historical",
        "planned",
        "uncertain"
      ],
      "title": "WriterContextValidity",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Writer-visible evidence item: purpose plus ledger refs or a typed gap.\n\n``purpose`` is derived only from the public Need's semantic question /\nwhy-needed / facet metadata; it never rewrites material into a claim and\nnever reads Gold or future text.  ``raw_preview`` is a bounded prefix of\nthe exact Ledger text (never a model rewrite) with an explicit truncation\nflag.",
  "properties": {
    "advisory_artifact_refs": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ArtifactRef"
      },
      "title": "Advisory Artifact Refs",
      "type": "array"
    },
    "evidence_ledger_ids": {
      "default": [],
      "items": {
        "$ref": "#/$defs/StableId"
      },
      "title": "Evidence Ledger Ids",
      "type": "array"
    },
    "gap": {
      "anyOf": [
        {
          "$ref": "#/$defs/EvidenceFirstGap"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "item_id": {
      "$ref": "#/$defs/StableId"
    },
    "mandatory": {
      "default": false,
      "title": "Mandatory",
      "type": "boolean"
    },
    "need_facet_ids": {
      "items": {
        "$ref": "#/$defs/StableId"
      },
      "title": "Need Facet Ids",
      "type": "array"
    },
    "need_ids": {
      "items": {
        "$ref": "#/$defs/StableId"
      },
      "title": "Need Ids",
      "type": "array"
    },
    "preview_truncated": {
      "default": false,
      "title": "Preview Truncated",
      "type": "boolean"
    },
    "purpose": {
      "minLength": 1,
      "title": "Purpose",
      "type": "string"
    },
    "raw_preview": {
      "default": "",
      "title": "Raw Preview",
      "type": "string"
    },
    "section": {
      "$ref": "#/$defs/WriterContextSection"
    },
    "selection_reason": {
      "default": "",
      "title": "Selection Reason",
      "type": "string"
    },
    "semantic_answering_ledger_ids": {
      "default": [],
      "items": {
        "$ref": "#/$defs/StableId"
      },
      "title": "Semantic Answering Ledger Ids",
      "type": "array"
    },
    "semantic_partial_ledger_ids": {
      "default": [],
      "items": {
        "$ref": "#/$defs/StableId"
      },
      "title": "Semantic Partial Ledger Ids",
      "type": "array"
    },
    "semantic_related_ledger_ids": {
      "default": [],
      "items": {
        "$ref": "#/$defs/StableId"
      },
      "title": "Semantic Related Ledger Ids",
      "type": "array"
    },
    "semantic_status": {
      "anyOf": [
        {
          "$ref": "#/$defs/NeedEvidenceSemanticStatus"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "source_kind": {
      "default": "",
      "title": "Source Kind",
      "type": "string"
    },
    "source_scope": {
      "default": "",
      "title": "Source Scope",
      "type": "string"
    },
    "unverified": {
      "default": false,
      "title": "Unverified",
      "type": "boolean"
    },
    "validity": {
      "$ref": "#/$defs/WriterContextValidity",
      "default": "uncertain"
    }
  },
  "required": [
    "item_id",
    "section",
    "need_ids",
    "need_facet_ids",
    "purpose"
  ],
  "title": "WriterContextEvidenceItem",
  "type": "object"
}
