{
  "$defs": {
    "BudgetResolutionProfile": {
      "enum": [
        "canary",
        "strict"
      ],
      "title": "BudgetResolutionProfile",
      "type": "string"
    },
    "U4L0CanaryVariableLock": {
      "additionalProperties": false,
      "description": "One frozen U4-L0 variable vector carried by campaign evidence.",
      "properties": {
        "budget_profile": {
          "$ref": "#/$defs/BudgetResolutionProfile"
        },
        "c3_admission": {
          "const": "NOT_ADMITTED",
          "default": "NOT_ADMITTED",
          "title": "C3 Admission",
          "type": "string"
        },
        "controller_context_level": {
          "enum": [
            "C0",
            "C1+C2"
          ],
          "title": "Controller Context Level",
          "type": "string"
        },
        "planner_context_level": {
          "enum": [
            "P0",
            "P0+P1"
          ],
          "title": "Planner Context Level",
          "type": "string"
        },
        "thinking_enabled": {
          "title": "Thinking Enabled",
          "type": "boolean"
        }
      },
      "required": [
        "budget_profile",
        "controller_context_level",
        "planner_context_level",
        "thinking_enabled"
      ],
      "title": "U4L0CanaryVariableLock",
      "type": "object"
    },
    "V05CampaignThreshold": {
      "additionalProperties": false,
      "properties": {
        "metric": {
          "minLength": 1,
          "title": "Metric",
          "type": "string"
        },
        "operator": {
          "enum": [
            ">=",
            "<=",
            "=="
          ],
          "title": "Operator",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "metric",
        "operator",
        "value"
      ],
      "title": "V05CampaignThreshold",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Report dimensions and any thresholds registered before candidate runs.",
  "properties": {
    "canary_lock": {
      "anyOf": [
        {
          "$ref": "#/$defs/U4L0CanaryVariableLock"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "dimensions": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Dimensions",
      "type": "array"
    },
    "threshold_policy": {
      "enum": [
        "diagnostic_only",
        "pre_registered"
      ],
      "title": "Threshold Policy",
      "type": "string"
    },
    "thresholds": {
      "default": [],
      "items": {
        "$ref": "#/$defs/V05CampaignThreshold"
      },
      "title": "Thresholds",
      "type": "array"
    }
  },
  "required": [
    "dimensions",
    "threshold_policy"
  ],
  "title": "V05CampaignReportFreeze",
  "type": "object"
}
