{
  "$defs": {
    "ArtifactId": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "ArtifactId",
      "type": "string"
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/ArtifactId"
        },
        "byte_length": {
          "minimum": 0,
          "title": "Byte Length",
          "type": "integer"
        },
        "media_type": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "schema_version": {
          "$ref": "#/$defs/SchemaVersion"
        }
      },
      "required": [
        "artifact_id",
        "media_type",
        "byte_length",
        "schema_version"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "SchemaVersion": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "title": "SchemaVersion",
      "type": "string"
    },
    "StableId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "StableId",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Content-addressed identity of the private Gold set revealed after freeze.",
  "properties": {
    "ancestry_proof_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/ArtifactRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "evaluator_manifest_id": {
      "$ref": "#/$defs/StableId"
    },
    "gold_ids": {
      "items": {
        "$ref": "#/$defs/StableId"
      },
      "title": "Gold Ids",
      "type": "array"
    },
    "manifest_version": {
      "minLength": 1,
      "title": "Manifest Version",
      "type": "string"
    }
  },
  "required": [
    "manifest_version",
    "evaluator_manifest_id",
    "gold_ids"
  ],
  "title": "EvaluatorManifestContract",
  "type": "object"
}
