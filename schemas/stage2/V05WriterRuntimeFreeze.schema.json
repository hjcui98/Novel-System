{
  "$defs": {
    "ArtifactId": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "ArtifactId",
      "type": "string"
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/ArtifactId"
        },
        "byte_length": {
          "minimum": 0,
          "title": "Byte Length",
          "type": "integer"
        },
        "media_type": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "schema_version": {
          "$ref": "#/$defs/SchemaVersion"
        }
      },
      "required": [
        "artifact_id",
        "media_type",
        "byte_length",
        "schema_version"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "SchemaVersion": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "title": "SchemaVersion",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Writer request identity and fixed transport budgets.",
  "properties": {
    "concurrency": {
      "minimum": 1,
      "title": "Concurrency",
      "type": "integer"
    },
    "endpoint": {
      "minLength": 1,
      "title": "Endpoint",
      "type": "string"
    },
    "evidence_token_budget": {
      "minimum": 0,
      "title": "Evidence Token Budget",
      "type": "integer"
    },
    "model": {
      "minLength": 1,
      "title": "Model",
      "type": "string"
    },
    "output_token_budget": {
      "minimum": 1,
      "title": "Output Token Budget",
      "type": "integer"
    },
    "prompt_ref": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "provider_total_output_budget": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Provider Total Output Budget"
    },
    "request_role": {
      "minLength": 1,
      "title": "Request Role",
      "type": "string"
    },
    "response_schema_ref": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "revision": {
      "minLength": 1,
      "title": "Revision",
      "type": "string"
    },
    "seed": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Seed"
    },
    "seed_capability": {
      "enum": [
        "fixed",
        "unsupported",
        "uncontrolled"
      ],
      "title": "Seed Capability",
      "type": "string"
    },
    "temperature": {
      "maximum": 2.0,
      "minimum": 0.0,
      "title": "Temperature",
      "type": "number"
    }
  },
  "required": [
    "endpoint",
    "model",
    "revision",
    "prompt_ref",
    "response_schema_ref",
    "request_role",
    "temperature",
    "seed_capability",
    "evidence_token_budget",
    "output_token_budget",
    "concurrency"
  ],
  "title": "V05WriterRuntimeFreeze",
  "type": "object"
}
