{
  "$defs": {
    "PlanUnresolvedKind": {
      "enum": [
        "AUTHOR_INTENT_CONFLICT",
        "CURRENT_STATE_UNKNOWN",
        "POWER_LEVEL_UNKNOWN",
        "KNOWLEDGE_BOUNDARY_UNKNOWN",
        "OBLIGATION_WINDOW_CONFLICT",
        "UNSPECIFIED"
      ],
      "title": "PlanUnresolvedKind",
      "type": "string"
    },
    "StableId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "StableId",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Structured planning unknown that can block the current window.",
  "properties": {
    "affected_chapters": {
      "default": [],
      "items": {
        "type": "integer"
      },
      "title": "Affected Chapters",
      "type": "array"
    },
    "allowed_assumptions": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Allowed Assumptions",
      "type": "array"
    },
    "blocking": {
      "default": false,
      "title": "Blocking",
      "type": "boolean"
    },
    "forbidden_assumptions": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Forbidden Assumptions",
      "type": "array"
    },
    "issue_id": {
      "$ref": "#/$defs/StableId"
    },
    "kind": {
      "$ref": "#/$defs/PlanUnresolvedKind",
      "default": "UNSPECIFIED"
    },
    "resolution_owner": {
      "default": "PLANNER",
      "title": "Resolution Owner",
      "type": "string"
    },
    "summary": {
      "minLength": 1,
      "title": "Summary",
      "type": "string"
    }
  },
  "required": [
    "issue_id",
    "summary"
  ],
  "title": "PlanUnresolvedIssue",
  "type": "object"
}
