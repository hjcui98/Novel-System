{
  "$defs": {
    "ArtifactId": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "ArtifactId",
      "type": "string"
    },
    "CommitId": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "CommitId",
      "type": "string"
    },
    "StableId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "StableId",
      "type": "string"
    },
    "WorldRecordKind": {
      "enum": [
        "entity",
        "event",
        "state",
        "relation",
        "obligation"
      ],
      "title": "WorldRecordKind",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "base_commit": {
      "$ref": "#/$defs/CommitId"
    },
    "merged_evidence_hashes": {
      "items": {
        "$ref": "#/$defs/ArtifactId"
      },
      "minItems": 1,
      "title": "Merged Evidence Hashes",
      "type": "array"
    },
    "record_kind": {
      "$ref": "#/$defs/WorldRecordKind"
    },
    "semantic_hash": {
      "$ref": "#/$defs/ArtifactId"
    },
    "source_operation_hashes": {
      "items": {
        "$ref": "#/$defs/ArtifactId"
      },
      "minItems": 2,
      "title": "Source Operation Hashes",
      "type": "array"
    },
    "target_id": {
      "$ref": "#/$defs/StableId"
    },
    "transform_id": {
      "$ref": "#/$defs/StableId"
    }
  },
  "required": [
    "transform_id",
    "base_commit",
    "record_kind",
    "target_id",
    "semantic_hash",
    "source_operation_hashes",
    "merged_evidence_hashes"
  ],
  "title": "ProposalEvidenceMergeReceipt",
  "type": "object"
}
