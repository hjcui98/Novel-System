{
  "$defs": {
    "ArtifactId": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "ArtifactId",
      "type": "string"
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/ArtifactId"
        },
        "byte_length": {
          "minimum": 0,
          "title": "Byte Length",
          "type": "integer"
        },
        "media_type": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "schema_version": {
          "$ref": "#/$defs/SchemaVersion"
        }
      },
      "required": [
        "artifact_id",
        "media_type",
        "byte_length",
        "schema_version"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "CommitId": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "CommitId",
      "type": "string"
    },
    "SchemaVersion": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "title": "SchemaVersion",
      "type": "string"
    },
    "StableId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "StableId",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "approval_request_id": {
      "$ref": "#/$defs/StableId"
    },
    "base_commit": {
      "$ref": "#/$defs/CommitId"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "latest_rejected_draft_ref": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "latest_rejection_ref": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "proposal_attempt_refs": {
      "items": {
        "$ref": "#/$defs/ArtifactRef"
      },
      "minItems": 1,
      "title": "Proposal Attempt Refs",
      "type": "array"
    },
    "safe_feedback": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Safe Feedback",
      "type": "array"
    },
    "workflow_request_id": {
      "$ref": "#/$defs/StableId"
    }
  },
  "required": [
    "approval_request_id",
    "workflow_request_id",
    "base_commit",
    "proposal_attempt_refs",
    "latest_rejected_draft_ref",
    "latest_rejection_ref",
    "created_at"
  ],
  "title": "ProposalHumanReviewRequest",
  "type": "object"
}
