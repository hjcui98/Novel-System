{
  "$defs": {
    "ArtifactId": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "ArtifactId",
      "type": "string"
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/ArtifactId"
        },
        "byte_length": {
          "minimum": 0,
          "title": "Byte Length",
          "type": "integer"
        },
        "media_type": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "schema_version": {
          "$ref": "#/$defs/SchemaVersion"
        }
      },
      "required": [
        "artifact_id",
        "media_type",
        "byte_length",
        "schema_version"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "PlanningProvenance": {
      "enum": [
        "author_supplied",
        "accepted_plan_derived",
        "canon_derived",
        "reviewer_derived",
        "planner_proposed"
      ],
      "title": "PlanningProvenance",
      "type": "string"
    },
    "PlanningReference": {
      "additionalProperties": false,
      "properties": {
        "artifact_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          },
          "title": "Artifact Refs",
          "type": "array"
        },
        "provenance": {
          "$ref": "#/$defs/PlanningProvenance"
        },
        "reference_ids": {
          "default": [],
          "items": {
            "$ref": "#/$defs/StableId"
          },
          "title": "Reference Ids",
          "type": "array"
        }
      },
      "required": [
        "provenance"
      ],
      "title": "PlanningReference",
      "type": "object"
    },
    "SchemaVersion": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "title": "SchemaVersion",
      "type": "string"
    },
    "StableId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "StableId",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "decision_criteria": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Decision Criteria",
      "type": "array"
    },
    "goal_id": {
      "$ref": "#/$defs/StableId"
    },
    "provenance": {
      "$ref": "#/$defs/PlanningReference"
    },
    "rationale": {
      "minLength": 1,
      "title": "Rationale",
      "type": "string"
    },
    "summary": {
      "minLength": 1,
      "title": "Summary",
      "type": "string"
    }
  },
  "required": [
    "goal_id",
    "summary",
    "rationale",
    "provenance"
  ],
  "title": "GoalProposal",
  "type": "object"
}
