{
  "$defs": {
    "ArtifactId": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "ArtifactId",
      "type": "string"
    },
    "CommitId": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "CommitId",
      "type": "string"
    },
    "EvidenceRef": {
      "additionalProperties": false,
      "properties": {
        "chapter_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/StableId"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "evidence_id": {
          "$ref": "#/$defs/StableId"
        },
        "object_hash": {
          "$ref": "#/$defs/ArtifactId"
        },
        "quote_hash": {
          "anyOf": [
            {
              "$ref": "#/$defs/QuoteHash"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "resolved_at_commit": {
          "$ref": "#/$defs/CommitId"
        },
        "root_hash": {
          "$ref": "#/$defs/ArtifactId"
        },
        "scene_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/StableId"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "span": {
          "anyOf": [
            {
              "$ref": "#/$defs/TextSpanRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "support_status": {
          "$ref": "#/$defs/EvidenceSupportStatus"
        }
      },
      "required": [
        "evidence_id",
        "root_hash",
        "object_hash",
        "support_status",
        "resolved_at_commit"
      ],
      "title": "EvidenceRef",
      "type": "object"
    },
    "EvidenceSupportStatus": {
      "enum": [
        "current_support",
        "historical_support",
        "superseded_support",
        "orphaned",
        "contradicted"
      ],
      "title": "EvidenceSupportStatus",
      "type": "string"
    },
    "PlanReviewCitation": {
      "additionalProperties": false,
      "description": "One candidate-local citation for a cross-item review finding.\n\n``quote`` on :class:`PlanReviewIssue` remains the legacy compact form for a\nliteral shared substring. These rows let differently worded fields be\ncompared without weakening the host's exact field/value verification.",
      "properties": {
        "field_path": {
          "minLength": 1,
          "title": "Field Path",
          "type": "string"
        },
        "item_id": {
          "$ref": "#/$defs/StableId"
        },
        "quote": {
          "minLength": 1,
          "title": "Quote",
          "type": "string"
        }
      },
      "required": [
        "item_id",
        "field_path",
        "quote"
      ],
      "title": "PlanReviewCitation",
      "type": "object"
    },
    "PlanReviewIssue": {
      "additionalProperties": false,
      "properties": {
        "actual": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Actual"
        },
        "affected_item_ids": {
          "default": [],
          "items": {
            "$ref": "#/$defs/StableId"
          },
          "title": "Affected Item Ids",
          "type": "array"
        },
        "authorized_operations": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Authorized Operations",
          "type": "array"
        },
        "authorized_target_item_ids": {
          "default": [],
          "items": {
            "$ref": "#/$defs/StableId"
          },
          "title": "Authorized Target Item Ids",
          "type": "array"
        },
        "blocking": {
          "title": "Blocking",
          "type": "boolean"
        },
        "citations": {
          "default": [],
          "items": {
            "$ref": "#/$defs/PlanReviewCitation"
          },
          "title": "Citations",
          "type": "array"
        },
        "constraint_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Constraint Id"
        },
        "evidence_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "expected": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected"
        },
        "field_path": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Field Path"
        },
        "host_issued": {
          "default": false,
          "title": "Host Issued",
          "type": "boolean"
        },
        "issue_id": {
          "$ref": "#/$defs/StableId"
        },
        "kind": {
          "$ref": "#/$defs/ReviewIssueKind"
        },
        "proposed_target_item_ids": {
          "default": [],
          "items": {
            "$ref": "#/$defs/StableId"
          },
          "title": "Proposed Target Item Ids",
          "type": "array"
        },
        "quote": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quote"
        },
        "summary": {
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        },
        "unmet_condition": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unmet Condition"
        }
      },
      "required": [
        "issue_id",
        "kind",
        "summary",
        "blocking"
      ],
      "title": "PlanReviewIssue",
      "type": "object"
    },
    "QuoteHash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "QuoteHash",
      "type": "string"
    },
    "RangeUnit": {
      "enum": [
        "unicode_codepoint"
      ],
      "title": "RangeUnit",
      "type": "string"
    },
    "ReviewDecision": {
      "enum": [
        "accept",
        "revise",
        "human_required"
      ],
      "title": "ReviewDecision",
      "type": "string"
    },
    "ReviewIssueKind": {
      "enum": [
        "coverage",
        "contradiction",
        "feasibility",
        "obligation",
        "pacing",
        "alternative_comparison",
        "memory_gap",
        "provenance",
        "long_range_payoff_without_time_window",
        "early_resolution_of_future_locked_obligation",
        "target_window_outside_parent_scope",
        "blocking_unresolved",
        "volume_structure_incomplete",
        "obligation_contract",
        "unresolved_scope_missing",
        "volume_stage_window_violation",
        "unsupported_plan_precondition",
        "chapter_set_semantic_gap",
        "parent_child_correspondence",
        "execution_coverage",
        "planned_introduction_responsibility"
      ],
      "title": "ReviewIssueKind",
      "type": "string"
    },
    "ReviewTargetKind": {
      "enum": [
        "inquiry",
        "plan_proposal"
      ],
      "title": "ReviewTargetKind",
      "type": "string"
    },
    "StableId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "StableId",
      "type": "string"
    },
    "TextSpanRef": {
      "additionalProperties": false,
      "properties": {
        "block_id": {
          "$ref": "#/$defs/StableId"
        },
        "end": {
          "minimum": 0,
          "title": "End",
          "type": "integer"
        },
        "range_unit": {
          "$ref": "#/$defs/RangeUnit",
          "default": "unicode_codepoint"
        },
        "start": {
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        }
      },
      "required": [
        "block_id",
        "start",
        "end"
      ],
      "title": "TextSpanRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "coverage_evidence": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Coverage Evidence",
      "type": "array"
    },
    "decision": {
      "$ref": "#/$defs/ReviewDecision"
    },
    "issues": {
      "default": [],
      "items": {
        "$ref": "#/$defs/PlanReviewIssue"
      },
      "title": "Issues",
      "type": "array"
    },
    "memory_gap_questions": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Memory Gap Questions",
      "type": "array"
    },
    "preserve_item_ids": {
      "default": [],
      "items": {
        "$ref": "#/$defs/StableId"
      },
      "title": "Preserve Item Ids",
      "type": "array"
    },
    "revision_instruction": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Revision Instruction"
    },
    "target_kind": {
      "$ref": "#/$defs/ReviewTargetKind"
    },
    "verification_failures": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Verification Failures",
      "type": "array"
    }
  },
  "required": [
    "target_kind",
    "decision"
  ],
  "title": "PlanReviewDraft",
  "type": "object"
}
