{
  "$defs": {
    "ArtifactId": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "ArtifactId",
      "type": "string"
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/ArtifactId"
        },
        "byte_length": {
          "minimum": 0,
          "title": "Byte Length",
          "type": "integer"
        },
        "media_type": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "schema_version": {
          "$ref": "#/$defs/SchemaVersion"
        }
      },
      "required": [
        "artifact_id",
        "media_type",
        "byte_length",
        "schema_version"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "CommitId": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "CommitId",
      "type": "string"
    },
    "PlanningLoopPhase": {
      "enum": [
        "preflight",
        "inquiry_accepted",
        "memory_resolved",
        "context_ready",
        "plan_proposed",
        "plan_reviewed",
        "terminal"
      ],
      "title": "PlanningLoopPhase",
      "type": "string"
    },
    "SchemaVersion": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "title": "SchemaVersion",
      "type": "string"
    },
    "StableId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "StableId",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "base_commit": {
      "anyOf": [
        {
          "$ref": "#/$defs/CommitId"
        },
        {
          "type": "null"
        }
      ]
    },
    "checkpoint_id": {
      "$ref": "#/$defs/StableId"
    },
    "configuration_fingerprint": {
      "$ref": "#/$defs/ArtifactId"
    },
    "inquiry_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/ArtifactRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "inquiry_review_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/ArtifactRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "inquiry_revisions_used": {
      "default": 0,
      "maximum": 1,
      "minimum": 0,
      "title": "Inquiry Revisions Used",
      "type": "integer"
    },
    "memory_context_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/ArtifactRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "phase": {
      "$ref": "#/$defs/PlanningLoopPhase"
    },
    "plan_review_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/ArtifactRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "plan_revisions_used": {
      "default": 0,
      "maximum": 1,
      "minimum": 0,
      "title": "Plan Revisions Used",
      "type": "integer"
    },
    "planner_context_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/ArtifactRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "proposal_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/ArtifactRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "request_id": {
      "$ref": "#/$defs/StableId"
    },
    "reviewer_memory_rounds_used": {
      "default": 0,
      "maximum": 1,
      "minimum": 0,
      "title": "Reviewer Memory Rounds Used",
      "type": "integer"
    },
    "snapshot_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/StableId"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "checkpoint_id",
    "request_id",
    "phase",
    "base_commit",
    "snapshot_id",
    "configuration_fingerprint"
  ],
  "title": "PlanningLoopCheckpoint",
  "type": "object"
}
