{
  "$defs": {
    "ArtifactId": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "ArtifactId",
      "type": "string"
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/ArtifactId"
        },
        "byte_length": {
          "minimum": 0,
          "title": "Byte Length",
          "type": "integer"
        },
        "media_type": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "schema_version": {
          "$ref": "#/$defs/SchemaVersion"
        }
      },
      "required": [
        "artifact_id",
        "media_type",
        "byte_length",
        "schema_version"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "CommitId": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "CommitId",
      "type": "string"
    },
    "JsonValue": {},
    "LoopRoundProgress": {
      "additionalProperties": false,
      "description": "Minimal evidence that one Writer/Planner/Editor/repair round changed work.",
      "properties": {
        "artifact_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "basis_commit": {
          "anyOf": [
            {
              "$ref": "#/$defs/CommitId"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "changed_ids": {
          "default": [],
          "items": {
            "$ref": "#/$defs/StableId"
          },
          "title": "Changed Ids",
          "type": "array"
        },
        "input_candidate_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "kind": {
          "$ref": "#/$defs/LoopRoundProgressKind"
        },
        "remaining_work": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Remaining Work",
          "type": "array"
        }
      },
      "required": [
        "kind"
      ],
      "title": "LoopRoundProgress",
      "type": "object"
    },
    "LoopRoundProgressKind": {
      "description": "Durable per-round progress. Retry count or model self-praise is not progress.",
      "enum": [
        "PROGRESSED",
        "NO_PROGRESS",
        "WAITING",
        "TERMINAL"
      ],
      "title": "LoopRoundProgressKind",
      "type": "string"
    },
    "PlanningLoopPhase": {
      "enum": [
        "preflight",
        "inquiry_reviewed",
        "inquiry_accepted",
        "memory_resolved",
        "context_ready",
        "planner_memory_pending",
        "plan_proposed",
        "plan_reviewed",
        "terminal"
      ],
      "title": "PlanningLoopPhase",
      "type": "string"
    },
    "SchemaVersion": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "title": "SchemaVersion",
      "type": "string"
    },
    "StableId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "StableId",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "artifact_refs": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ArtifactRef"
      },
      "title": "Artifact Refs",
      "type": "array"
    },
    "event_id": {
      "$ref": "#/$defs/StableId"
    },
    "event_kind": {
      "minLength": 1,
      "title": "Event Kind",
      "type": "string"
    },
    "payload": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Payload",
      "type": "object"
    },
    "phase": {
      "$ref": "#/$defs/PlanningLoopPhase"
    },
    "request_id": {
      "$ref": "#/$defs/StableId"
    },
    "round_progress": {
      "anyOf": [
        {
          "$ref": "#/$defs/LoopRoundProgress"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "event_id",
    "request_id",
    "phase",
    "event_kind"
  ],
  "title": "PlanningLoopEventReceipt",
  "type": "object"
}
