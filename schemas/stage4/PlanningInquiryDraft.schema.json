{
  "$defs": {
    "AgentMode": {
      "enum": [
        "project_bootstrap",
        "story",
        "arc_volume",
        "chapter",
        "scene",
        "replan",
        "bootstrap",
        "replay",
        "curator_repair",
        "bounded_r2",
        "risk_review",
        "draft",
        "continue",
        "major_rewrite",
        "review",
        "local_repair",
        "observe",
        "chapter_set"
      ],
      "title": "AgentMode",
      "type": "string"
    },
    "ArtifactId": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "ArtifactId",
      "type": "string"
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/ArtifactId"
        },
        "byte_length": {
          "minimum": 0,
          "title": "Byte Length",
          "type": "integer"
        },
        "media_type": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "schema_version": {
          "$ref": "#/$defs/SchemaVersion"
        }
      },
      "required": [
        "artifact_id",
        "media_type",
        "byte_length",
        "schema_version"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "GoalProposal": {
      "additionalProperties": false,
      "properties": {
        "decision_criteria": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Decision Criteria",
          "type": "array"
        },
        "goal_id": {
          "$ref": "#/$defs/StableId"
        },
        "provenance": {
          "$ref": "#/$defs/PlanningReference"
        },
        "rationale": {
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "summary": {
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "goal_id",
        "summary",
        "rationale",
        "provenance"
      ],
      "title": "GoalProposal",
      "type": "object"
    },
    "PlanningProvenance": {
      "enum": [
        "author_supplied",
        "accepted_plan_derived",
        "canon_derived",
        "reviewer_derived",
        "planner_proposed"
      ],
      "title": "PlanningProvenance",
      "type": "string"
    },
    "PlanningQuestion": {
      "additionalProperties": false,
      "properties": {
        "blocking": {
          "default": false,
          "title": "Blocking",
          "type": "boolean"
        },
        "entity_labels": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Entity Labels",
          "type": "array"
        },
        "goal_id": {
          "$ref": "#/$defs/StableId"
        },
        "kind": {
          "$ref": "#/$defs/PlanningQuestionKind"
        },
        "provenance": {
          "$ref": "#/$defs/PlanningReference"
        },
        "question": {
          "minLength": 1,
          "title": "Question",
          "type": "string"
        },
        "question_id": {
          "$ref": "#/$defs/StableId"
        },
        "relation_object": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Relation Object"
        },
        "relation_predicate": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Relation Predicate"
        },
        "relation_subject": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Relation Subject"
        }
      },
      "required": [
        "question_id",
        "kind",
        "question",
        "provenance",
        "goal_id"
      ],
      "title": "PlanningQuestion",
      "type": "object"
    },
    "PlanningQuestionKind": {
      "enum": [
        "fact",
        "relation_causal",
        "obligation_pacing",
        "style_reference",
        "human_choice"
      ],
      "title": "PlanningQuestionKind",
      "type": "string"
    },
    "PlanningReference": {
      "additionalProperties": false,
      "properties": {
        "artifact_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          },
          "title": "Artifact Refs",
          "type": "array"
        },
        "provenance": {
          "$ref": "#/$defs/PlanningProvenance"
        },
        "reference_ids": {
          "default": [],
          "items": {
            "$ref": "#/$defs/StableId"
          },
          "title": "Reference Ids",
          "type": "array"
        }
      },
      "required": [
        "provenance"
      ],
      "title": "PlanningReference",
      "type": "object"
    },
    "SchemaVersion": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "title": "SchemaVersion",
      "type": "string"
    },
    "StableId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "StableId",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Untrusted structured output normalized into ``PlanningInquiry`` by the agent.",
  "properties": {
    "alternatives": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Alternatives",
      "type": "array"
    },
    "assumptions": {
      "default": [],
      "items": {
        "$ref": "#/$defs/PlanningQuestion"
      },
      "title": "Assumptions",
      "type": "array"
    },
    "decision_criteria": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Decision Criteria",
      "type": "array"
    },
    "expected_output_shape": {
      "minLength": 1,
      "title": "Expected Output Shape",
      "type": "string"
    },
    "goal_proposals": {
      "items": {
        "$ref": "#/$defs/GoalProposal"
      },
      "minItems": 1,
      "title": "Goal Proposals",
      "type": "array"
    },
    "horizon_end": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Horizon End"
    },
    "horizon_start": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Horizon Start"
    },
    "human_choices": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Human Choices",
      "type": "array"
    },
    "mode": {
      "$ref": "#/$defs/AgentMode"
    },
    "planning_scope": {
      "items": {
        "type": "string"
      },
      "title": "Planning Scope",
      "type": "array"
    },
    "questions": {
      "default": [],
      "items": {
        "$ref": "#/$defs/PlanningQuestion"
      },
      "title": "Questions",
      "type": "array"
    }
  },
  "required": [
    "mode",
    "planning_scope",
    "goal_proposals",
    "expected_output_shape"
  ],
  "title": "PlanningInquiryDraft",
  "type": "object"
}
