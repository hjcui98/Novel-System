{
  "$defs": {
    "ArtifactId": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "ArtifactId",
      "type": "string"
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/ArtifactId"
        },
        "byte_length": {
          "minimum": 0,
          "title": "Byte Length",
          "type": "integer"
        },
        "media_type": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "schema_version": {
          "$ref": "#/$defs/SchemaVersion"
        }
      },
      "required": [
        "artifact_id",
        "media_type",
        "byte_length",
        "schema_version"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "RunId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "RunId",
      "type": "string"
    },
    "SchemaVersion": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "title": "SchemaVersion",
      "type": "string"
    },
    "StableId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "StableId",
      "type": "string"
    },
    "TaskId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "TaskId",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Narrow Stage 4 view of the Stage 3-owned shared Context Runtime.",
  "properties": {
    "basis_event_position": {
      "minimum": 0,
      "title": "Basis Event Position",
      "type": "integer"
    },
    "compaction_receipt_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/ArtifactRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "exposed_context_item_ids": {
      "items": {
        "$ref": "#/$defs/StableId"
      },
      "title": "Exposed Context Item Ids",
      "type": "array"
    },
    "generation": {
      "minimum": 0,
      "title": "Generation",
      "type": "integer"
    },
    "rendered_context": {
      "title": "Rendered Context",
      "type": "string"
    },
    "run_id": {
      "$ref": "#/$defs/RunId"
    },
    "seed_ref": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "suspended": {
      "default": false,
      "title": "Suspended",
      "type": "boolean"
    },
    "suspension_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Suspension Reason"
    },
    "task_id": {
      "$ref": "#/$defs/TaskId"
    },
    "token_count": {
      "minimum": 0,
      "title": "Token Count",
      "type": "integer"
    },
    "used_context_item_ids": {
      "default": [],
      "items": {
        "$ref": "#/$defs/StableId"
      },
      "title": "Used Context Item Ids",
      "type": "array"
    },
    "view_ref": {
      "$ref": "#/$defs/ArtifactRef"
    }
  },
  "required": [
    "run_id",
    "task_id",
    "seed_ref",
    "view_ref",
    "generation",
    "basis_event_position",
    "rendered_context",
    "token_count",
    "exposed_context_item_ids"
  ],
  "title": "PlannerContextProjection",
  "type": "object"
}
