          "default": 8,
          "minimum": 0,
          "title": "Max Anchor Expansions",
          "type": "integer"
        },
        "max_candidates": {
          "default": 100,
          "maximum": 100,
          "minimum": 1,
          "title": "Max Candidates",
          "type": "integer"
        },
        "max_full_chapter_reads": {
          "default": 0,
          "minimum": 0,
