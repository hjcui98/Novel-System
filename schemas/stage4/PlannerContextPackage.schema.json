{
  "$defs": {
    "AgentMode": {
      "enum": [
        "project_bootstrap",
        "story",
        "arc_volume",
        "chapter",
        "scene",
        "replan",
        "bootstrap",
        "replay",
        "curator_repair",
        "bounded_r2",
        "risk_review",
        "draft",
        "continue",
        "major_rewrite",
        "review",
        "local_repair",
        "observe",
        "chapter_set"
      ],
      "title": "AgentMode",
      "type": "string"
    },
    "ArtifactId": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "ArtifactId",
      "type": "string"
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/ArtifactId"
        },
        "byte_length": {
          "minimum": 0,
          "title": "Byte Length",
          "type": "integer"
        },
        "media_type": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "schema_version": {
          "$ref": "#/$defs/SchemaVersion"
        }
      },
      "required": [
        "artifact_id",
        "media_type",
        "byte_length",
        "schema_version"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "CommitId": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "CommitId",
      "type": "string"
    },
    "EvidenceRef": {
      "additionalProperties": false,
      "properties": {
        "chapter_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/StableId"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "evidence_id": {
          "$ref": "#/$defs/StableId"
        },
        "object_hash": {
          "$ref": "#/$defs/ArtifactId"
        },
        "quote_hash": {
          "anyOf": [
            {
              "$ref": "#/$defs/QuoteHash"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "resolved_at_commit": {
          "$ref": "#/$defs/CommitId"
        },
        "root_hash": {
          "$ref": "#/$defs/ArtifactId"
        },
        "scene_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/StableId"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "span": {
          "anyOf": [
            {
              "$ref": "#/$defs/TextSpanRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "support_status": {
          "$ref": "#/$defs/EvidenceSupportStatus"
        }
      },
      "required": [
        "evidence_id",
        "root_hash",
        "object_hash",
        "support_status",
        "resolved_at_commit"
      ],
      "title": "EvidenceRef",
      "type": "object"
    },
    "EvidenceSupportStatus": {
      "enum": [
        "current_support",
        "historical_support",
        "superseded_support",
        "orphaned",
        "contradicted"
      ],
      "title": "EvidenceSupportStatus",
      "type": "string"
    },
    "PlannerContextBudgetReport": {
      "additionalProperties": false,
      "properties": {
        "drop_reasons": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Drop Reasons",
          "type": "object"
        },
        "dropped_item_ids": {
          "default": [],
          "items": {
            "$ref": "#/$defs/StableId"
          },
          "title": "Dropped Item Ids",
          "type": "array"
        },
        "mandatory_tokens": {
          "minimum": 0,
          "title": "Mandatory Tokens",
          "type": "integer"
        },
        "selected_tokens": {
          "minimum": 0,
          "title": "Selected Tokens",
          "type": "integer"
        },
        "soft_overflow_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Soft Overflow Tokens",
          "type": "integer"
        },
        "token_budget": {
          "minimum": 1,
          "title": "Token Budget",
          "type": "integer"
        }
      },
      "required": [
        "token_budget",
        "mandatory_tokens",
        "selected_tokens"
      ],
      "title": "PlannerContextBudgetReport",
      "type": "object"
    },
    "PlannerContextItem": {
      "additionalProperties": false,
      "properties": {
        "compact_handle": {
          "anyOf": [
            {
              "$ref": "#/$defs/StableId"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "context_item_id": {
          "$ref": "#/$defs/StableId"
        },
        "evidence_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "graph_path_receipt_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          },
          "title": "Graph Path Receipt Refs",
          "type": "array"
        },
        "mandatory": {
          "default": false,
          "title": "Mandatory",
          "type": "boolean"
        },
        "protected": {
          "default": false,
          "title": "Protected",
          "type": "boolean"
        },
        "retrieval_unit_ids": {
          "default": [],
          "items": {
            "$ref": "#/$defs/StableId"
          },
          "title": "Retrieval Unit Ids",
          "type": "array"
        },
        "section": {
          "$ref": "#/$defs/PlannerContextSection"
        },
        "source_artifact_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          },
          "title": "Source Artifact Refs",
          "type": "array"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "token_count": {
          "minimum": 1,
          "title": "Token Count",
          "type": "integer"
        }
      },
      "required": [
        "context_item_id",
        "section",
        "text",
        "token_count"
      ],
      "title": "PlannerContextItem",
      "type": "object"
    },
    "PlannerContextSection": {
      "enum": [
        "author_intent",
        "accepted_plan",
        "current_state",
        "history_deviation",
        "relation_causal",
        "style_reference",
        "working_proposal",
        "unresolved"
      ],
      "title": "PlannerContextSection",
      "type": "string"
    },
    "ProjectId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "ProjectId",
      "type": "string"
    },
    "QuoteHash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "QuoteHash",
      "type": "string"
    },
    "RangeUnit": {
      "enum": [
        "unicode_codepoint"
      ],
      "title": "RangeUnit",
      "type": "string"
    },
    "SchemaVersion": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "title": "SchemaVersion",
      "type": "string"
    },
    "StableId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "StableId",
      "type": "string"
    },
    "TextSpanRef": {
      "additionalProperties": false,
      "properties": {
        "block_id": {
          "$ref": "#/$defs/StableId"
        },
        "end": {
          "minimum": 0,
          "title": "End",
          "type": "integer"
        },
        "range_unit": {
          "$ref": "#/$defs/RangeUnit",
          "default": "unicode_codepoint"
        },
        "start": {
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        }
      },
      "required": [
        "block_id",
        "start",
        "end"
      ],
      "title": "TextSpanRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "base_commit": {
      "anyOf": [
        {
          "$ref": "#/$defs/CommitId"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "budget_report": {
      "$ref": "#/$defs/PlannerContextBudgetReport"
    },
    "contract_version": {
      "minLength": 1,
      "title": "Contract Version",
      "type": "string"
    },
    "evidence_refs": {
      "default": [],
      "items": {
        "$ref": "#/$defs/EvidenceRef"
      },
      "title": "Evidence Refs",
      "type": "array"
    },
    "expansion_receipt_refs": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ArtifactRef"
      },
      "title": "Expansion Receipt Refs",
      "type": "array"
    },
    "graph_path_receipt_refs": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ArtifactRef"
      },
      "title": "Graph Path Receipt Refs",
      "type": "array"
    },
    "horizon_end": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Horizon End"
    },
    "horizon_start": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Horizon Start"
    },
    "items": {
      "items": {
        "$ref": "#/$defs/PlannerContextItem"
      },
      "title": "Items",
      "type": "array"
    },
    "mode": {
      "$ref": "#/$defs/AgentMode"
    },
    "need_ids": {
      "default": [],
      "items": {
        "$ref": "#/$defs/StableId"
      },
      "title": "Need Ids",
      "type": "array"
    },
    "package_id": {
      "$ref": "#/$defs/StableId"
    },
    "planning_scope": {
      "items": {
        "type": "string"
      },
      "title": "Planning Scope",
      "type": "array"
    },
    "profile_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/ArtifactRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "project_id": {
      "$ref": "#/$defs/ProjectId"
    },
    "rendered_context": {
      "title": "Rendered Context",
      "type": "string"
    },
    "retrieval_unit_ids": {
      "default": [],
      "items": {
        "$ref": "#/$defs/StableId"
      },
      "title": "Retrieval Unit Ids",
      "type": "array"
    },
    "reviewed_inquiry_ref": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "snapshot_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/StableId"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "stage1_context_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/ArtifactRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "unresolved_gaps": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Unresolved Gaps",
      "type": "array"
    }
  },
  "required": [
    "package_id",
    "contract_version",
    "project_id",
    "mode",
    "planning_scope",
    "reviewed_inquiry_ref",
    "items",
    "budget_report",
    "rendered_context"
  ],
  "title": "PlannerContextPackage",
  "type": "object"
}
