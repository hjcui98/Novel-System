{
  "$defs": {
    "PlanReviewCitation": {
      "additionalProperties": false,
      "description": "One candidate-local citation for a cross-item review finding.\n\n``quote`` on :class:`PlanReviewIssue` remains the legacy compact form for a\nliteral shared substring. These rows let differently worded fields be\ncompared without weakening the host's exact field/value verification.",
      "properties": {
        "field_path": {
          "minLength": 1,
          "title": "Field Path",
          "type": "string"
        },
        "item_id": {
          "$ref": "#/$defs/StableId"
        },
        "quote": {
          "minLength": 1,
          "title": "Quote",
          "type": "string"
        }
      },
      "required": [
        "item_id",
        "field_path",
        "quote"
      ],
      "title": "PlanReviewCitation",
      "type": "object"
    },
    "ReviewIssueKind": {
      "enum": [
        "coverage",
        "contradiction",
        "feasibility",
        "obligation",
        "pacing",
        "alternative_comparison",
        "memory_gap",
        "provenance",
        "long_range_payoff_without_time_window",
        "early_resolution_of_future_locked_obligation",
        "target_window_outside_parent_scope",
        "blocking_unresolved",
        "volume_structure_incomplete",
        "obligation_contract",
        "unresolved_scope_missing",
        "volume_stage_window_violation",
        "unsupported_plan_precondition",
        "chapter_set_semantic_gap",
        "parent_child_correspondence",
        "execution_coverage",
        "planned_introduction_responsibility"
      ],
      "title": "ReviewIssueKind",
      "type": "string"
    },
    "StableId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "StableId",
      "type": "string"
    }
  },
  "description": "The model-facing portion of a review issue.\n\nStable identities, host observations and write authorization are deliberately\nabsent from this schema.  ``extra=ignore`` keeps old providers that still emit\nthose legacy keys readable while ensuring the response schema no longer asks a\nmodel to fill host-owned fields.",
  "properties": {
    "affected_item_ids": {
      "default": [],
      "items": {
        "$ref": "#/$defs/StableId"
      },
      "title": "Affected Item Ids",
      "type": "array"
    },
    "blocking": {
      "title": "Blocking",
      "type": "boolean"
    },
    "citations": {
      "default": [],
      "items": {
        "$ref": "#/$defs/PlanReviewCitation"
      },
      "title": "Citations",
      "type": "array"
    },
    "constraint_id": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Constraint Id"
    },
    "field_path": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Field Path"
    },
    "kind": {
      "$ref": "#/$defs/ReviewIssueKind"
    },
    "proposed_target_item_ids": {
      "default": [],
      "items": {
        "$ref": "#/$defs/StableId"
      },
      "title": "Proposed Target Item Ids",
      "type": "array"
    },
    "quote": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Quote"
    },
    "summary": {
      "minLength": 1,
      "title": "Summary",
      "type": "string"
    },
    "unmet_condition": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Unmet Condition"
    }
  },
  "required": [
    "kind",
    "summary",
    "blocking"
  ],
  "title": "PlanReviewProviderIssue",
  "type": "object"
}
