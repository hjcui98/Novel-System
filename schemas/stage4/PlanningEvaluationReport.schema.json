{
  "$defs": {
    "AgentExecutionReceipt": {
      "additionalProperties": false,
      "properties": {
        "agent_mode": {
          "$ref": "#/$defs/AgentMode"
        },
        "agent_spec": {
          "$ref": "#/$defs/ContractRef"
        },
        "agent_type": {
          "$ref": "#/$defs/AgentType"
        },
        "base_commit": {
          "anyOf": [
            {
              "$ref": "#/$defs/CommitId"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "completed_at": {
          "format": "date-time",
          "title": "Completed At",
          "type": "string"
        },
        "configuration_fingerprint": {
          "$ref": "#/$defs/ArtifactId"
        },
        "escalations": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Escalations",
          "type": "array"
        },
        "input_artifacts": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          },
          "title": "Input Artifacts",
          "type": "array"
        },
        "latency_ms": {
          "minimum": 0,
          "title": "Latency Ms",
          "type": "integer"
        },
        "model_call_ids": {
          "default": [],
          "items": {
            "$ref": "#/$defs/StableId"
          },
          "title": "Model Call Ids",
          "type": "array"
        },
        "output_artifacts": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          },
          "title": "Output Artifacts",
          "type": "array"
        },
        "prompt_fingerprint": {
          "$ref": "#/$defs/ArtifactId"
        },
        "receipt_id": {
          "$ref": "#/$defs/StableId"
        },
        "run_id": {
          "$ref": "#/$defs/RunId"
        },
        "skill_receipts": {
          "default": [],
          "items": {
            "$ref": "#/$defs/SkillExecutionReceipt"
          },
          "title": "Skill Receipts",
          "type": "array"
        },
        "started_at": {
          "format": "date-time",
          "title": "Started At",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/ExecutionStatus"
        },
        "task_id": {
          "$ref": "#/$defs/TaskId"
        },
        "tool_call_ids": {
          "default": [],
          "items": {
            "$ref": "#/$defs/StableId"
          },
          "title": "Tool Call Ids",
          "type": "array"
        },
        "unresolved": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Unresolved",
          "type": "array"
        }
      },
      "required": [
        "receipt_id",
        "run_id",
        "task_id",
        "agent_spec",
        "agent_type",
        "agent_mode",
        "prompt_fingerprint",
        "configuration_fingerprint",
        "status",
        "started_at",
        "completed_at",
        "latency_ms"
      ],
      "title": "AgentExecutionReceipt",
      "type": "object"
    },
    "AgentMode": {
      "enum": [
        "project_bootstrap",
        "story",
        "arc_volume",
        "chapter",
        "scene",
        "replan",
        "bootstrap",
        "replay",
        "curator_repair",
        "bounded_r2",
        "risk_review",
        "draft",
        "continue",
        "major_rewrite",
        "review",
        "local_repair",
        "observe",
        "chapter_set"
      ],
      "title": "AgentMode",
      "type": "string"
    },
    "AgentType": {
      "enum": [
        "planner",
        "memory_curator",
        "memory_controller",
        "memory_guardian",
        "writer",
        "editor",
        "candidate_observer",
        "plan_reviewer"
      ],
      "title": "AgentType",
      "type": "string"
    },
    "ArtifactId": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "ArtifactId",
      "type": "string"
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/ArtifactId"
        },
        "byte_length": {
          "minimum": 0,
          "title": "Byte Length",
          "type": "integer"
        },
        "media_type": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "schema_version": {
          "$ref": "#/$defs/SchemaVersion"
        }
      },
      "required": [
        "artifact_id",
        "media_type",
        "byte_length",
        "schema_version"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "BootstrapStrategy": {
      "enum": [
        "normalize_only",
        "develop_candidates"
      ],
      "title": "BootstrapStrategy",
      "type": "string"
    },
    "CommitId": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "CommitId",
      "type": "string"
    },
    "ContractRef": {
      "additionalProperties": false,
      "properties": {
        "content_hash": {
          "$ref": "#/$defs/ArtifactId"
        },
        "contract_id": {
          "$ref": "#/$defs/StableId"
        },
        "version": {
          "$ref": "#/$defs/SchemaVersion"
        }
      },
      "required": [
        "contract_id",
        "version",
        "content_hash"
      ],
      "title": "ContractRef",
      "type": "object"
    },
    "EvidenceRef": {
      "additionalProperties": false,
      "properties": {
        "chapter_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/StableId"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "evidence_id": {
          "$ref": "#/$defs/StableId"
        },
        "object_hash": {
          "$ref": "#/$defs/ArtifactId"
        },
        "quote_hash": {
          "anyOf": [
            {
              "$ref": "#/$defs/QuoteHash"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "resolved_at_commit": {
          "$ref": "#/$defs/CommitId"
        },
        "root_hash": {
          "$ref": "#/$defs/ArtifactId"
        },
        "scene_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/StableId"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "span": {
          "anyOf": [
            {
              "$ref": "#/$defs/TextSpanRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "support_status": {
          "$ref": "#/$defs/EvidenceSupportStatus"
        }
      },
      "required": [
        "evidence_id",
        "root_hash",
        "object_hash",
        "support_status",
        "resolved_at_commit"
      ],
      "title": "EvidenceRef",
      "type": "object"
    },
    "EvidenceSupportStatus": {
      "enum": [
        "current_support",
        "historical_support",
        "superseded_support",
        "orphaned",
        "contradicted"
      ],
      "title": "EvidenceSupportStatus",
      "type": "string"
    },
    "ExecutionStatus": {
      "enum": [
        "succeeded",
        "failed",
        "suspended",
        "rejected"
      ],
      "title": "ExecutionStatus",
      "type": "string"
    },
    "JsonValue": {},
    "PlanProposal": {
      "additionalProperties": false,
      "properties": {
        "base_commit": {
          "anyOf": [
            {
              "$ref": "#/$defs/CommitId"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "coverage": {
          "maximum": 1,
          "minimum": 0,
          "title": "Coverage",
          "type": "number"
        },
        "evidence_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "graph_path_receipt_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          },
          "title": "Graph Path Receipt Refs",
          "type": "array"
        },
        "items": {
          "items": {
            "$ref": "#/$defs/ProposedItem"
          },
          "title": "Items",
          "type": "array"
        },
        "memory_need_ids": {
          "default": [],
          "items": {
            "$ref": "#/$defs/StableId"
          },
          "title": "Memory Need Ids",
          "type": "array"
        },
        "mode": {
          "$ref": "#/$defs/AgentMode"
        },
        "parent_proposal_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/StableId"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "project_id": {
          "$ref": "#/$defs/ProjectId"
        },
        "proposal_id": {
          "$ref": "#/$defs/StableId"
        },
        "receipt": {
          "$ref": "#/$defs/AgentExecutionReceipt"
        },
        "reviewed_inquiry_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "reviewer_receipt_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "strategy": {
          "anyOf": [
            {
              "$ref": "#/$defs/BootstrapStrategy"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "unresolved": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Unresolved",
          "type": "array"
        }
      },
      "required": [
        "proposal_id",
        "project_id",
        "mode",
        "items",
        "coverage",
        "receipt"
      ],
      "title": "PlanProposal",
      "type": "object"
    },
    "PlanningEvaluationProfile": {
      "enum": [
        "formal_configured",
        "deterministic_fake"
      ],
      "title": "PlanningEvaluationProfile",
      "type": "string"
    },
    "PlanningLoopResult": {
      "additionalProperties": false,
      "properties": {
        "degraded": {
          "default": false,
          "title": "Degraded",
          "type": "boolean"
        },
        "diagnostic_codes": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Diagnostic Codes",
          "type": "array"
        },
        "event_artifacts": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          },
          "title": "Event Artifacts",
          "type": "array"
        },
        "inquiry_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "inquiry_review_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "memory_context_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "plan_review_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "planner_context_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "proposal": {
          "anyOf": [
            {
              "$ref": "#/$defs/PlanProposal"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "request_id": {
          "$ref": "#/$defs/StableId"
        },
        "terminal": {
          "$ref": "#/$defs/PlanningLoopTerminal"
        }
      },
      "required": [
        "request_id",
        "terminal"
      ],
      "title": "PlanningLoopResult",
      "type": "object"
    },
    "PlanningLoopTerminal": {
      "enum": [
        "plan_candidate_ready",
        "inquiry_invalid",
        "inquiry_review_required",
        "memory_insufficient",
        "plan_conflict",
        "review_revision_required",
        "human_required",
        "context_limit",
        "model_unavailable",
        "basis_changed",
        "degraded_not_promotable",
        "review_required",
        "suspended",
        "blocked"
      ],
      "title": "PlanningLoopTerminal",
      "type": "string"
    },
    "ProjectId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "ProjectId",
      "type": "string"
    },
    "ProposalProvenance": {
      "enum": [
        "author_supplied",
        "planner_proposed"
      ],
      "title": "ProposalProvenance",
      "type": "string"
    },
    "ProposedItem": {
      "additionalProperties": false,
      "properties": {
        "item_id": {
          "$ref": "#/$defs/StableId"
        },
        "kind": {
          "minLength": 1,
          "title": "Kind",
          "type": "string"
        },
        "payload": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Payload",
          "type": "object"
        },
        "provenance": {
          "$ref": "#/$defs/ProposalProvenance"
        },
        "source_ids": {
          "default": [],
          "items": {
            "$ref": "#/$defs/StableId"
          },
          "title": "Source Ids",
          "type": "array"
        }
      },
      "required": [
        "item_id",
        "kind",
        "payload",
        "provenance"
      ],
      "title": "ProposedItem",
      "type": "object"
    },
    "QuoteHash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "QuoteHash",
      "type": "string"
    },
    "RangeUnit": {
      "enum": [
        "unicode_codepoint"
      ],
      "title": "RangeUnit",
      "type": "string"
    },
    "RunId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "RunId",
      "type": "string"
    },
    "SchemaVersion": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "title": "SchemaVersion",
      "type": "string"
    },
    "SkillContractRef": {
      "additionalProperties": false,
      "properties": {
        "content_hash": {
          "$ref": "#/$defs/ArtifactId"
        },
        "contract_id": {
          "$ref": "#/$defs/StableId"
        },
        "version": {
          "$ref": "#/$defs/SchemaVersion"
        }
      },
      "required": [
        "contract_id",
        "version",
        "content_hash"
      ],
      "title": "SkillContractRef",
      "type": "object"
    },
    "SkillExecutionReceipt": {
      "additionalProperties": false,
      "properties": {
        "agent_mode": {
          "$ref": "#/$defs/AgentMode"
        },
        "agent_type": {
          "$ref": "#/$defs/AgentType"
        },
        "base_commit": {
          "anyOf": [
            {
              "$ref": "#/$defs/CommitId"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "completed_checkpoints": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Completed Checkpoints",
          "type": "array"
        },
        "context_manifest": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactId"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "escalations": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Escalations",
          "type": "array"
        },
        "input_artifacts": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          },
          "title": "Input Artifacts",
          "type": "array"
        },
        "latency_ms": {
          "minimum": 0,
          "title": "Latency Ms",
          "type": "integer"
        },
        "output_artifacts": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          },
          "title": "Output Artifacts",
          "type": "array"
        },
        "receipt_id": {
          "$ref": "#/$defs/StableId"
        },
        "run_id": {
          "$ref": "#/$defs/RunId"
        },
        "skill": {
          "$ref": "#/$defs/SkillContractRef"
        },
        "skipped_checkpoints": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Skipped Checkpoints",
          "type": "array"
        },
        "status": {
          "$ref": "#/$defs/ExecutionStatus"
        },
        "task_id": {
          "$ref": "#/$defs/TaskId"
        },
        "tool_call_ids": {
          "default": [],
          "items": {
            "$ref": "#/$defs/StableId"
          },
          "title": "Tool Call Ids",
          "type": "array"
        },
        "unresolved": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Unresolved",
          "type": "array"
        }
      },
      "required": [
        "receipt_id",
        "run_id",
        "task_id",
        "skill",
        "agent_type",
        "agent_mode",
        "status",
        "latency_ms"
      ],
      "title": "SkillExecutionReceipt",
      "type": "object"
    },
    "StableId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "StableId",
      "type": "string"
    },
    "TaskId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "TaskId",
      "type": "string"
    },
    "TextSpanRef": {
      "additionalProperties": false,
      "properties": {
        "block_id": {
          "$ref": "#/$defs/StableId"
        },
        "end": {
          "minimum": 0,
          "title": "End",
          "type": "integer"
        },
        "range_unit": {
          "$ref": "#/$defs/RangeUnit",
          "default": "unicode_codepoint"
        },
        "start": {
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        }
      },
      "required": [
        "block_id",
        "start",
        "end"
      ],
      "title": "TextSpanRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "ablation_metrics": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Ablation Metrics",
      "type": "object"
    },
    "evaluation_profile": {
      "$ref": "#/$defs/PlanningEvaluationProfile"
    },
    "gate_eligible": {
      "title": "Gate Eligible",
      "type": "boolean"
    },
    "leakage_count": {
      "minimum": 0,
      "title": "Leakage Count",
      "type": "integer"
    },
    "lineage_artifacts": {
      "items": {
        "$ref": "#/$defs/ArtifactRef"
      },
      "title": "Lineage Artifacts",
      "type": "array"
    },
    "manifest_id": {
      "$ref": "#/$defs/StableId"
    },
    "provenance_error_count": {
      "minimum": 0,
      "title": "Provenance Error Count",
      "type": "integer"
    },
    "results": {
      "items": {
        "$ref": "#/$defs/PlanningLoopResult"
      },
      "title": "Results",
      "type": "array"
    },
    "reviewer_metrics": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Reviewer Metrics",
      "type": "object"
    },
    "semantic_gate_passed": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "title": "Semantic Gate Passed"
    }
  },
  "required": [
    "manifest_id",
    "evaluation_profile",
    "gate_eligible",
    "semantic_gate_passed",
    "results",
    "lineage_artifacts",
    "leakage_count",
    "provenance_error_count"
  ],
  "title": "PlanningEvaluationReport",
  "type": "object"
}
