{
  "$defs": {
    "StableId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "StableId",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "drop_reasons": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Drop Reasons",
      "type": "object"
    },
    "dropped_item_ids": {
      "default": [],
      "items": {
        "$ref": "#/$defs/StableId"
      },
      "title": "Dropped Item Ids",
      "type": "array"
    },
    "mandatory_tokens": {
      "minimum": 0,
      "title": "Mandatory Tokens",
      "type": "integer"
    },
    "selected_tokens": {
      "minimum": 0,
      "title": "Selected Tokens",
      "type": "integer"
    },
    "soft_overflow_tokens": {
      "default": 0,
      "minimum": 0,
      "title": "Soft Overflow Tokens",
      "type": "integer"
    },
    "token_budget": {
      "minimum": 1,
      "title": "Token Budget",
      "type": "integer"
    }
  },
  "required": [
    "token_budget",
    "mandatory_tokens",
    "selected_tokens"
  ],
  "title": "PlannerContextBudgetReport",
  "type": "object"
}
