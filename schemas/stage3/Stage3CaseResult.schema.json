    "WriterArtifactBasis": {
      "additionalProperties": false,
      "description": "Immutable lineage shared by every input and output of one Writer run.\n\n``configuration_fingerprint`` is specifically the canonical JSON fingerprint\nof the Writer AgentSpec, matching ``StructuredAgentRunner.prepare``.  The\nembedded future-isolation attestation retains its independent Memory and\ninformation-boundary configuration fingerprint; the two are intentionally\nnot required to match.",
      "properties": {
        "base_commit": {
          "$ref": "#/$defs/CommitId"
        },
        "configuration_fingerprint": {
          "$ref": "#/$defs/ArtifactId"
        },
        "context_artifact": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "context_fingerprint": {
          "$ref": "#/$defs/ArtifactId"
        },
        "context_id": {
          "$ref": "#/$defs/StableId"
        },
        "future_isolation_attestation": {
          "$ref": "#/$defs/FutureIsolationAttestation"
        },
        "memory_gate_artifact": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "memory_gate_report": {
          "anyOf": [
            {
              "$ref": "#/$defs/Stage2GateReport"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "model_configuration_fingerprint": {
          "$ref": "#/$defs/ArtifactId"
        },
        "plan_artifact": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "project_id": {
          "$ref": "#/$defs/ProjectId"
        },
        "project_profile_artifact": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "snapshot_id": {
          "$ref": "#/$defs/StableId"
        },
        "source_artifacts": {
          "default": [],
          "items": {
            "$ref": "#/$defs/WriterSourceBinding"
          },
          "title": "Source Artifacts",
          "type": "array"
        },
        "writing_contract_artifact": {
          "$ref": "#/$defs/ArtifactRef"
        }
      },
      "required": [
        "project_id",
        "base_commit",
        "snapshot_id",
        "context_id",
        "context_artifact",
        "context_fingerprint",
        "writing_contract_artifact",
        "plan_artifact",
        "project_profile_artifact",
        "configuration_fingerprint",
        "model_configuration_fingerprint",
        "future_isolation_attestation"
      ],
      "title": "WriterArtifactBasis",
      "type": "object"
    },
