        "fail",
        "incomplete"
      ],
      "title": "Stage2GateVerdict",
      "type": "string"
    },
    "Stage3FailureCategory": {
      "description": "Typed scheme status; a failed scheme is never replaced by another result.",
      "enum": [
        "input_not_ready",
        "writer_failed",
        "editor_failed",
        "reconciliation_failed",
        "evaluation_failed",
        "completed"
      ],
      "title": "Stage3FailureCategory",
      "type": "string"
    },
    "Stage3SchemeResult": {
      "additionalProperties": false,
      "description": "Uniform per-scheme outcome; missing pieces are typed, never zeroed.",
      "properties": {
        "case_id": {
          "$ref": "#/$defs/StableId"
        },
        "draft": {
          "anyOf": [
            {
              "$ref": "#/$defs/DraftArtifact"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "editorial": {
          "anyOf": [
            {
              "$ref": "#/$defs/CollectedEditorialReport"
            },
            {
              "type": "null"
            }
          ],
          "default": null
