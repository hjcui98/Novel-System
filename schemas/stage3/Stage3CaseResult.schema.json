            "$ref": "#/$defs/EvaluatorScore"
          },
          "title": "Evaluator Scores",
          "type": "array"
        },
        "failure_detail": {
          "anyOf": [
            {
              "maxLength": 4096,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Failure Detail"
        },
        "reconciliation": {
          "anyOf": [
            {
              "$ref": "#/$defs/CollectedReconciliationResult"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "rules": {
          "anyOf": [
            {
              "$ref": "#/$defs/RuleAssessment"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "scheme": {
          "$ref": "#/$defs/ContextScheme"
        },
        "status": {
          "$ref": "#/$defs/Stage3FailureCategory"
        },
        "writer": {
          "anyOf": [
            {
              "$ref": "#/$defs/WriterExecutionResult"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "case_id",
        "scheme",
        "status"
      ],
      "title": "Stage3SchemeResult",
      "type": "object"
    },
