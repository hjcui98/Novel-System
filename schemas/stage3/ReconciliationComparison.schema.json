{
  "$defs": {
    "CuratorChangeObservation": {
      "additionalProperties": false,
      "description": "A minimal independent observation extracted from the repaired/current Draft.",
      "properties": {
        "change_kind": {
          "$ref": "#/$defs/MemoryHintChangeKind"
        },
        "evidence_quote": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence Quote"
        },
        "observation_id": {
          "$ref": "#/$defs/StableId"
        },
        "predicate_hint": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Predicate Hint"
        },
        "subject_hint": {
          "minLength": 1,
          "title": "Subject Hint",
          "type": "string"
        },
        "target_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/StableId"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "value_hint": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value Hint"
        }
      },
      "required": [
        "observation_id",
        "subject_hint",
        "change_kind"
      ],
      "title": "CuratorChangeObservation",
      "type": "object"
    },
    "DeclaredMemoryHint": {
      "additionalProperties": false,
      "properties": {
        "change_kind": {
          "$ref": "#/$defs/MemoryHintChangeKind"
        },
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "evidence_quote": {
          "minLength": 1,
          "title": "Evidence Quote",
          "type": "string"
        },
        "predicate_hint": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Predicate Hint"
        },
        "subject_hint": {
          "minLength": 1,
          "title": "Subject Hint",
          "type": "string"
        },
        "value_hint": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value Hint"
        }
      },
      "required": [
        "subject_hint",
        "change_kind",
        "evidence_quote",
        "confidence"
      ],
      "title": "DeclaredMemoryHint",
      "type": "object"
    },
    "MemoryHintChangeKind": {
      "enum": [
        "ADD",
        "CHANGE",
        "END",
        "UNCERTAIN"
      ],
      "title": "MemoryHintChangeKind",
      "type": "string"
    },
    "ReconciliationClass": {
      "enum": [
        "MATCHED",
        "DECLARED_ONLY",
        "OBSERVED_ONLY",
        "MISMATCHED"
      ],
      "title": "ReconciliationClass",
      "type": "string"
    },
    "StableId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "StableId",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "classification": {
      "$ref": "#/$defs/ReconciliationClass"
    },
    "comparison_id": {
      "$ref": "#/$defs/StableId"
    },
    "observation": {
      "anyOf": [
        {
          "$ref": "#/$defs/CuratorChangeObservation"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "observation_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/StableId"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "reason": {
      "minLength": 1,
      "title": "Reason",
      "type": "string"
    },
    "writer_hint": {
      "anyOf": [
        {
          "$ref": "#/$defs/DeclaredMemoryHint"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "writer_hint_index": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Writer Hint Index"
    }
  },
  "required": [
    "comparison_id",
    "classification",
    "reason"
  ],
  "title": "ReconciliationComparison",
  "type": "object"
}
