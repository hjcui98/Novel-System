{
  "$defs": {
    "DeclaredMemoryHint": {
      "additionalProperties": false,
      "properties": {
        "change_kind": {
          "$ref": "#/$defs/MemoryHintChangeKind"
        },
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "evidence_quote": {
          "minLength": 1,
          "title": "Evidence Quote",
          "type": "string"
        },
        "predicate_hint": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Predicate Hint"
        },
        "subject_hint": {
          "minLength": 1,
          "title": "Subject Hint",
          "type": "string"
        },
        "value_hint": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value Hint"
        }
      },
      "required": [
        "subject_hint",
        "change_kind",
        "evidence_quote",
        "confidence"
      ],
      "title": "DeclaredMemoryHint",
      "type": "object"
    },
    "MemoryHintChangeKind": {
      "enum": [
        "ADD",
        "CHANGE",
        "END",
        "UNCERTAIN"
      ],
      "title": "MemoryHintChangeKind",
      "type": "string"
    },
    "WriterAdvisoryFinding": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "evidence_quote": {
          "minLength": 1,
          "title": "Evidence Quote",
          "type": "string"
        },
        "hint_index": {
          "minimum": 0,
          "title": "Hint Index",
          "type": "integer"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "occurrence_count": {
          "minimum": 0,
          "title": "Occurrence Count",
          "type": "integer"
        }
      },
      "required": [
        "hint_index",
        "evidence_quote",
        "occurrence_count",
        "code",
        "message"
      ],
      "title": "WriterAdvisoryFinding",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "advisory_findings": {
      "default": [],
      "items": {
        "$ref": "#/$defs/WriterAdvisoryFinding"
      },
      "title": "Advisory Findings",
      "type": "array"
    },
    "declared_memory_hints": {
      "default": [],
      "items": {
        "$ref": "#/$defs/DeclaredMemoryHint"
      },
      "title": "Declared Memory Hints",
      "type": "array"
    },
    "self_observations": {
      "default": [],
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Self Observations",
      "type": "array"
    },
    "unresolved_questions": {
      "default": [],
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Unresolved Questions",
      "type": "array"
    }
  },
  "title": "WriterSidecar",
  "type": "object"
}
