{
  "$defs": {
    "AgentExecutionReceipt": {
      "additionalProperties": false,
      "properties": {
        "agent_mode": {
          "$ref": "#/$defs/AgentMode"
        },
        "agent_spec": {
          "$ref": "#/$defs/ContractRef"
        },
        "agent_type": {
          "$ref": "#/$defs/AgentType"
        },
        "base_commit": {
          "anyOf": [
            {
              "$ref": "#/$defs/CommitId"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "completed_at": {
          "format": "date-time",
          "title": "Completed At",
          "type": "string"
        },
        "configuration_fingerprint": {
          "$ref": "#/$defs/ArtifactId"
        },
        "context_telemetry": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Context Telemetry",
          "type": "object"
        },
        "escalations": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Escalations",
          "type": "array"
        },
        "input_artifacts": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          },
          "title": "Input Artifacts",
          "type": "array"
        },
        "latency_ms": {
          "minimum": 0,
          "title": "Latency Ms",
          "type": "integer"
        },
        "model_call_ids": {
          "default": [],
          "items": {
            "$ref": "#/$defs/StableId"
          },
          "title": "Model Call Ids",
          "type": "array"
        },
        "output_artifacts": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          },
          "title": "Output Artifacts",
          "type": "array"
        },
        "prompt_fingerprint": {
          "$ref": "#/$defs/ArtifactId"
        },
        "receipt_id": {
          "$ref": "#/$defs/StableId"
        },
        "run_id": {
          "$ref": "#/$defs/RunId"
        },
        "skill_receipts": {
          "default": [],
          "items": {
            "$ref": "#/$defs/SkillExecutionReceipt"
          },
          "title": "Skill Receipts",
          "type": "array"
        },
        "started_at": {
          "format": "date-time",
          "title": "Started At",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/ExecutionStatus"
        },
        "task_id": {
          "$ref": "#/$defs/TaskId"
        },
        "tool_call_ids": {
          "default": [],
          "items": {
            "$ref": "#/$defs/StableId"
          },
          "title": "Tool Call Ids",
          "type": "array"
        },
        "unresolved": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Unresolved",
          "type": "array"
        }
      },
      "required": [
        "receipt_id",
        "run_id",
        "task_id",
        "agent_spec",
        "agent_type",
        "agent_mode",
        "prompt_fingerprint",
        "configuration_fingerprint",
        "status",
        "started_at",
        "completed_at",
        "latency_ms"
      ],
      "title": "AgentExecutionReceipt",
      "type": "object"
    },
    "AgentMode": {
      "enum": [
        "project_bootstrap",
        "story",
        "arc_volume",
        "chapter",
        "scene",
        "replan",
        "bootstrap",
        "replay",
        "curator_repair",
        "bounded_r2",
        "risk_review",
        "draft",
        "continue",
        "major_rewrite",
        "review",
        "local_repair",
        "observe",
        "chapter_set"
      ],
      "title": "AgentMode",
      "type": "string"
    },
    "AgentType": {
      "enum": [
        "planner",
        "memory_curator",
        "memory_controller",
        "memory_guardian",
        "writer",
        "editor",
        "candidate_observer",
        "plan_reviewer"
      ],
      "title": "AgentType",
      "type": "string"
    },
    "ArtifactId": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "ArtifactId",
      "type": "string"
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/ArtifactId"
        },
        "byte_length": {
          "minimum": 0,
          "title": "Byte Length",
          "type": "integer"
        },
        "media_type": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "schema_version": {
          "$ref": "#/$defs/SchemaVersion"
        }
      },
      "required": [
        "artifact_id",
        "media_type",
        "byte_length",
        "schema_version"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "CommitId": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "CommitId",
      "type": "string"
    },
    "ContractRef": {
      "additionalProperties": false,
      "properties": {
        "content_hash": {
          "$ref": "#/$defs/ArtifactId"
        },
        "contract_id": {
          "$ref": "#/$defs/StableId"
        },
        "version": {
          "$ref": "#/$defs/SchemaVersion"
        }
      },
      "required": [
        "contract_id",
        "version",
        "content_hash"
      ],
      "title": "ContractRef",
      "type": "object"
    },
    "DraftSpan": {
      "additionalProperties": false,
      "description": "A trusted, service-generated character range in a candidate Draft.",
      "properties": {
        "block_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/StableId"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "end": {
          "minimum": 0,
          "title": "End",
          "type": "integer"
        },
        "start": {
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "DraftSpan",
      "type": "object"
    },
    "ExecutionStatus": {
      "enum": [
        "planned",
        "succeeded",
        "partial",
        "skipped",
        "failed",
        "suspended",
        "rejected"
      ],
      "title": "ExecutionStatus",
      "type": "string"
    },
    "JsonValue": {},
    "ModelCallPurpose": {
      "enum": [
        "development",
        "batch_test",
        "evaluation"
      ],
      "title": "ModelCallPurpose",
      "type": "string"
    },
    "ModelCallRecord": {
      "additionalProperties": false,
      "properties": {
        "completed_at": {
          "format": "date-time",
          "title": "Completed At",
          "type": "string"
        },
        "endpoint": {
          "minLength": 1,
          "title": "Endpoint",
          "type": "string"
        },
        "latency_ms": {
          "minimum": 0,
          "title": "Latency Ms",
          "type": "integer"
        },
        "model": {
          "minLength": 1,
          "title": "Model",
          "type": "string"
        },
        "model_role": {
          "$ref": "#/$defs/ModelRole"
        },
        "model_version": {
          "minLength": 1,
          "title": "Model Version",
          "type": "string"
        },
        "purpose": {
          "$ref": "#/$defs/ModelCallPurpose"
        },
        "request_id": {
          "$ref": "#/$defs/StableId"
        },
        "run_id": {
          "$ref": "#/$defs/RunId"
        },
        "span_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Span Id"
        },
        "started_at": {
          "format": "date-time",
          "title": "Started At",
          "type": "string"
        },
        "task_id": {
          "$ref": "#/$defs/TaskId"
        },
        "trace_id": {
          "minLength": 1,
          "title": "Trace Id",
          "type": "string"
        },
        "usage": {
          "$ref": "#/$defs/ModelUsage"
        }
      },
      "required": [
        "request_id",
        "run_id",
        "task_id",
        "model_role",
        "purpose",
        "trace_id",
        "endpoint",
        "model",
        "model_version",
        "usage",
        "latency_ms",
        "started_at",
        "completed_at"
      ],
      "title": "ModelCallRecord",
      "type": "object"
    },
    "ModelCostAvailability": {
      "enum": [
        "known",
        "unknown",
        "not_applicable"
      ],
      "title": "ModelCostAvailability",
      "type": "string"
    },
    "ModelRole": {
      "enum": [
        "implementation_model",
        "batch_test_model"
      ],
      "title": "ModelRole",
      "type": "string"
    },
    "ModelUsage": {
      "additionalProperties": false,
      "properties": {
        "cost_availability": {
          "$ref": "#/$defs/ModelCostAvailability",
          "default": "unknown"
        },
        "cost_usd": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Cost Usd"
        },
        "input_tokens": {
          "minimum": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "output_tokens": {
          "minimum": 0,
          "title": "Output Tokens",
          "type": "integer"
        },
        "reasoning_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Reasoning Tokens",
          "type": "integer"
        }
      },
      "required": [
        "input_tokens",
        "output_tokens",
        "cost_usd"
      ],
      "title": "ModelUsage",
      "type": "object"
    },
    "RunId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "RunId",
      "type": "string"
    },
    "SchemaVersion": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "title": "SchemaVersion",
      "type": "string"
    },
    "SkillContractRef": {
      "additionalProperties": false,
      "properties": {
        "content_hash": {
          "$ref": "#/$defs/ArtifactId"
        },
        "contract_id": {
          "$ref": "#/$defs/StableId"
        },
        "version": {
          "$ref": "#/$defs/SchemaVersion"
        }
      },
      "required": [
        "contract_id",
        "version",
        "content_hash"
      ],
      "title": "SkillContractRef",
      "type": "object"
    },
    "SkillExecutionReceipt": {
      "additionalProperties": false,
      "properties": {
        "agent_mode": {
          "$ref": "#/$defs/AgentMode"
        },
        "agent_type": {
          "$ref": "#/$defs/AgentType"
        },
        "base_commit": {
          "anyOf": [
            {
              "$ref": "#/$defs/CommitId"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "completed_checkpoints": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Completed Checkpoints",
          "type": "array"
        },
        "context_manifest": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactId"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "escalations": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Escalations",
          "type": "array"
        },
        "input_artifacts": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          },
          "title": "Input Artifacts",
          "type": "array"
        },
        "latency_ms": {
          "minimum": 0,
          "title": "Latency Ms",
          "type": "integer"
        },
        "output_artifacts": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          },
          "title": "Output Artifacts",
          "type": "array"
        },
        "planned_checkpoints": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Planned Checkpoints",
          "type": "array"
        },
        "receipt_id": {
          "$ref": "#/$defs/StableId"
        },
        "run_id": {
          "$ref": "#/$defs/RunId"
        },
        "selected_checkpoints": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Selected Checkpoints",
          "type": "array"
        },
        "skill": {
          "$ref": "#/$defs/SkillContractRef"
        },
        "skipped_checkpoints": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Skipped Checkpoints",
          "type": "array"
        },
        "status": {
          "$ref": "#/$defs/ExecutionStatus"
        },
        "task_id": {
          "$ref": "#/$defs/TaskId"
        },
        "tool_call_ids": {
          "default": [],
          "items": {
            "$ref": "#/$defs/StableId"
          },
          "title": "Tool Call Ids",
          "type": "array"
        },
        "unresolved": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Unresolved",
          "type": "array"
        }
      },
      "required": [
        "receipt_id",
        "run_id",
        "task_id",
        "skill",
        "agent_type",
        "agent_mode",
        "status",
        "latency_ms"
      ],
      "title": "SkillExecutionReceipt",
      "type": "object"
    },
    "StableId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "StableId",
      "type": "string"
    },
    "TaskId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "TaskId",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "A new candidate text produced by one bounded Editor local repair.",
  "properties": {
    "candidate_only": {
      "const": true,
      "default": true,
      "title": "Candidate Only",
      "type": "boolean"
    },
    "changed_spans": {
      "items": {
        "$ref": "#/$defs/DraftSpan"
      },
      "minItems": 1,
      "title": "Changed Spans",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "draft_id": {
      "$ref": "#/$defs/ArtifactId"
    },
    "editor_receipt": {
      "$ref": "#/$defs/AgentExecutionReceipt"
    },
    "model_call_record": {
      "anyOf": [
        {
          "$ref": "#/$defs/ModelCallRecord"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "parent_draft_id": {
      "$ref": "#/$defs/ArtifactId"
    },
    "preserve_verified": {
      "const": true,
      "default": true,
      "title": "Preserve Verified",
      "type": "boolean"
    },
    "repair_report_id": {
      "$ref": "#/$defs/StableId"
    },
    "text_artifact": {
      "$ref": "#/$defs/ArtifactRef"
    }
  },
  "required": [
    "draft_id",
    "parent_draft_id",
    "repair_report_id",
    "text_artifact",
    "changed_spans",
    "editor_receipt",
    "created_at"
  ],
  "title": "RepairedDraft",
  "type": "object"
}
