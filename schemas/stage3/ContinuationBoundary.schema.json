{
  "$defs": {
    "ArtifactId": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "ArtifactId",
      "type": "string"
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/ArtifactId"
        },
        "byte_length": {
          "minimum": 0,
          "title": "Byte Length",
          "type": "integer"
        },
        "media_type": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "schema_version": {
          "$ref": "#/$defs/SchemaVersion"
        }
      },
      "required": [
        "artifact_id",
        "media_type",
        "byte_length",
        "schema_version"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "SchemaVersion": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "title": "SchemaVersion",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "frozen_prefix_artifact": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "frozen_prefix_characters": {
      "minimum": 1,
      "title": "Frozen Prefix Characters",
      "type": "integer"
    },
    "parent_draft_id": {
      "$ref": "#/$defs/ArtifactId"
    }
  },
  "required": [
    "parent_draft_id",
    "frozen_prefix_artifact",
    "frozen_prefix_characters"
  ],
  "title": "ContinuationBoundary",
  "type": "object"
}
