{
  "$defs": {
    "AcceptedPlanBinding": {
      "additionalProperties": false,
      "properties": {
        "accepted": {
          "const": true,
          "default": true,
          "title": "Accepted",
          "type": "boolean"
        },
        "artifact": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "base_commit": {
          "$ref": "#/$defs/CommitId"
        },
        "revision": {
          "minLength": 1,
          "title": "Revision",
          "type": "string"
        },
        "snapshot_id": {
          "$ref": "#/$defs/StableId"
        },
        "task_contract_id": {
          "$ref": "#/$defs/StableId"
        }
      },
      "required": [
        "artifact",
        "revision",
        "task_contract_id",
        "base_commit",
        "snapshot_id"
      ],
      "title": "AcceptedPlanBinding",
      "type": "object"
    },
    "AgentMode": {
      "enum": [
        "project_bootstrap",
        "story",
        "arc_volume",
        "chapter",
        "scene",
        "replan",
        "bootstrap",
        "replay",
        "curator_repair",
        "bounded_r2",
        "risk_review",
        "draft",
        "continue",
        "major_rewrite",
        "review",
        "local_repair",
        "observe",
        "chapter_set"
      ],
      "title": "AgentMode",
      "type": "string"
    },
    "ArtifactId": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "ArtifactId",
      "type": "string"
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/ArtifactId"
        },
        "byte_length": {
          "minimum": 0,
          "title": "Byte Length",
          "type": "integer"
        },
        "media_type": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "schema_version": {
          "$ref": "#/$defs/SchemaVersion"
        }
      },
      "required": [
        "artifact_id",
        "media_type",
        "byte_length",
        "schema_version"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "BenchmarkInformationProfile": {
      "enum": [
        "visible_at_cutoff",
        "task_intent_only",
        "author_plan_conditioned"
      ],
      "title": "BenchmarkInformationProfile",
      "type": "string"
    },
    "BenchmarkTaskContract": {
      "additionalProperties": false,
      "properties": {
        "checkpoint_chapter": {
          "minimum": 0,
          "title": "Checkpoint Chapter",
          "type": "integer"
        },
        "information_profile": {
          "$ref": "#/$defs/BenchmarkInformationProfile"
        },
        "output_contract_version": {
          "minLength": 1,
          "title": "Output Contract Version",
          "type": "string"
        },
        "planning_context_hash": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactId"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "planning_context_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactId"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "target_chapter_end": {
          "minimum": 1,
          "title": "Target Chapter End",
          "type": "integer"
        },
        "target_chapter_start": {
          "minimum": 1,
          "title": "Target Chapter Start",
          "type": "integer"
        },
        "task_id": {
          "$ref": "#/$defs/StableId"
        },
        "task_intent": {
          "default": "",
          "title": "Task Intent",
          "type": "string"
        },
        "task_kind": {
          "const": "memory_context_for_target_range",
          "default": "memory_context_for_target_range",
          "title": "Task Kind",
          "type": "string"
        },
        "task_template_version": {
          "minLength": 1,
          "title": "Task Template Version",
          "type": "string"
        },
        "task_text": {
          "minLength": 1,
          "title": "Task Text",
          "type": "string"
        }
      },
      "required": [
        "task_id",
        "task_text",
        "checkpoint_chapter",
        "target_chapter_start",
        "target_chapter_end",
        "information_profile",
        "task_template_version",
        "output_contract_version"
      ],
      "title": "BenchmarkTaskContract",
      "type": "object"
    },
    "CanonicalAliasReceipt": {
      "additionalProperties": false,
      "description": "Predicate-scoped proof that a versioned registry equates two raw values.",
      "properties": {
        "canonical_value_id": {
          "$ref": "#/$defs/StableId"
        },
        "canonicalizer_version": {
          "minLength": 1,
          "title": "Canonicalizer Version",
          "type": "string"
        },
        "predicate": {
          "minLength": 1,
          "title": "Predicate",
          "type": "string"
        },
        "raw_values": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "string"
            },
            {
              "type": "string"
            }
          ],
          "title": "Raw Values",
          "type": "array"
        },
        "receipt_id": {
          "$ref": "#/$defs/StableId"
        },
        "registry_version": {
          "minLength": 1,
          "title": "Registry Version",
          "type": "string"
        }
      },
      "required": [
        "receipt_id",
        "registry_version",
        "predicate",
        "raw_values",
        "canonical_value_id",
        "canonicalizer_version"
      ],
      "title": "CanonicalAliasReceipt",
      "type": "object"
    },
    "CommitId": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "CommitId",
      "type": "string"
    },
    "ContextAssemblyStatus": {
      "enum": [
        "READY",
        "NEEDS_REDUCTION",
        "CONTEXT_BUDGET_INSUFFICIENT",
        "EVIDENCE_INSUFFICIENT",
        "POLICY_BLOCKED"
      ],
      "title": "ContextAssemblyStatus",
      "type": "string"
    },
    "ContextGap": {
      "additionalProperties": false,
      "properties": {
        "conflict": {
          "default": false,
          "title": "Conflict",
          "type": "boolean"
        },
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "gap_id": {
          "$ref": "#/$defs/StableId"
        },
        "need_ids": {
          "default": [],
          "items": {
            "$ref": "#/$defs/StableId"
          },
          "title": "Need Ids",
          "type": "array"
        }
      },
      "required": [
        "gap_id",
        "description"
      ],
      "title": "ContextGap",
      "type": "object"
    },
    "ContextLineage": {
      "additionalProperties": false,
      "properties": {
        "assembler_version": {
          "minLength": 1,
          "title": "Assembler Version",
          "type": "string"
        },
        "canonical_alias_receipt_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          },
          "title": "Canonical Alias Receipt Refs",
          "type": "array"
        },
        "canonical_alias_receipts": {
          "default": [],
          "items": {
            "$ref": "#/$defs/CanonicalAliasReceipt"
          },
          "title": "Canonical Alias Receipts",
          "type": "array"
        },
        "context_assembly_spec_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "need_ids": {
          "default": [],
          "items": {
            "$ref": "#/$defs/StableId"
          },
          "title": "Need Ids",
          "type": "array"
        },
        "normalized_unit_count": {
          "minimum": 0,
          "title": "Normalized Unit Count",
          "type": "integer"
        },
        "retrieval_unit_ids": {
          "default": [],
          "items": {
            "$ref": "#/$defs/StableId"
          },
          "title": "Retrieval Unit Ids",
          "type": "array"
        },
        "selected_claim_variant_ids": {
          "default": [],
          "items": {
            "$ref": "#/$defs/StableId"
          },
          "title": "Selected Claim Variant Ids",
          "type": "array"
        }
      },
      "required": [
        "assembler_version",
        "normalized_unit_count"
      ],
      "title": "ContextLineage",
      "type": "object"
    },
    "FutureIsolationAttestation": {
      "additionalProperties": false,
      "properties": {
        "attestation_id": {
          "$ref": "#/$defs/StableId"
        },
        "canonical_source_ids": {
          "items": {
            "$ref": "#/$defs/StableId"
          },
          "title": "Canonical Source Ids",
          "type": "array"
        },
        "checkpoint_chapter": {
          "minimum": 0,
          "title": "Checkpoint Chapter",
          "type": "integer"
        },
        "configuration_fingerprint": {
          "$ref": "#/$defs/ArtifactId"
        },
        "evaluator_only_source_ids": {
          "items": {
            "$ref": "#/$defs/StableId"
          },
          "title": "Evaluator Only Source Ids",
          "type": "array"
        },
        "overlap_source_ids": {
          "default": [],
          "items": {
            "$ref": "#/$defs/StableId"
          },
          "title": "Overlap Source Ids",
          "type": "array"
        },
        "passed": {
          "title": "Passed",
          "type": "boolean"
        }
      },
      "required": [
        "attestation_id",
        "checkpoint_chapter",
        "canonical_source_ids",
        "evaluator_only_source_ids",
        "passed",
        "configuration_fingerprint"
      ],
      "title": "FutureIsolationAttestation",
      "type": "object"
    },
    "ProjectId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "ProjectId",
      "type": "string"
    },
    "RunId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "RunId",
      "type": "string"
    },
    "SchemaVersion": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "title": "SchemaVersion",
      "type": "string"
    },
    "StableId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "StableId",
      "type": "string"
    },
    "TaskId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "TaskId",
      "type": "string"
    },
    "WriterContextBudgetReport": {
      "additionalProperties": false,
      "properties": {
        "actual_rendered_writer_tokens": {
          "minimum": 0,
          "title": "Actual Rendered Writer Tokens",
