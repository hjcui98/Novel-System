          "type": "number"
        },
        "context_item_id": {
          "$ref": "#/$defs/StableId"
        },
        "evidence_ledger_ids": {
          "items": {
            "$ref": "#/$defs/StableId"
          },
          "title": "Evidence Ledger Ids",
