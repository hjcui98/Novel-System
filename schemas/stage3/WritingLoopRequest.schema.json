{
  "$defs": {
    "AcceptedPlanBinding": {
      "additionalProperties": false,
      "properties": {
        "accepted": {
          "const": true,
          "default": true,
          "title": "Accepted",
          "type": "boolean"
        },
        "artifact": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "base_commit": {
          "$ref": "#/$defs/CommitId"
        },
        "revision": {
          "minLength": 1,
          "title": "Revision",
          "type": "string"
        },
        "snapshot_id": {
          "$ref": "#/$defs/StableId"
        },
        "task_contract_id": {
          "$ref": "#/$defs/StableId"
        }
      },
      "required": [
        "artifact",
        "revision",
        "task_contract_id",
        "base_commit",
        "snapshot_id"
      ],
      "title": "AcceptedPlanBinding",
      "type": "object"
    },
    "AgentMode": {
      "enum": [
        "project_bootstrap",
        "story",
        "arc_volume",
        "chapter",
        "scene",
        "replan",
        "bootstrap",
        "replay",
        "curator_repair",
        "bounded_r2",
        "risk_review",
        "draft",
        "continue",
        "major_rewrite",
        "review",
        "local_repair",
        "observe",
        "chapter_set"
      ],
      "title": "AgentMode",
      "type": "string"
    },
    "ArtifactId": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "ArtifactId",
      "type": "string"
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/ArtifactId"
        },
        "byte_length": {
          "minimum": 0,
          "title": "Byte Length",
          "type": "integer"
        },
        "media_type": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "schema_version": {
          "$ref": "#/$defs/SchemaVersion"
        }
      },
      "required": [
        "artifact_id",
        "media_type",
        "byte_length",
        "schema_version"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "BenchmarkInformationProfile": {
      "enum": [
        "visible_at_cutoff",
        "task_intent_only",
        "author_plan_conditioned"
      ],
      "title": "BenchmarkInformationProfile",
      "type": "string"
    },
    "BenchmarkTaskContract": {
      "additionalProperties": false,
      "properties": {
        "checkpoint_chapter": {
          "minimum": 0,
          "title": "Checkpoint Chapter",
          "type": "integer"
        },
        "information_profile": {
          "$ref": "#/$defs/BenchmarkInformationProfile"
        },
        "output_contract_version": {
          "minLength": 1,
          "title": "Output Contract Version",
          "type": "string"
        },
        "planning_context_hash": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactId"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "planning_context_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactId"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "target_chapter_end": {
          "minimum": 1,
          "title": "Target Chapter End",
          "type": "integer"
        },
        "target_chapter_start": {
          "minimum": 1,
          "title": "Target Chapter Start",
          "type": "integer"
        },
        "task_id": {
          "$ref": "#/$defs/StableId"
        },
        "task_intent": {
          "default": "",
          "title": "Task Intent",
          "type": "string"
        },
        "task_kind": {
          "const": "memory_context_for_target_range",
          "default": "memory_context_for_target_range",
          "title": "Task Kind",
          "type": "string"
        },
        "task_template_version": {
          "minLength": 1,
          "title": "Task Template Version",
          "type": "string"
        },
        "task_text": {
          "minLength": 1,
          "title": "Task Text",
          "type": "string"
        }
      },
      "required": [
        "task_id",
        "task_text",
        "checkpoint_chapter",
        "target_chapter_start",
        "target_chapter_end",
        "information_profile",
        "task_template_version",
        "output_contract_version"
      ],
      "title": "BenchmarkTaskContract",
      "type": "object"
    },
    "CanonicalAliasReceipt": {
      "additionalProperties": false,
      "description": "Predicate-scoped proof that a versioned registry equates two raw values.",
      "properties": {
        "canonical_value_id": {
          "$ref": "#/$defs/StableId"
        },
        "canonicalizer_version": {
          "minLength": 1,
          "title": "Canonicalizer Version",
          "type": "string"
        },
        "predicate": {
          "minLength": 1,
          "title": "Predicate",
          "type": "string"
        },
        "raw_values": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "string"
            },
            {
              "type": "string"
            }
          ],
          "title": "Raw Values",
          "type": "array"
        },
        "receipt_id": {
          "$ref": "#/$defs/StableId"
        },
        "registry_version": {
          "minLength": 1,
          "title": "Registry Version",
          "type": "string"
        }
      },
      "required": [
        "receipt_id",
        "registry_version",
        "predicate",
        "raw_values",
        "canonical_value_id",
        "canonicalizer_version"
      ],
      "title": "CanonicalAliasReceipt",
      "type": "object"
    },
    "CommitId": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "CommitId",
      "type": "string"
    },
    "ContextAssemblyStatus": {
      "enum": [
        "READY",
        "NEEDS_REDUCTION",
        "CONTEXT_BUDGET_INSUFFICIENT",
        "EVIDENCE_INSUFFICIENT",
        "POLICY_BLOCKED"
      ],
      "title": "ContextAssemblyStatus",
      "type": "string"
    },
    "ContextGap": {
      "additionalProperties": false,
      "properties": {
        "conflict": {
          "default": false,
          "title": "Conflict",
          "type": "boolean"
        },
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "gap_id": {
          "$ref": "#/$defs/StableId"
        },
        "need_ids": {
          "default": [],
          "items": {
            "$ref": "#/$defs/StableId"
          },
          "title": "Need Ids",
          "type": "array"
        }
      },
      "required": [
        "gap_id",
        "description"
      ],
      "title": "ContextGap",
      "type": "object"
    },
    "ContextLineage": {
      "additionalProperties": false,
      "properties": {
        "assembler_version": {
          "minLength": 1,
          "title": "Assembler Version",
          "type": "string"
        },
        "canonical_alias_receipt_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          },
          "title": "Canonical Alias Receipt Refs",
          "type": "array"
        },
        "canonical_alias_receipts": {
          "default": [],
          "items": {
            "$ref": "#/$defs/CanonicalAliasReceipt"
          },
          "title": "Canonical Alias Receipts",
          "type": "array"
        },
        "context_assembly_spec_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "need_ids": {
          "default": [],
          "items": {
            "$ref": "#/$defs/StableId"
          },
          "title": "Need Ids",
          "type": "array"
        },
        "normalized_unit_count": {
          "minimum": 0,
          "title": "Normalized Unit Count",
          "type": "integer"
        },
        "retrieval_unit_ids": {
          "default": [],
          "items": {
            "$ref": "#/$defs/StableId"
          },
          "title": "Retrieval Unit Ids",
          "type": "array"
        },
        "selected_claim_variant_ids": {
          "default": [],
          "items": {
            "$ref": "#/$defs/StableId"
          },
          "title": "Selected Claim Variant Ids",
          "type": "array"
        }
      },
      "required": [
        "assembler_version",
        "normalized_unit_count"
      ],
      "title": "ContextLineage",
      "type": "object"
    },
    "EvidenceFirstGap": {
      "additionalProperties": false,
      "properties": {
        "gap_id": {
          "$ref": "#/$defs/StableId"
        },
        "kind": {
          "$ref": "#/$defs/EvidenceGapKind"
        },
        "need_facet_ids": {
          "items": {
            "$ref": "#/$defs/StableId"
          },
          "title": "Need Facet Ids",
          "type": "array"
        },
        "need_ids": {
          "items": {
            "$ref": "#/$defs/StableId"
          },
          "title": "Need Ids",
          "type": "array"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "gap_id",
        "need_ids",
        "need_facet_ids",
        "kind",
        "reason"
      ],
      "title": "EvidenceFirstGap",
      "type": "object"
    },
    "EvidenceFirstLineage": {
      "additionalProperties": false,
      "properties": {
        "assembler_version": {
          "minLength": 1,
          "title": "Assembler Version",
          "type": "string"
        },
        "generator_version": {
          "default": "",
          "title": "Generator Version",
          "type": "string"
        },
        "grounder_version": {
          "default": "",
          "title": "Grounder Version",
          "type": "string"
        },
        "need_ids": {
          "default": [],
          "items": {
            "$ref": "#/$defs/StableId"
          },
          "title": "Need Ids",
          "type": "array"
        },
        "planner_artifact_hash": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactId"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "planner_artifact_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "planner_fallback_used": {
          "default": false,
          "title": "Planner Fallback Used",
          "type": "boolean"
        },
        "query_compiler_version": {
          "default": "",
          "title": "Query Compiler Version",
          "type": "string"
        },
        "resolver_version": {
          "default": "",
          "title": "Resolver Version",
          "type": "string"
        },
        "route_plan_version": {
          "default": "",
          "title": "Route Plan Version",
          "type": "string"
        },
        "semantic_judge_version": {
          "default": "",
          "title": "Semantic Judge Version",
          "type": "string"
        },
        "unresolved_lexical_anchors": {
          "default": [],
          "items": {
            "$ref": "#/$defs/UnresolvedLexicalAnchor"
          },
          "title": "Unresolved Lexical Anchors",
          "type": "array"
        },
        "validator_version": {
          "default": "",
          "title": "Validator Version",
          "type": "string"
        }
      },
      "required": [
        "assembler_version"
      ],
      "title": "EvidenceFirstLineage",
      "type": "object"
    },
    "EvidenceGapKind": {
      "enum": [
        "no_selected_evidence",
        "budget_exceeded",
        "slice_oversized",
        "cutoff_tainted",
        "scope_tainted",
        "dereference_failed",
        "heading_source_role",
        "semantic_partial",
        "semantic_unsupported",
        "semantic_unresolved"
      ],
      "title": "EvidenceGapKind",
      "type": "string"
    },
    "FutureIsolationAttestation": {
      "additionalProperties": false,
      "properties": {
        "attestation_id": {
          "$ref": "#/$defs/StableId"
        },
        "canonical_source_ids": {
          "items": {
            "$ref": "#/$defs/StableId"
          },
          "title": "Canonical Source Ids",
          "type": "array"
        },
        "checkpoint_chapter": {
          "minimum": 0,
          "title": "Checkpoint Chapter",
          "type": "integer"
        },
        "configuration_fingerprint": {
          "$ref": "#/$defs/ArtifactId"
        },
        "evaluator_only_source_ids": {
          "items": {
            "$ref": "#/$defs/StableId"
          },
          "title": "Evaluator Only Source Ids",
          "type": "array"
        },
        "overlap_source_ids": {
          "default": [],
          "items": {
            "$ref": "#/$defs/StableId"
          },
          "title": "Overlap Source Ids",
          "type": "array"
        },
        "passed": {
          "title": "Passed",
          "type": "boolean"
        }
      },
      "required": [
        "attestation_id",
        "checkpoint_chapter",
        "canonical_source_ids",
        "evaluator_only_source_ids",
        "passed",
        "configuration_fingerprint"
      ],
      "title": "FutureIsolationAttestation",
      "type": "object"
    },
    "NeedEvidenceJudgmentBatchReceipt": {
      "additionalProperties": false,
      "description": "Auditable input/output boundary for one semantic-judge request.",
      "properties": {
        "batch_id": {
          "$ref": "#/$defs/StableId"
        },
        "endpoint": {
          "default": "",
          "title": "Endpoint",
          "type": "string"
        },
        "error_category": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error Category"
        },
        "input_tokens": {
          "minimum": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "model": {
          "default": "",
          "title": "Model",
          "type": "string"
        },
        "model_version": {
          "default": "",
          "title": "Model Version",
          "type": "string"
        },
        "need_facet_ids": {
          "items": {
            "$ref": "#/$defs/StableId"
          },
          "title": "Need Facet Ids",
          "type": "array"
        },
        "output_tokens": {
          "minimum": 0,
          "title": "Output Tokens",
          "type": "integer"
        },
        "request_id": {
          "$ref": "#/$defs/StableId"
        },
        "slice_ids": {
          "items": {
            "$ref": "#/$defs/StableId"
          },
          "title": "Slice Ids",
          "type": "array"
        },
        "status": {
          "$ref": "#/$defs/NeedEvidenceJudgmentBatchStatus"
        }
      },
      "required": [
        "batch_id",
        "request_id",
        "need_facet_ids",
        "slice_ids",
        "status",
        "input_tokens",
        "output_tokens"
      ],
      "title": "NeedEvidenceJudgmentBatchReceipt",
      "type": "object"
    },
    "NeedEvidenceJudgmentBatchStatus": {
      "enum": [
        "completed",
        "failed"
      ],
      "title": "NeedEvidenceJudgmentBatchStatus",
      "type": "string"
    },
    "NeedEvidenceSemanticStatus": {
      "description": "Model relevance verdict for one public Need/facet evidence set.",
      "enum": [
        "SUPPORTED",
        "PARTIAL",
        "UNSUPPORTED",
        "UNRESOLVED"
      ],
      "title": "NeedEvidenceSemanticStatus",
      "type": "string"
    },
    "NeedFacetSemanticReceipt": {
      "additionalProperties": false,
      "description": "Final semantic relevance receipt for one mandatory public facet.",
      "properties": {
        "batch_receipt_ids": {
          "default": [],
          "items": {
            "$ref": "#/$defs/StableId"
          },
          "title": "Batch Receipt Ids",
          "type": "array"
        },
        "evaluated_slice_ids": {
          "default": [],
          "items": {
            "$ref": "#/$defs/StableId"
          },
          "title": "Evaluated Slice Ids",
          "type": "array"
        },
        "facet_kind": {
          "minLength": 1,
          "title": "Facet Kind",
          "type": "string"
        },
        "judge_version": {
          "default": "",
          "minLength": 0,
          "title": "Judge Version",
          "type": "string"
        },
        "mandatory": {
          "title": "Mandatory",
          "type": "boolean"
        },
        "need_facet_id": {
          "$ref": "#/$defs/StableId"
        },
        "need_id": {
          "$ref": "#/$defs/StableId"
        },
        "partial_slice_ids": {
          "default": [],
          "items": {
            "$ref": "#/$defs/StableId"
          },
          "title": "Partial Slice Ids",
          "type": "array"
        },
        "reason": {
          "default": "",
          "maxLength": 4096,
          "title": "Reason",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/NeedEvidenceSemanticStatus"
        },
        "supporting_slice_ids": {
          "default": [],
          "items": {
            "$ref": "#/$defs/StableId"
          },
          "title": "Supporting Slice Ids",
          "type": "array"
        },
        "unsupported_slice_ids": {
          "default": [],
          "items": {
            "$ref": "#/$defs/StableId"
          },
          "title": "Unsupported Slice Ids",
          "type": "array"
        }
      },
      "required": [
        "need_id",
        "need_facet_id",
        "facet_kind",
        "mandatory",
        "status"
      ],
      "title": "NeedFacetSemanticReceipt",
      "type": "object"
    },
    "ProjectId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "ProjectId",
      "type": "string"
    },
    "RecentChapterProse": {
      "additionalProperties": false,
      "description": "One committed recent chapter with an exact full-text artifact and compact trail.",
      "properties": {
        "chapter_id": {
          "$ref": "#/$defs/StableId"
        },
        "chapter_index": {
          "minimum": 1,
          "title": "Chapter Index",
          "type": "integer"
        },
        "compact_trail": {
          "minLength": 1,
          "title": "Compact Trail",
          "type": "string"
        },
        "full_text_artifact": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "full_text_characters": {
          "minimum": 1,
          "title": "Full Text Characters",
          "type": "integer"
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title"
        }
      },
      "required": [
        "chapter_id",
        "chapter_index",
        "full_text_artifact",
        "full_text_characters",
        "compact_trail"
      ],
      "title": "RecentChapterProse",
      "type": "object"
    },
    "RecentProseContext": {
      "additionalProperties": false,
      "description": "Deterministic near-prose context projected from the accepted TextRoot.",
      "properties": {
        "base_commit": {
          "$ref": "#/$defs/CommitId"
        },
        "checkpoint_chapter": {
          "minimum": 0,
          "title": "Checkpoint Chapter",
          "type": "integer"
        },
        "context_id": {
          "$ref": "#/$defs/StableId"
        },
        "earlier_chapters": {
          "default": [],
          "items": {
            "$ref": "#/$defs/RecentChapterProse"
          },
          "title": "Earlier Chapters",
          "type": "array"
        },
        "previous_chapter": {
          "anyOf": [
            {
              "$ref": "#/$defs/RecentChapterProse"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "snapshot_id": {
          "$ref": "#/$defs/StableId"
        }
      },
      "required": [
        "context_id",
        "base_commit",
        "snapshot_id",
        "checkpoint_chapter"
      ],
      "title": "RecentProseContext",
      "type": "object"
    },
    "RunId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "RunId",
      "type": "string"
    },
    "SchemaVersion": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "title": "SchemaVersion",
      "type": "string"
    },
    "StableId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "StableId",
      "type": "string"
    },
    "TaskId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "TaskId",
      "type": "string"
    },
    "UnresolvedLexicalAnchor": {
      "additionalProperties": false,
      "properties": {
        "grounding_method": {
          "default": "no_label_match",
          "title": "Grounding Method",
          "type": "string"
        },
        "mention": {
          "minLength": 1,
          "title": "Mention",
          "type": "string"
        },
        "source_draft_id": {
          "minLength": 1,
          "title": "Source Draft Id",
          "type": "string"
        },
        "source_fields": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Source Fields",
          "type": "array"
        }
      },
      "required": [
        "mention",
        "source_draft_id"
      ],
      "title": "UnresolvedLexicalAnchor",
      "type": "object"
    },
    "WriterContextBudgetReport": {
      "additionalProperties": false,
      "properties": {
        "actual_rendered_writer_tokens": {
          "minimum": 0,
          "title": "Actual Rendered Writer Tokens",
          "type": "integer"
        },
        "configured_writer_token_budget": {
          "minimum": 1,
          "title": "Configured Writer Token Budget",
          "type": "integer"
        },
        "deduplicated_item_count": {
          "minimum": 0,
          "title": "Deduplicated Item Count",
          "type": "integer"
        },
        "dropped_optional_ids": {
          "default": [],
          "items": {
            "$ref": "#/$defs/StableId"
          },
          "title": "Dropped Optional Ids",
          "type": "array"
        },
        "dropped_optional_reasons": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Dropped Optional Reasons",
          "type": "object"
        },
        "evidence_ledger_tokens": {
          "minimum": 0,
          "title": "Evidence Ledger Tokens",
          "type": "integer"
        },
        "final_status": {
          "$ref": "#/$defs/ContextAssemblyStatus"
        },
        "header_citation_gap_tokens": {
          "minimum": 0,
          "title": "Header Citation Gap Tokens",
          "type": "integer"
        },
        "mandatory_conclusion_tokens": {
          "minimum": 0,
          "title": "Mandatory Conclusion Tokens",
          "type": "integer"
        },
        "optional_conclusion_tokens": {
          "minimum": 0,
          "title": "Optional Conclusion Tokens",
