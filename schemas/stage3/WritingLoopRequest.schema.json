        "support_receipt_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "validity": {
          "$ref": "#/$defs/WriterContextValidity"
        }
