      "required": [
        "context_item_id",
        "section",
        "claim",
        "validity",
        "mandatory",
        "confidence",
        "need_ids",
        "retrieval_unit_ids",
        "evidence_ledger_ids"
      ],
      "title": "WriterContextItem",
      "type": "object"
