        },
        "need_ids": {
          "items": {
            "$ref": "#/$defs/StableId"
          },
          "title": "Need Ids",
          "type": "array"
        },
        "retrieval_unit_ids": {
          "items": {
            "$ref": "#/$defs/StableId"
          },
          "title": "Retrieval Unit Ids",
          "type": "array"
        },
        "section": {
          "$ref": "#/$defs/WriterContextSection"
        },
        "supersedes_item_ids": {
          "default": [],
          "items": {
            "$ref": "#/$defs/StableId"
          },
          "title": "Supersedes Item Ids",
          "type": "array"
        },
        "support_group_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/StableId"
            },
            {
              "type": "null"
            }
          ],
          "default": null
