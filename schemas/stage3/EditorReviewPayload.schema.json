{
  "$defs": {
    "EditorialIssueDraft": {
      "additionalProperties": false,
      "description": "Untrusted model issue output; offsets and IDs are bound by the service.",
      "properties": {
        "block_hint": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Block Hint"
        },
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "evidence_quote": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence Quote"
        },
        "issue_type": {
          "$ref": "#/$defs/EditorialIssueType"
        },
        "occurrence": {
          "default": 0,
          "minimum": 0,
          "title": "Occurrence",
          "type": "integer"
        },
        "repairable": {
          "default": false,
          "title": "Repairable",
          "type": "boolean"
        },
        "severity": {
          "$ref": "#/$defs/EditorialSeverity"
        },
        "structural": {
          "default": false,
          "title": "Structural",
          "type": "boolean"
        }
      },
      "required": [
        "issue_type",
        "severity",
        "description"
      ],
      "title": "EditorialIssueDraft",
      "type": "object"
    },
    "EditorialIssueType": {
      "enum": [
        "constraint_violation",
        "continuity",
        "pov",
        "disclosure",
        "plan",
        "style",
        "context_gap",
        "unsupported_change",
        "structure"
      ],
      "title": "EditorialIssueType",
      "type": "string"
    },
    "EditorialSeverity": {
      "enum": [
        "info",
        "warning",
        "error",
        "critical"
      ],
      "title": "EditorialSeverity",
      "type": "string"
    },
    "EditorialVerdict": {
      "description": "The only routing outcomes an Editor may produce.",
      "enum": [
        "PASS",
        "LOCAL_REPAIR",
        "MAJOR_REWRITE"
      ],
      "title": "EditorialVerdict",
      "type": "string"
    },
    "MemoryGapAssessment": {
      "additionalProperties": false,
      "properties": {
        "affected_criterion_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Affected Criterion Ids",
          "type": "array"
        },
        "disposition": {
          "enum": [
            "avoided",
            "supported",
            "blocking"
          ],
          "title": "Disposition",
          "type": "string"
        },
        "draft_evidence_quotes": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Draft Evidence Quotes",
          "type": "array"
        },
        "evidence_quotes": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Evidence Quotes",
          "type": "array"
        },
        "gap": {
          "minLength": 1,
          "title": "Gap",
          "type": "string"
        },
        "rationale": {
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "required_for_plan": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Required For Plan"
        }
      },
      "required": [
        "gap",
        "disposition",
        "rationale"
      ],
      "title": "MemoryGapAssessment",
      "type": "object"
    },
    "PlanRequirementAssessment": {
      "additionalProperties": false,
      "description": "Independent Editor judgment bound by the host to a named criterion and actual prose.",
      "properties": {
        "criterion_id": {
          "minLength": 1,
          "title": "Criterion Id",
          "type": "string"
        },
        "evidence_quotes": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Evidence Quotes",
          "type": "array"
        },
        "rationale": {
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "satisfied": {
          "title": "Satisfied",
          "type": "boolean"
        }
      },
      "required": [
        "criterion_id",
        "satisfied",
        "rationale"
      ],
      "title": "PlanRequirementAssessment",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Structured response accepted from the Editor REVIEW model call.",
  "properties": {
    "issues": {
      "default": [],
      "items": {
        "$ref": "#/$defs/EditorialIssueDraft"
      },
      "title": "Issues",
      "type": "array"
    },
    "memory_gap_assessments": {
      "default": [],
      "items": {
        "$ref": "#/$defs/MemoryGapAssessment"
      },
      "title": "Memory Gap Assessments",
      "type": "array"
    },
    "plan_assessments": {
      "default": [],
      "items": {
        "$ref": "#/$defs/PlanRequirementAssessment"
      },
      "title": "Plan Assessments",
      "type": "array"
    },
    "planner_replan_required": {
      "default": false,
      "title": "Planner Replan Required",
      "type": "boolean"
    },
    "preserve_requirements": {
      "default": [],
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Preserve Requirements",
      "type": "array"
    },
    "repair_instructions": {
      "default": [],
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Repair Instructions",
      "type": "array"
    },
    "rewrite_preserve_requirements": {
      "default": [],
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Rewrite Preserve Requirements",
      "type": "array"
    },
    "rewrite_targets": {
      "default": [],
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Rewrite Targets",
      "type": "array"
    },
    "unresolved_needs": {
      "default": [],
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Unresolved Needs",
      "type": "array"
    },
    "verdict": {
      "$ref": "#/$defs/EditorialVerdict"
    }
  },
  "required": [
    "verdict"
  ],
  "title": "EditorReviewPayload",
  "type": "object"
}
