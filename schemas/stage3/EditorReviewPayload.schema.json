{
  "$defs": {
    "EditorialConstraintSource": {
      "additionalProperties": false,
      "description": "The visible constraint a blocking Editor issue claims to violate.",
      "properties": {
        "conflict_reason": {
          "minLength": 1,
          "title": "Conflict Reason",
          "type": "string"
        },
        "context_item_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/StableId"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "field_name": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Field Name"
        },
        "kind": {
          "$ref": "#/$defs/EditorialConstraintSourceKind"
        }
      },
      "required": [
        "kind",
        "conflict_reason"
      ],
      "title": "EditorialConstraintSource",
      "type": "object"
    },
    "EditorialConstraintSourceKind": {
      "enum": [
        "writing_task_field",
        "context_item",
        "chapter_scope"
      ],
      "title": "EditorialConstraintSourceKind",
      "type": "string"
    },
    "EditorialEvidenceScope": {
      "enum": [
        "quote",
        "chapter"
      ],
      "title": "EditorialEvidenceScope",
      "type": "string"
    },
    "EditorialIssueDraft": {
      "additionalProperties": false,
      "description": "Untrusted model issue output; offsets and IDs are bound by the service.",
      "properties": {
        "block_hint": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Block Hint"
        },
        "constraint_source": {
          "anyOf": [
            {
              "$ref": "#/$defs/EditorialConstraintSource"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "evidence_quote": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence Quote"
        },
        "evidence_scope": {
          "$ref": "#/$defs/EditorialEvidenceScope",
          "default": "quote"
        },
        "issue_type": {
          "$ref": "#/$defs/EditorialIssueType"
        },
        "occurrence": {
          "default": 0,
          "minimum": 0,
          "title": "Occurrence",
          "type": "integer"
        },
        "repairable": {
          "default": false,
          "title": "Repairable",
          "type": "boolean"
        },
        "severity": {
          "$ref": "#/$defs/EditorialSeverity"
        },
        "structural": {
          "default": false,
          "title": "Structural",
          "type": "boolean"
        }
      },
      "required": [
        "issue_type",
        "severity",
        "description"
      ],
      "title": "EditorialIssueDraft",
      "type": "object"
    },
    "EditorialIssueType": {
      "enum": [
        "constraint_violation",
        "continuity",
        "pov",
        "disclosure",
        "plan",
        "style",
        "context_gap",
        "unsupported_change",
        "structure"
      ],
      "title": "EditorialIssueType",
      "type": "string"
    },
    "EditorialSeverity": {
      "enum": [
        "info",
        "warning",
        "error",
        "critical"
      ],
      "title": "EditorialSeverity",
      "type": "string"
    },
    "EditorialVerdict": {
      "description": "The only routing outcomes an Editor may produce.",
      "enum": [
        "PASS",
        "LOCAL_REPAIR",
        "MAJOR_REWRITE"
      ],
      "title": "EditorialVerdict",
      "type": "string"
    },
    "StableId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "StableId",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Structured response accepted from the Editor REVIEW model call.",
  "properties": {
    "issues": {
      "default": [],
      "items": {
        "$ref": "#/$defs/EditorialIssueDraft"
      },
      "title": "Issues",
      "type": "array"
    },
    "planner_replan_required": {
      "default": false,
      "title": "Planner Replan Required",
      "type": "boolean"
    },
    "preserve_requirements": {
      "default": [],
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Preserve Requirements",
      "type": "array"
    },
    "repair_instructions": {
      "default": [],
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Repair Instructions",
      "type": "array"
    },
    "rewrite_preserve_requirements": {
      "default": [],
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Rewrite Preserve Requirements",
      "type": "array"
    },
    "rewrite_targets": {
      "default": [],
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Rewrite Targets",
      "type": "array"
    },
    "unresolved_needs": {
      "default": [],
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Unresolved Needs",
      "type": "array"
    },
    "verdict": {
      "$ref": "#/$defs/EditorialVerdict"
    }
  },
  "required": [
    "verdict"
  ],
  "title": "EditorReviewPayload",
  "type": "object"
}
