{
  "$defs": {
    "DeclaredMemoryHint": {
      "additionalProperties": false,
      "properties": {
        "change_kind": {
          "$ref": "#/$defs/MemoryHintChangeKind"
        },
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "evidence_quote": {
          "minLength": 1,
          "title": "Evidence Quote",
          "type": "string"
        },
        "predicate_hint": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Predicate Hint"
        },
        "subject_hint": {
          "minLength": 1,
          "title": "Subject Hint",
          "type": "string"
        },
        "value_hint": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value Hint"
        }
      },
      "required": [
        "subject_hint",
        "change_kind",
        "evidence_quote",
        "confidence"
      ],
      "title": "DeclaredMemoryHint",
      "type": "object"
    },
    "MemoryHintChangeKind": {
      "enum": [
        "ADD",
        "CHANGE",
        "END",
        "UNCERTAIN"
      ],
      "title": "MemoryHintChangeKind",
      "type": "string"
    },
    "StableId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "StableId",
      "type": "string"
    },
    "WriterMemoryRequest": {
      "additionalProperties": false,
      "properties": {
        "anchor_labels": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Anchor Labels",
          "type": "array"
        },
        "blocked_action": {
          "minLength": 1,
          "title": "Blocked Action",
          "type": "string"
        },
        "known_context_item_ids": {
          "default": [],
          "items": {
            "$ref": "#/$defs/StableId"
          },
          "title": "Known Context Item Ids",
          "type": "array"
        },
        "mandatory_suggestion": {
          "default": false,
          "title": "Mandatory Suggestion",
          "type": "boolean"
        },
        "purpose": {
          "minLength": 1,
          "title": "Purpose",
          "type": "string"
        },
        "question": {
          "minLength": 1,
          "title": "Question",
          "type": "string"
        },
        "request_id": {
          "$ref": "#/$defs/StableId"
        },
        "requested_evidence_type": {
          "minLength": 1,
          "title": "Requested Evidence Type",
          "type": "string"
        },
        "risk": {
          "minLength": 1,
          "title": "Risk",
          "type": "string"
        },
        "scene_or_draft_checkpoint": {
          "minLength": 1,
          "title": "Scene Or Draft Checkpoint",
          "type": "string"
        }
      },
      "required": [
        "request_id",
        "question",
        "purpose",
        "blocked_action",
        "requested_evidence_type",
        "scene_or_draft_checkpoint",
        "risk"
      ],
      "title": "WriterMemoryRequest",
      "type": "object"
    },
    "WriterTurnAction": {
      "enum": [
        "DRAFT_READY",
        "REQUEST_MEMORY"
      ],
      "title": "WriterTurnAction",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "action": {
      "$ref": "#/$defs/WriterTurnAction"
    },
    "declared_memory_hints": {
      "default": [],
      "items": {
        "$ref": "#/$defs/DeclaredMemoryHint"
      },
      "title": "Declared Memory Hints",
      "type": "array"
    },
    "draft_text": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Draft Text"
    },
    "memory_requests": {
      "default": [],
      "items": {
        "$ref": "#/$defs/WriterMemoryRequest"
      },
      "title": "Memory Requests",
      "type": "array"
    },
    "self_observations": {
      "default": [],
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Self Observations",
      "type": "array"
    },
    "unresolved_questions": {
      "default": [],
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Unresolved Questions",
      "type": "array"
    },
    "work_plan_checkpoint": {
      "minLength": 1,
      "title": "Work Plan Checkpoint",
      "type": "string"
    }
  },
  "required": [
    "action",
    "work_plan_checkpoint"
  ],
  "title": "WriterTurnOutput",
  "type": "object"
}
