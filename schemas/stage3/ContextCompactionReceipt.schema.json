{
  "$defs": {
    "ArtifactId": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "ArtifactId",
      "type": "string"
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/ArtifactId"
        },
        "byte_length": {
          "minimum": 0,
          "title": "Byte Length",
          "type": "integer"
        },
        "media_type": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "schema_version": {
          "$ref": "#/$defs/SchemaVersion"
        }
      },
      "required": [
        "artifact_id",
        "media_type",
        "byte_length",
        "schema_version"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "ContextItemKind": {
      "enum": [
        "system_policy",
        "tool_policy",
        "writing_task",
        "accepted_plan",
        "project_profile",
        "author_intent",
        "planning_inquiry",
        "goal_proposal",
        "recent_prose",
        "memory_claim",
        "evidence_handle",
        "unresolved_need",
        "work_plan",
        "draft_checkpoint",
        "editor_instruction",
        "model_batch",
        "tool_batch",
        "runtime_summary"
      ],
      "title": "ContextItemKind",
      "type": "string"
    },
    "ContextLayer": {
      "enum": [
        "protected",
        "memory",
        "working",
        "recent_settled",
        "compacted_prefix"
      ],
      "title": "ContextLayer",
      "type": "string"
    },
    "ContextViewItem": {
      "additionalProperties": false,
      "properties": {
        "atomic_group_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/StableId"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "content": {
          "minLength": 1,
          "title": "Content",
          "type": "string"
        },
        "information_scope": {
          "default": "writer_safe",
          "enum": [
            "writer_safe",
            "planner_safe",
            "runtime"
          ],
          "title": "Information Scope",
          "type": "string"
        },
        "instruction_boundary": {
          "default": false,
          "title": "Instruction Boundary",
          "type": "boolean"
        },
        "item_id": {
          "$ref": "#/$defs/StableId"
        },
        "kind": {
          "$ref": "#/$defs/ContextItemKind"
        },
        "layer": {
          "$ref": "#/$defs/ContextLayer"
        },
        "mandatory": {
          "default": false,
          "title": "Mandatory",
          "type": "boolean"
        },
        "pending_effect": {
          "default": false,
          "title": "Pending Effect",
          "type": "boolean"
        },
        "source_artifact_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          },
          "title": "Source Artifact Refs",
          "type": "array"
        },
        "source_event_range": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "integer"
                },
                {
                  "type": "integer"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Event Range"
        },
        "supersedes_item_ids": {
          "default": [],
          "items": {
            "$ref": "#/$defs/StableId"
          },
          "title": "Supersedes Item Ids",
          "type": "array"
        },
        "token_count": {
          "minimum": 1,
          "title": "Token Count",
          "type": "integer"
        }
      },
      "required": [
        "item_id",
        "layer",
        "kind",
        "content",
        "token_count"
      ],
      "title": "ContextViewItem",
      "type": "object"
    },
    "RunId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "RunId",
      "type": "string"
    },
    "SchemaVersion": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "title": "SchemaVersion",
      "type": "string"
    },
    "StableId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "StableId",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "basis_event_position": {
      "minimum": 1,
      "title": "Basis Event Position",
      "type": "integer"
    },
    "compacted_items": {
      "items": {
        "$ref": "#/$defs/ContextViewItem"
      },
      "title": "Compacted Items",
      "type": "array"
    },
    "covered_event_range": {
      "maxItems": 2,
      "minItems": 2,
      "prefixItems": [
        {
          "type": "integer"
        },
        {
          "type": "integer"
        }
      ],
      "title": "Covered Event Range",
      "type": "array"
    },
    "detail_artifact": {
      "anyOf": [
        {
          "$ref": "#/$defs/ArtifactRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "deterministic": {
      "title": "Deterministic",
      "type": "boolean"
    },
    "input_context_hash": {
      "$ref": "#/$defs/ArtifactId"
    },
    "input_context_tokens": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Input Context Tokens"
    },
    "kept_boundary": {
      "minimum": 0,
      "title": "Kept Boundary",
      "type": "integer"
    },
    "output_context_hash": {
      "$ref": "#/$defs/ArtifactId"
    },
    "output_context_tokens": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Output Context Tokens"
    },
    "parent_generation": {
      "minimum": 0,
      "title": "Parent Generation",
      "type": "integer"
    },
    "parent_view_revision": {
      "minimum": 0,
      "title": "Parent View Revision",
      "type": "integer"
    },
    "published_generation": {
      "minimum": 1,
      "title": "Published Generation",
      "type": "integer"
    },
    "receipt_id": {
      "$ref": "#/$defs/StableId"
    },
    "reduction_ratio": {
      "anyOf": [
        {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reduction Ratio"
    },
    "removed_item_ids": {
      "items": {
        "$ref": "#/$defs/StableId"
      },
      "title": "Removed Item Ids",
      "type": "array"
    },
    "run_id": {
      "$ref": "#/$defs/RunId"
    },
    "safe_cut": {
      "title": "Safe Cut",
      "type": "boolean"
    },
    "summary_artifact": {
      "anyOf": [
        {
          "$ref": "#/$defs/ArtifactRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "receipt_id",
    "run_id",
    "parent_view_revision",
    "parent_generation",
    "basis_event_position",
    "covered_event_range",
    "kept_boundary",
    "removed_item_ids",
    "compacted_items",
    "input_context_hash",
    "output_context_hash",
    "deterministic",
    "safe_cut",
    "published_generation"
  ],
  "title": "ContextCompactionReceipt",
  "type": "object"
}
