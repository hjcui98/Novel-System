{
  "$defs": {
    "ArtifactId": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "ArtifactId",
      "type": "string"
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/ArtifactId"
        },
        "byte_length": {
          "minimum": 0,
          "title": "Byte Length",
          "type": "integer"
        },
        "media_type": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "schema_version": {
          "$ref": "#/$defs/SchemaVersion"
        }
      },
      "required": [
        "artifact_id",
        "media_type",
        "byte_length",
        "schema_version"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "SchemaVersion": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "title": "SchemaVersion",
      "type": "string"
    },
    "StableId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "StableId",
      "type": "string"
    },
    "WriterInputTaint": {
      "description": "Input labels that are forbidden at the Writer information boundary.",
      "enum": [
        "future",
        "evaluator",
        "gold"
      ],
      "title": "WriterInputTaint",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Bind a trusted source identity to its immutable artifact.",
  "properties": {
    "source_artifact": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "source_id": {
      "$ref": "#/$defs/StableId"
    },
    "taints": {
      "default": [],
      "items": {
        "$ref": "#/$defs/WriterInputTaint"
      },
      "title": "Taints",
      "type": "array"
    }
  },
  "required": [
    "source_id",
    "source_artifact"
  ],
  "title": "WriterSourceBinding",
  "type": "object"
}
