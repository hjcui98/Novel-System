{
  "$defs": {
    "AgentExecutionReceipt": {
      "additionalProperties": false,
      "properties": {
        "agent_mode": {
          "$ref": "#/$defs/AgentMode"
        },
        "agent_spec": {
          "$ref": "#/$defs/ContractRef"
        },
        "agent_type": {
          "$ref": "#/$defs/AgentType"
        },
        "base_commit": {
          "anyOf": [
            {
              "$ref": "#/$defs/CommitId"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "completed_at": {
          "format": "date-time",
          "title": "Completed At",
          "type": "string"
        },
        "configuration_fingerprint": {
          "$ref": "#/$defs/ArtifactId"
        },
        "context_telemetry": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Context Telemetry",
          "type": "object"
        },
        "escalations": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Escalations",
          "type": "array"
        },
        "input_artifacts": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          },
          "title": "Input Artifacts",
          "type": "array"
        },
        "latency_ms": {
          "minimum": 0,
          "title": "Latency Ms",
          "type": "integer"
        },
        "model_call_ids": {
          "default": [],
          "items": {
            "$ref": "#/$defs/StableId"
          },
          "title": "Model Call Ids",
          "type": "array"
        },
        "output_artifacts": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          },
          "title": "Output Artifacts",
          "type": "array"
        },
        "prompt_fingerprint": {
          "$ref": "#/$defs/ArtifactId"
        },
        "receipt_id": {
          "$ref": "#/$defs/StableId"
        },
        "run_id": {
          "$ref": "#/$defs/RunId"
        },
        "skill_receipts": {
          "default": [],
          "items": {
            "$ref": "#/$defs/SkillExecutionReceipt"
          },
          "title": "Skill Receipts",
          "type": "array"
        },
        "started_at": {
          "format": "date-time",
          "title": "Started At",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/ExecutionStatus"
        },
        "task_id": {
          "$ref": "#/$defs/TaskId"
        },
        "tool_call_ids": {
          "default": [],
          "items": {
            "$ref": "#/$defs/StableId"
          },
          "title": "Tool Call Ids",
          "type": "array"
        },
        "unresolved": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Unresolved",
          "type": "array"
        }
      },
      "required": [
        "receipt_id",
        "run_id",
        "task_id",
        "agent_spec",
        "agent_type",
        "agent_mode",
        "prompt_fingerprint",
        "configuration_fingerprint",
        "status",
        "started_at",
        "completed_at",
        "latency_ms"
      ],
      "title": "AgentExecutionReceipt",
      "type": "object"
    },
    "AgentMode": {
      "enum": [
        "project_bootstrap",
        "story",
        "arc_volume",
        "chapter",
        "scene",
        "replan",
        "bootstrap",
        "replay",
        "curator_repair",
        "bounded_r2",
        "risk_review",
        "draft",
        "continue",
        "major_rewrite",
        "review",
        "local_repair",
        "observe",
        "chapter_set"
      ],
      "title": "AgentMode",
      "type": "string"
    },
    "AgentType": {
      "enum": [
        "planner",
        "memory_curator",
        "memory_controller",
        "memory_guardian",
        "writer",
        "editor",
        "candidate_observer",
        "plan_reviewer"
      ],
      "title": "AgentType",
      "type": "string"
    },
    "ArtifactId": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "ArtifactId",
      "type": "string"
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/ArtifactId"
        },
        "byte_length": {
          "minimum": 0,
          "title": "Byte Length",
          "type": "integer"
        },
        "media_type": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "schema_version": {
          "$ref": "#/$defs/SchemaVersion"
        }
      },
      "required": [
        "artifact_id",
        "media_type",
        "byte_length",
        "schema_version"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "CommitId": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "CommitId",
      "type": "string"
    },
    "ContractRef": {
      "additionalProperties": false,
      "properties": {
        "content_hash": {
          "$ref": "#/$defs/ArtifactId"
        },
        "contract_id": {
          "$ref": "#/$defs/StableId"
        },
        "version": {
          "$ref": "#/$defs/SchemaVersion"
        }
      },
      "required": [
        "contract_id",
        "version",
        "content_hash"
      ],
      "title": "ContractRef",
      "type": "object"
    },
    "ControllerPromotionDecision": {
      "enum": [
        "accept_bounded_default",
        "freeze_deterministic_gateway",
        "reject_architecture",
        "defer"
      ],
      "title": "ControllerPromotionDecision",
      "type": "string"
    },
    "DraftArtifact": {
      "additionalProperties": false,
      "description": "Content-addressed Writer candidate; never a canonical TextRoot.",
      "properties": {
        "basis": {
          "$ref": "#/$defs/WriterArtifactBasis"
        },
        "candidate_only": {
          "const": true,
          "default": true,
          "title": "Candidate Only",
          "type": "boolean"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "draft_id": {
          "$ref": "#/$defs/ArtifactId"
        },
        "mode": {
          "$ref": "#/$defs/AgentMode"
        },
        "model_call_ids": {
          "items": {
            "$ref": "#/$defs/StableId"
          },
          "title": "Model Call Ids",
          "type": "array"
        },
        "model_call_record": {
          "anyOf": [
            {
              "$ref": "#/$defs/ModelCallRecord"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "parent_draft_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactId"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "raw_output_artifact": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "sidecar_artifact": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "text_artifact": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "writer_receipt": {
          "$ref": "#/$defs/AgentExecutionReceipt"
        }
      },
      "required": [
        "draft_id",
        "mode",
        "basis",
        "text_artifact",
        "sidecar_artifact",
        "raw_output_artifact",
        "writer_receipt",
        "model_call_ids",
        "created_at"
      ],
      "title": "DraftArtifact",
      "type": "object"
    },
    "DraftSpan": {
      "additionalProperties": false,
      "description": "A trusted, service-generated character range in a candidate Draft.",
      "properties": {
        "block_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/StableId"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "end": {
          "minimum": 0,
          "title": "End",
          "type": "integer"
        },
        "start": {
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "DraftSpan",
      "type": "object"
    },
    "EditorialRepairHistoryEntry": {
      "additionalProperties": false,
      "properties": {
        "draft_id": {
          "$ref": "#/$defs/ArtifactId"
        },
        "repaired_draft_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactId"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "report_id": {
          "$ref": "#/$defs/StableId"
        },
        "verdict": {
          "$ref": "#/$defs/EditorialVerdict"
        }
      },
      "required": [
        "report_id",
        "draft_id",
        "verdict"
      ],
      "title": "EditorialRepairHistoryEntry",
      "type": "object"
    },
    "EditorialVerdict": {
      "description": "The only routing outcomes an Editor may produce.",
      "enum": [
        "PASS",
        "LOCAL_REPAIR",
        "MAJOR_REWRITE"
      ],
      "title": "EditorialVerdict",
      "type": "string"
    },
    "ExecutionBeatBlueprint": {
      "description": "One few-hundred-character unit of writing work.\n\nA beat is the smallest unit the Writer contract carries: it says what\nhappens, what opposes it, what the character chooses, what results, and how\nthe prose should end.  A budget without those is a length request, not a\nplan.",
      "properties": {
        "action": {
          "minLength": 1,
          "title": "Action",
          "type": "string"
        },
        "beat_id": {
          "$ref": "#/$defs/StableId"
        },
        "budget_characters": {
          "minimum": 1,
          "title": "Budget Characters",
          "type": "integer"
        },
        "choice": {
          "minLength": 1,
          "title": "Choice",
          "type": "string"
        },
        "close_point": {
          "minLength": 1,
          "title": "Close Point",
          "type": "string"
        },
        "information_revealed": {
          "minLength": 1,
          "title": "Information Revealed",
          "type": "string"
        },
        "outcome": {
          "minLength": 1,
          "title": "Outcome",
          "type": "string"
        },
        "parent_beat_refs": {
          "items": {
            "$ref": "#/$defs/StableId"
          },
          "minItems": 1,
          "title": "Parent Beat Refs",
          "type": "array"
        },
        "prose_focus": {
          "minLength": 1,
          "title": "Prose Focus",
          "type": "string"
        },
        "resistance": {
          "minLength": 1,
          "title": "Resistance",
          "type": "string"
        }
      },
      "required": [
        "beat_id",
        "parent_beat_refs",
        "action",
        "resistance",
        "choice",
        "outcome",
        "information_revealed",
        "prose_focus",
        "budget_characters",
        "close_point"
      ],
      "title": "ExecutionBeatBlueprint",
      "type": "object"
    },
    "ExecutionStatus": {
      "enum": [
        "planned",
        "succeeded",
        "partial",
        "skipped",
        "failed",
        "suspended",
        "rejected"
      ],
      "title": "ExecutionStatus",
      "type": "string"
    },
    "FutureIsolationAttestation": {
      "additionalProperties": false,
      "properties": {
        "attestation_id": {
          "$ref": "#/$defs/StableId"
        },
        "canonical_source_ids": {
          "items": {
            "$ref": "#/$defs/StableId"
          },
          "title": "Canonical Source Ids",
          "type": "array"
        },
        "checkpoint_chapter": {
          "minimum": 0,
          "title": "Checkpoint Chapter",
          "type": "integer"
        },
        "configuration_fingerprint": {
          "$ref": "#/$defs/ArtifactId"
        },
        "evaluator_only_source_ids": {
          "items": {
            "$ref": "#/$defs/StableId"
          },
          "title": "Evaluator Only Source Ids",
          "type": "array"
        },
        "overlap_source_ids": {
          "default": [],
          "items": {
            "$ref": "#/$defs/StableId"
          },
          "title": "Overlap Source Ids",
          "type": "array"
        },
        "passed": {
          "title": "Passed",
          "type": "boolean"
        }
      },
      "required": [
        "attestation_id",
        "checkpoint_chapter",
        "canonical_source_ids",
        "evaluator_only_source_ids",
        "passed",
        "configuration_fingerprint"
      ],
      "title": "FutureIsolationAttestation",
      "type": "object"
    },
    "JsonValue": {},
    "ModelCallPurpose": {
      "enum": [
        "development",
        "batch_test",
        "evaluation"
      ],
      "title": "ModelCallPurpose",
      "type": "string"
    },
    "ModelCallRecord": {
      "additionalProperties": false,
      "properties": {
        "completed_at": {
          "format": "date-time",
          "title": "Completed At",
          "type": "string"
        },
        "endpoint": {
          "minLength": 1,
          "title": "Endpoint",
          "type": "string"
        },
        "latency_ms": {
          "minimum": 0,
          "title": "Latency Ms",
          "type": "integer"
        },
        "model": {
          "minLength": 1,
          "title": "Model",
          "type": "string"
        },
        "model_role": {
          "$ref": "#/$defs/ModelRole"
        },
        "model_version": {
          "minLength": 1,
          "title": "Model Version",
          "type": "string"
        },
        "purpose": {
          "$ref": "#/$defs/ModelCallPurpose"
        },
        "request_id": {
          "$ref": "#/$defs/StableId"
        },
        "run_id": {
          "$ref": "#/$defs/RunId"
        },
        "span_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Span Id"
        },
        "started_at": {
          "format": "date-time",
          "title": "Started At",
          "type": "string"
        },
        "task_id": {
          "$ref": "#/$defs/TaskId"
        },
        "trace_id": {
          "minLength": 1,
          "title": "Trace Id",
          "type": "string"
        },
        "usage": {
          "$ref": "#/$defs/ModelUsage"
        }
      },
      "required": [
        "request_id",
        "run_id",
        "task_id",
        "model_role",
        "purpose",
        "trace_id",
        "endpoint",
        "model",
        "model_version",
        "usage",
        "latency_ms",
        "started_at",
        "completed_at"
      ],
      "title": "ModelCallRecord",
      "type": "object"
    },
    "ModelCostAvailability": {
      "enum": [
        "known",
        "unknown",
        "not_applicable"
      ],
      "title": "ModelCostAvailability",
      "type": "string"
    },
    "ModelRole": {
      "enum": [
        "implementation_model",
        "batch_test_model"
      ],
      "title": "ModelRole",
      "type": "string"
    },
    "ModelUsage": {
      "additionalProperties": false,
      "properties": {
        "cost_availability": {
          "$ref": "#/$defs/ModelCostAvailability",
          "default": "unknown"
        },
        "cost_usd": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Cost Usd"
        },
        "input_tokens": {
          "minimum": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "output_tokens": {
          "minimum": 0,
          "title": "Output Tokens",
          "type": "integer"
        },
        "reasoning_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Reasoning Tokens",
          "type": "integer"
        }
      },
      "required": [
        "input_tokens",
        "output_tokens",
        "cost_usd"
      ],
      "title": "ModelUsage",
      "type": "object"
    },
    "PlanParticipant": {
      "description": "One planned or already-known participant of a chapter set.\n\nA planned participant is not a Canon entity.  It carries a plan-local\nreference so the Writer can write about something that does not exist in\nthe World yet, while the World stays free of a pre-written membership\nrelation.  A known participant references a real entity id that the\ncurrent World must be able to resolve.",
      "properties": {
        "enter_chapter": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Enter Chapter"
        },
        "entity_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/StableId"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "exit_chapter": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exit Chapter"
        },
        "introduction_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/StableId"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "label": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"
        },
        "narrative_role": {
          "minLength": 1,
          "title": "Narrative Role",
          "type": "string"
        },
        "planned_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/StableId"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "reference_kind": {
          "enum": [
            "planned",
            "canon"
          ],
          "title": "Reference Kind",
          "type": "string"
        }
      },
      "required": [
        "reference_kind",
        "narrative_role"
      ],
      "title": "PlanParticipant",
      "type": "object"
    },
    "PlannedIntroduction": {
      "description": "One thing the window establishes that does not exist yet.\n\nA planned introduction is a plan responsibility, not a world fact.  It\nrecords which chapter performs the introduction and which later chapter\ndepends on it, so a reader can check the dependency is discharged in the\nright order instead of assuming it already happened.",
      "properties": {
        "created_by_item_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/StableId"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "depends_from_chapters": {
          "default": [],
          "items": {
            "type": "integer"
          },
          "title": "Depends From Chapters",
          "type": "array"
        },
        "introduced_in_chapter": {
          "minimum": 1,
          "title": "Introduced In Chapter",
          "type": "integer"
        },
        "introduction_id": {
          "$ref": "#/$defs/StableId"
        },
        "statement": {
          "minLength": 1,
          "title": "Statement",
          "type": "string"
        }
      },
      "required": [
        "introduction_id",
        "statement",
        "introduced_in_chapter"
      ],
      "title": "PlannedIntroduction",
      "type": "object"
    },
    "ProjectId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "ProjectId",
      "type": "string"
    },
    "RepairedDraft": {
      "additionalProperties": false,
      "description": "A new candidate text produced by one bounded Editor local repair.",
      "properties": {
        "candidate_only": {
          "const": true,
          "default": true,
          "title": "Candidate Only",
          "type": "boolean"
        },
        "changed_spans": {
          "items": {
            "$ref": "#/$defs/DraftSpan"
          },
          "minItems": 1,
          "title": "Changed Spans",
          "type": "array"
        },
        "context_id": {
          "$ref": "#/$defs/StableId"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "draft_id": {
          "$ref": "#/$defs/ArtifactId"
        },
        "editor_receipt": {
          "$ref": "#/$defs/AgentExecutionReceipt"
        },
        "model_call_record": {
          "anyOf": [
            {
              "$ref": "#/$defs/ModelCallRecord"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "parent_draft_id": {
          "$ref": "#/$defs/ArtifactId"
        },
        "preserve_verified": {
          "const": true,
          "default": true,
          "title": "Preserve Verified",
          "type": "boolean"
        },
        "repair_report_id": {
          "$ref": "#/$defs/StableId"
        },
        "snapshot_id": {
          "$ref": "#/$defs/StableId"
        },
        "task_contract_id": {
          "$ref": "#/$defs/StableId"
        },
        "text_artifact": {
          "$ref": "#/$defs/ArtifactRef"
        }
      },
      "required": [
        "draft_id",
        "parent_draft_id",
        "repair_report_id",
        "task_contract_id",
        "snapshot_id",
        "context_id",
        "text_artifact",
        "changed_spans",
        "editor_receipt",
        "created_at"
      ],
      "title": "RepairedDraft",
      "type": "object"
    },
    "RunId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "RunId",
      "type": "string"
    },
    "SceneBlueprint": {
      "description": "One scene of a chapter's execution detail.",
      "properties": {
        "beats": {
          "items": {
            "$ref": "#/$defs/ExecutionBeatBlueprint"
          },
          "minItems": 1,
          "title": "Beats",
          "type": "array"
        },
        "budget_characters": {
          "minimum": 1,
          "title": "Budget Characters",
          "type": "integer"
        },
        "entry_condition": {
          "minLength": 1,
          "title": "Entry Condition",
          "type": "string"
        },
        "exit_condition": {
          "minLength": 1,
          "title": "Exit Condition",
          "type": "string"
        },
        "location": {
          "minLength": 1,
          "title": "Location",
          "type": "string"
        },
        "narrative_task": {
          "minLength": 1,
          "title": "Narrative Task",
          "type": "string"
        },
        "participants": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Participants",
          "type": "array"
        },
        "pov": {
          "minLength": 1,
          "title": "Pov",
          "type": "string"
        },
        "scene_id": {
