{
  "$defs": {
    "ContextScheme": {
      "description": "The three comparable Context inputs of a Stage 3 generation run.",
      "enum": [
        "recent_prose",
        "simple_retrieval",
        "writer_context_package"
      ],
      "title": "ContextScheme",
      "type": "string"
    },
    "EditorialVerdict": {
      "enum": [
        "pass",
        "local_repair",
        "major_rewrite"
      ],
      "title": "EditorialVerdict",
      "type": "string"
    },
    "ReconciliationVerdict": {
      "enum": [
        "matched",
        "declared_only",
        "observed_only",
        "mismatched"
      ],
      "title": "ReconciliationVerdict",
      "type": "string"
    },
    "StableId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "StableId",
      "type": "string"
    },
    "Stage3FailureCategory": {
      "description": "Typed scheme status; a failed scheme is never replaced by another result.",
      "enum": [
        "input_not_ready",
        "writer_failed",
        "editor_failed",
        "reconciliation_failed",
        "evaluation_failed",
        "completed"
      ],
      "title": "Stage3FailureCategory",
      "type": "string"
    },
    "Stage3SchemeSummary": {
      "additionalProperties": false,
      "properties": {
        "case_count": {
          "default": 0,
          "minimum": 0,
          "title": "Case Count",
          "type": "integer"
        },
        "completed": {
          "default": 0,
          "minimum": 0,
          "title": "Completed",
          "type": "integer"
        },
        "editor_verdicts": {
          "additionalProperties": {
            "type": "integer"
          },
          "propertyNames": {
            "$ref": "#/$defs/EditorialVerdict"
          },
          "title": "Editor Verdicts",
          "type": "object"
        },
        "evaluator_scored_dimensions": {
          "default": 0,
          "minimum": 0,
          "title": "Evaluator Scored Dimensions",
          "type": "integer"
        },
        "failed": {
          "default": 0,
          "minimum": 0,
          "title": "Failed",
          "type": "integer"
        },
        "failures": {
          "additionalProperties": {
            "type": "integer"
          },
          "propertyNames": {
            "$ref": "#/$defs/Stage3FailureCategory"
          },
          "title": "Failures",
          "type": "object"
        },
        "input_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "latency_ms": {
          "default": 0,
          "minimum": 0,
          "title": "Latency Ms",
          "type": "integer"
        },
        "output_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Output Tokens",
          "type": "integer"
        },
        "reconciliation": {
          "additionalProperties": {
            "type": "integer"
          },
          "propertyNames": {
            "$ref": "#/$defs/ReconciliationVerdict"
          },
          "title": "Reconciliation",
          "type": "object"
        },
        "repair_count": {
          "default": 0,
          "minimum": 0,
          "title": "Repair Count",
          "type": "integer"
        },
        "rewrite_count": {
          "default": 0,
          "minimum": 0,
          "title": "Rewrite Count",
          "type": "integer"
        },
        "rule_passed": {
          "default": 0,
          "minimum": 0,
          "title": "Rule Passed",
          "type": "integer"
        },
        "rule_total": {
          "default": 0,
          "minimum": 0,
          "title": "Rule Total",
          "type": "integer"
        },
        "scheme": {
          "$ref": "#/$defs/ContextScheme"
        }
      },
      "required": [
        "scheme"
      ],
      "title": "Stage3SchemeSummary",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "case_count": {
      "default": 0,
      "minimum": 0,
      "title": "Case Count",
      "type": "integer"
    },
    "completed": {
      "default": 0,
      "minimum": 0,
      "title": "Completed",
      "type": "integer"
    },
    "failed": {
      "default": 0,
      "minimum": 0,
      "title": "Failed",
      "type": "integer"
    },
    "failure_totals": {
      "additionalProperties": {
        "type": "integer"
      },
      "propertyNames": {
        "$ref": "#/$defs/Stage3FailureCategory"
      },
      "title": "Failure Totals",
      "type": "object"
    },
    "limitations": {
      "default": [],
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    },
    "report_id": {
      "$ref": "#/$defs/StableId"
    },
    "scheme_count": {
      "default": 0,
      "minimum": 0,
      "title": "Scheme Count",
      "type": "integer"
    },
    "schemes": {
      "items": {
        "$ref": "#/$defs/Stage3SchemeSummary"
      },
      "title": "Schemes",
      "type": "array"
    }
  },
  "required": [
    "report_id",
    "schemes"
  ],
  "title": "Stage3RunSummary",
  "type": "object"
}
