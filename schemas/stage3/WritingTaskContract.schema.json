      "title": "Forbidden Reveals",
      "type": "array"
    },
    "length_policy": {
      "$ref": "#/$defs/WritingLengthPolicy"
    },
    "mandatory_constraints": {
      "default": [],
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Mandatory Constraints",
      "type": "array"
    },
    "narrative_person": {
      "minLength": 1,
      "title": "Narrative Person",
      "type": "string"
    },
    "pov": {
      "minLength": 1,
      "title": "Pov",
      "type": "string"
