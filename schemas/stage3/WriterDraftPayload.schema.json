{
  "$defs": {
    "DeclaredMemoryHint": {
      "additionalProperties": false,
      "properties": {
        "change_kind": {
          "$ref": "#/$defs/MemoryHintChangeKind"
        },
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "evidence_quote": {
          "minLength": 1,
          "title": "Evidence Quote",
          "type": "string"
        },
        "predicate_hint": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Predicate Hint"
        },
        "subject_hint": {
          "minLength": 1,
          "title": "Subject Hint",
          "type": "string"
        },
        "value_hint": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value Hint"
        }
      },
      "required": [
        "subject_hint",
        "change_kind",
        "evidence_quote",
        "confidence"
      ],
      "title": "DeclaredMemoryHint",
      "type": "object"
    },
    "MemoryHintChangeKind": {
      "enum": [
        "ADD",
        "CHANGE",
        "END",
        "UNCERTAIN"
      ],
      "title": "MemoryHintChangeKind",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Untrusted model output; it intentionally contains no canonical identities.",
  "properties": {
    "declared_memory_hints": {
      "default": [],
      "items": {
        "$ref": "#/$defs/DeclaredMemoryHint"
      },
      "title": "Declared Memory Hints",
      "type": "array"
    },
    "draft_text": {
      "minLength": 1,
      "title": "Draft Text",
      "type": "string"
    },
    "self_observations": {
      "default": [],
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Self Observations",
      "type": "array"
    },
    "unresolved_questions": {
      "default": [],
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Unresolved Questions",
      "type": "array"
    }
  },
  "required": [
    "draft_text"
  ],
  "title": "WriterDraftPayload",
  "type": "object"
}
