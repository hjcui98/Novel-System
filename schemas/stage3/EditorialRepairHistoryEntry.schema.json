{
  "$defs": {
    "ArtifactId": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "ArtifactId",
      "type": "string"
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/ArtifactId"
        },
        "byte_length": {
          "minimum": 0,
          "title": "Byte Length",
          "type": "integer"
        },
        "media_type": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "schema_version": {
          "$ref": "#/$defs/SchemaVersion"
        }
      },
      "required": [
        "artifact_id",
        "media_type",
        "byte_length",
        "schema_version"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "EditorialVerdict": {
      "description": "The only routing outcomes an Editor may produce.",
      "enum": [
        "PASS",
        "LOCAL_REPAIR",
        "MAJOR_REWRITE"
      ],
      "title": "EditorialVerdict",
      "type": "string"
    },
    "SchemaVersion": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "title": "SchemaVersion",
      "type": "string"
    },
    "StableId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "StableId",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "draft_id": {
      "$ref": "#/$defs/ArtifactId"
    },
    "issue_summaries": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Issue Summaries",
      "type": "array"
    },
    "repaired_draft_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/ArtifactId"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "report_artifact": {
      "anyOf": [
        {
          "$ref": "#/$defs/ArtifactRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "report_id": {
      "$ref": "#/$defs/StableId"
    },
    "verdict": {
      "$ref": "#/$defs/EditorialVerdict"
    }
  },
  "required": [
    "report_id",
    "draft_id",
    "verdict"
  ],
  "title": "EditorialRepairHistoryEntry",
  "type": "object"
}
