{
  "$defs": {
    "StableId": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "StableId",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "A trusted, service-generated character range in a candidate Draft.",
  "properties": {
    "block_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/StableId"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "end": {
      "minimum": 0,
      "title": "End",
      "type": "integer"
    },
    "start": {
      "minimum": 0,
      "title": "Start",
      "type": "integer"
    }
  },
  "required": [
    "start",
    "end"
  ],
  "title": "DraftSpan",
  "type": "object"
}
